      "i18n": {
        "zh": {
          "title": "岩壑流釉堆塑瓶",
          "content": "此件牙舟陶为手工堆塑成型，瓶身饱满敦实。采用玻璃釉烧制，釉水高温向下流淌形成垂坠流釉效果，褐底搭配蓝绿窑变釉色，釉层厚薄错落。表面堆塑卷曲层叠纹饰，充满山野朴拙气息，延续牙舟陶粗犷豪放的民间审美，彰显土与火交融的自然意趣。"
        },
        "en": {
          "title": "Stacked Glaze Landscape Vase",
          "content": "Hand-built Yazhou pottery with stacked-relief decoration on a full, sturdy body. Fired with a flowing glass glaze that drips downward in kiln heat, combining brown grounds with blue-green kiln-variation. The layered surface motifs read rustic and earthy, continuing the bold folk aesthetic of Yazhou ware where clay and fire meet."
        }
      },
      "cameraFocus": {
        "distance": 4.4,
        "phi": 1.717,
        "theta": -0.167,
        "duration": 800
      }
    }
  ],
  "ui": {
    "defaultMode": "view",
    "showAutoRotateButton": true,
    "showHotspotButton": true,
    "showResetButton": true,
    "showFullscreenButton": true,
