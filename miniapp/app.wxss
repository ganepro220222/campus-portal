/* ══ 令牌区结束 ══ */

/* ── 宋体辅助类 ──
   ShuyuanSong 是内嵌子集（见 styles/font-shuyuan-song.wxss）。
   回退栈保持完整：字体万一没生效，观感退回原来的系统字，不会白屏也不会豆腐块。
   之所以内嵌而不是 wx.loadFontFace：安卓多个品牌对网络字体的 CORS 校验不一致，
   做不到「所有设备都正常显示」。 */
.serif { font-family: "ShuyuanSong", "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif; }

/* ── Flex 工具类 ── */
.flex        { display: flex; }
.flex-col    { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between{ display: flex; align-items: center; justify-content: space-between; }
.flex-1      { flex: 1; }

.text-navy   { color: var(--navy); }
.text-sub    { color: var(--sub); }
.text-hint   { color: var(--muted); }
.text-center { text-align: center; }
.text-bold   { font-weight: bold; }

.mt-8  { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.p-16  { padding: 16rpx; }
.p-24  { padding: 24rpx; }
.p-32  { padding: 32rpx; }

/* ── 卡片容器（白底 + 海军蓝阴影）── */
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  border: 1px solid var(--line);
  box-shadow: var(--shadow-sm);
}

/* ── section 标题（左侧蓝色竖线）── */
.sec-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  position: relative;
  padding-left: 20rpx;
  font-family: "ShuyuanSong", "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif;
}
.sec-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, var(--blue), var(--navy));
}

/* ── 分类胶囊 ── */
.cat-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--sub);
  background: var(--card);
  border: 1rpx solid var(--line);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.cat-tag.cat-active {
  background: linear-gradient(135deg, var(--blue), var(--navy));
  color: var(--card);
  border-color: transparent;
}

/* ── 封面图占位 ── */
.cover-image {
  width: 100%;
  border-radius: 24rpx;
  background-color: var(--sky-2);
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--muted);
}
.empty-state text { margin-top: 16rpx; font-size: 26rpx; }

/*
 * 页面加载/错误态（uibatch6 视觉对接完成）。
 *
 * 与活动详情/报名页既有的 .state-box / .detail-retry / .detail-refresh-bar 同一套配方，
 * 差别只在那两页是页面内私有 class、这里是全局的。四处「重新加载」胶囊
 * （.page-state-action / .detail-retry / .enroll-retry / .pl-retry）现在静息同为 --sky-2、
 * 按下同为 --sky，不再各写各的十六进制。
 *
 * 横向边距默认 28rpx，对齐详情页 .detail-wrap 与资源列表 .res 的栏距；
 * 栏距是 32rpx 的 5 个 Tab/列表页在各自 wxss 里覆写（搜 page-refresh-bar）。
 */
.page-state-box {
  padding: 120rpx 40rpx;
  text-align: center;
}
/* 同页的空态（.empty-state）都有 40px / var(--ghost) 的图标，错误态原本只有一行灰字，
   两个全页状态看着不像一家人。用同样的尺寸与颜色补上——警示语义由三角形和文案表达，
   红色留给正文中间那条必须抢注意力的 .page-refresh-bar。 */
.page-state-icon {
  display: block;
  margin-bottom: 20rpx;
}
.page-state-text {
  display: block;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.6;
}
.page-state-action {
  display: inline-block;
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 16rpx 40rpx;
  border-radius: 28rpx;
}
.page-state-action:active { background: var(--sky); }
.page-state-link {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--blue);
}
.page-state-link:active { opacity: 0.7; }
/* 文案是无 class 的 <text> 子节点，字号/字重/颜色靠继承落到它身上 */
.page-refresh-bar {
  margin: 16rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(192, 57, 43, 0.08);
  border: 1rpx solid rgba(192, 57, 43, 0.18);
  border-radius: 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-danger);
}
.page-refresh-bar:active { background: rgba(192, 57, 43, 0.12); }

/* ── 底部安全区 ── */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* ── 通用按钮 ── */
.btn-navy,
.btn-gold,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: normal;
}
.btn-navy {
  height: 88rpx;
  background: linear-gradient(135deg, var(--blue), var(--navy));
  color: var(--card);
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}
.btn-gold {
  height: 88rpx;
  background: linear-gradient(135deg, var(--jin-50), var(--jin-60));
  color: var(--card);
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}
.btn-ghost {
  height: 88rpx;
  background: rgba(255,255,255,.10);
  color: var(--card);
  border-radius: 44rpx;
  font-size: 30rpx;
  border: 1rpx solid rgba(255,255,255,.28);
}

/*
 * 原生 button 垂直居中：勿用 line-height = height（基础库内边距会导致文字偏下）。
 * 各页主按钮/提交按钮统一 flex；disabled 时覆盖基础库 30% 黑字。
 */
button.btn-primary,
button.btn-outline,
button.btn-disabled,
button.save-btn,
button.fb-submit,
button.pe-submit,
button.lbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

/*
 * 通栏按钮的宽度钉死。真机 iPad 上这几个按钮明显比同一列的输入框窄一大截，
 * 按钮文字是 nowrap、又被基础库自带的 overflow:hidden 切掉
 * （登录页「微信授权登录」只剩半截）。页面里写的都是 width:100%，
 * 浏览器里复现不出来，说明是基础库自己的按钮宽度规则在宽屏下生效了——
 * 那条规则的选择器我们看不到，只能用 !important 压住。
 *
 * 只列**独占一行**的按钮。activity/detail 的 .btn-primary / .btn-outline 放在
 * display:flex 的 .foot-bar 里，有单按钮和「查看凭证 + 取消报名」两种排法，
 * 钉成 100% 会把那一行挤坏，所以不在此列。
 */
button.lbtn,
button.save-btn,
button.fb-submit,
button.pe-submit {
  width: 100% !important;
  max-width: none !important;
  min-width: 0;
  box-sizing: border-box;
}
button.btn-primary[disabled],
button.save-btn[disabled],
button.fb-submit[disabled],
button.pe-submit[disabled] {
  color: var(--card);
}
button.btn-outline[disabled] {
  color: var(--navy);
}
button.lbtn-primary[disabled] {
  color: var(--navy);
}
button.lbtn-ghost[disabled] {
  color: var(--card);
}

/* ── 文件类型色标 ── */
.ft-pdf  { background: var(--color-danger); }
.ft-ppt  { background: #D27B2C; }
.ft-mp4  { background: var(--blue); }
.ft-mp3  { background: #3F9A6B; }
.ft-doc  { background: #2C66C2; }
.ft-xlsx { background: #1E7A45; }

/* ── 没有封面图时的兜底底色 hc1-hc5 ──
   条目按 index % 5 轮着取（utils/decorate.js），所以相邻几张不能同色，
   也不能同明度——一列全是深色块就成了一堵墙。

   原来这五档是旧蓝紫调色板：靛蓝、青蓝、酒红、草绿、紫。
   它们不在这套配色里的任何一条线上，而这五块在动态/展馆/课程/活动
   四张列表页上占的面积都不小 ——「整体色调不对」有一半出在这儿。

   换成这套自己的山水色：远山的青、黛瓦、石青山、木、朱。
   每一档都是**同色系里深浅两档**收出来的，不跨色相拉渐变
   （旧的 hc2 从蓝拉到青、hc4 从墨绿拉到草绿，中间那段是脏的）。

   上面压的是 rgba(255,255,255,.92) 的白图标。浅的那一端最吃紧，
   量过：5.23 / 5.19 / 8.94 / 7.58 / 6.88，都高于图形要的 3:1。 */
.hc1 { background: linear-gradient(135deg, var(--qing-90), var(--tile-dark)); }
.hc2 { background: linear-gradient(135deg, var(--qing-90), var(--shan-1)); }
.hc3 { background: linear-gradient(135deg, var(--zhu-edge), var(--zhu-d)); }
.hc4 { background: linear-gradient(135deg, var(--wood-95), var(--wood-85)); }
.hc5 { background: linear-gradient(135deg, var(--qing-90), var(--qing-80)); }

/* 轮播色阶 .s1~.s3 已删。
   轮播现在是裱起来的画心：有封面图就满强度铺图，没有就顶一幅横幅小青绿，
   两种都不需要色块垫底。这三块本来就是旧蓝紫调色板剩下的，
   而且藏在 app.wxss 里，棘轮当初整文件跳过，一直没扫到。 */

/* ══════════════ 装裱 ══════════════
   设计稿里每一个图片框（轮播、展馆封面、资讯缩略图）都是**裱起来**的：
   木纹裱边 → 画心 → 四角角叶 → 竖排题签 / 绢条。
   这几个类放在 app.wxss 是因为三处都要用，样式必须是同一套。

   小程序不保证支持 :has()，所以设计稿里那些 .mount-art:has(> img.cover)
   全部改成 WXML 上挂一个 .has-cover —— 由数据算出来，确定且可测。 */
.mount {
  padding: 7rpx;
  border-radius: 12rpx;
  background-color: var(--wood-50);
  /* 木纹：三道不同疏密的竖条纹叠出来的。设计稿里还叠了一张 --wood-fig-v
     的木射线贴图（data URI），那张在小程序上收益不大、体积不小，这里不搬。 */
  background-image:
    repeating-linear-gradient(90deg,
      rgba(58,34,14,.10) 0 2rpx, rgba(255,240,220,.05) 2rpx 4rpx, transparent 4rpx 10rpx),
    repeating-linear-gradient(90deg,
      rgba(58,34,14,.09) 0 4rpx, transparent 4rpx 18rpx,
      rgba(58,34,14,.06) 18rpx 22rpx, transparent 22rpx 46rpx),
    linear-gradient(150deg, var(--wood-30), var(--wood-40) 55%, var(--wood-60));
  box-shadow:
    inset 0 2rpx 0 rgba(255,240,220,.45),
    inset 0 -2rpx 0 rgba(58,34,14,.35),
    0 4rpx 12rpx rgba(74,50,30,.16);
}
.mount--lg { padding: 10rpx; border-radius: 20rpx; }
.mount-art {
  position: relative;
  width: 100%;
  border-radius: 6rpx;
  overflow: hidden;
  box-shadow: inset 0 0 0 2rpx rgba(58,34,14,.45),
              inset 0 4rpx 14rpx rgba(20,14,6,.40);
}
/* 角叶：四个角分别一张图，--bj 是边长。
   边长永远不超过短边的 1/3 —— 早先那版实心三角占了 33%，
   两个角一接头就把短边吃没了，125×92 的卡片直接变成八边形。 */
.mount-art::before {
  content: '';
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 2;
  pointer-events: none;
  --bj: 44rpx;
  background:
    var(--jiaoye-tl) left top / var(--bj) var(--bj) no-repeat,
    var(--jiaoye-tr) right top / var(--bj) var(--bj) no-repeat,
    var(--jiaoye-bl) left bottom / var(--bj) var(--bj) no-repeat,
    var(--jiaoye-br) right bottom / var(--bj) var(--bj) no-repeat;
}
.mount--lg .mount-art::before { --bj: 64rpx; }
.mount--sm .mount-art::before { --bj: 28rpx; }
/* 真封面图：铺满画心、垫在最底层，**满强度**。
   角叶(z2)、题签与绢条(z4/z5) 都在它上面，所以图再满也压不住这几件。 */
.mount-cover {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
/* ── 内容纸 ──
   卷首是一幅画顶到屏幕最上缘，内容纸从画脚浮起来压住山脚。
   首页和动态详情页是同一件东西，所以住在这儿。
   设计稿的 .sheet：-26px 上移、18px 圆角、一道金线 + 一层青影，
   上沿一道提手（卷轴的轴头）。 */
.sheet {
  position: relative;
  z-index: 3;
  margin-top: -52rpx;                     /* ＝设计稿 -26px，纸盖住画的下沿 */
  border-radius: 36rpx 36rpx 0 0;
  background: var(--paper);
  box-shadow: 0 -4rpx 0 rgba(200,164,92,.30),
              0 -20rpx 52rpx rgba(74,102,96,.13);
}
/* 纸的上沿留一道提手，像卷轴的轴头 */
.sheet::before {
  content: '';
  display: block;
  width: 92rpx;
  height: 6rpx;
  margin: 18rpx auto 8rpx;
  border-radius: 4rpx;
  background: var(--wood-40);
  opacity: .7;
}

/* 封面上那方白牌：半透明的纸垫着馆名，左边一枚小器物。
   定稿里它和题签是**两件**——牌在图上写简称，签在框下写全名。
   牌和签各写各的，不要叠成两行字。 */
.hc-plate {
  position: absolute;
  z-index: 4;
  left: 14rpx;
  bottom: 14rpx;
  max-width: calc(100% - 28rpx);
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx 6rpx 12rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, rgba(252,250,244,.86), rgba(252,250,244,.66));
  box-shadow: inset 0 0 0 2rpx rgba(122,110,85,.24);
}
.hc-mark { flex: none; opacity: .9; }
/* 同一方牌挪到左上角的那一档（活动卡的类型签） */
.hc-plate--tl { top: 14rpx; bottom: auto; }
.hc-plate-tx {
  font-size: 27rpx;
  letter-spacing: 3rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 没有封面图时垫在画心里的绢底 + 一枚器物图标。
   和 .mount-art 一起用，所以住在这儿而不是某一页里——
   动态、课程、展馆、活动四张列表页是同一件东西。 */
.thumb-blank {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: var(--juan-1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.7),
              inset 0 0 0 2rpx rgba(150,120,66,.10);
}

/* 有真封面图时压一层暗角。照片千差万别，没有它浅色照片上的字没法读；
   没有照片的兜底态是自家那幅浅青的画，不需要压暗。 */
.mount-art.has-cover::after {
  content: '';
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 1;
  pointer-events: none;
  box-shadow: inset 0 -92rpx 112rpx -40rpx rgba(20,16,12,.50),
              inset 0 52rpx 68rpx -36rpx rgba(20,16,12,.30);
}
/* 竖排题签：栏目名写在签上，图再满也盖不住名字。签脚一道朱。
   竖排**不走 writing-mode**：各端 WebView 对它的支持参差，
   实测一试就把四个字挤成一团。改用"签条只有一个字宽"——
   中文本来就能逐字断行，一个字宽的盒子里自然每行一个字，
   哪儿都一样，也不需要 text-orientation 把字扶正。 */
.tag-v {
  position: absolute;
  z-index: 5;
  right: 28rpx;
  top: 0;
  box-sizing: content-box;
  width: 26rpx;                /* ＝一个字宽；再宽就会两个字挤一行 */
  padding: 22rpx 12rpx 16rpx;
  font-size: 26rpx;
  line-height: 1.32;
  text-align: center;
  color: var(--wood-90);
  background: linear-gradient(180deg, var(--paper-1), var(--paper-3));
  border-radius: 0 0 6rpx 6rpx;
  border-bottom: 6rpx solid var(--zhu);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,.34), inset 0 0 0 2rpx rgba(122,110,85,.35);
}
/* 绢条：标题压在一条半透明的绢上，左沿一道朱。
   绢本来就是浅的，所以兜底态用浅绢；压在照片上时才转深，否则字读不出来。 */
.silk {
  position: absolute;
  z-index: 4;
  left: 0;
  bottom: 32rpx;
  max-width: 78%;
  padding: 24rpx 68rpx 26rpx 30rpx;
  border-left: 5rpx solid var(--zhu);
  background: linear-gradient(94deg,
    rgba(252,250,244,.90) 0%, rgba(252,250,244,.78) 58%,
    rgba(252,250,244,.34) 86%, rgba(252,250,244,0) 100%);
}
.has-cover .silk {
  background: linear-gradient(94deg,
    rgba(26,23,20,.78) 0%, rgba(26,23,20,.64) 58%,
    rgba(26,23,20,.28) 86%, rgba(26,23,20,0) 100%);
}

/* 关联小程序「App 入口横条」——首页与二级页共用，1→N 统一样式 */
.app-list { display: flex; flex-direction: column; gap: 20rpx; }
.app-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.08);
}
.app-row-hover { transform: translateY(-2rpx); box-shadow: 0 12rpx 28rpx rgba(74,50,30, 0.14); }
/* 真·圆角 App 图标：aspectFit 铺满方形（满版方图完美填充；透明/长图则以色阶托底居中） */
.app-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(74,50,30, 0.2);
}
.app-icon--circle { border-radius: 50%; }
/* 有图时用白底托住，避免透明 PNG 叠在 hc1 深蓝上只剩月牙 */
.app-icon--plate {
  background: var(--card);
  box-shadow: 0 6rpx 16rpx rgba(74,50,30, 0.12);
}
.app-icon-img { width: 100%; height: 100%; }
.app-icon-seal { color: var(--card); font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; }
.app-body { flex: 1; min-width: 0; }
.app-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 「协同小程序 · 点击打开」那一条。原来是 #EEF2FB 的冷蓝白全圆角胶囊——
   旧调色板漏下来的，而它就挂在首页「关联应用」那一行，天天看得见。
   收成和 .pill 同一方小签：直角、纸底、细框、一道受光白线。 */
.app-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
}
.app-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.app-open {
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--navy);
  flex-shrink: 0;
}

/* ── 小签（原来叫「胶囊标签」）──
   对照 design/demo/v2/shuyuan.css 的 .pill。
   原来是 20rpx 全圆角 + --sky-2 底 + --navy 字：那是旧稿的 Material 胶囊，
   换了调色板之后底色变成一块淡绿、字是金棕，谁也不挨着谁。

   定稿里它不是胶囊，是**一方小签**：直角（2px 圆角）、纸底、一圈细框、
   底下一道受光的白线。和题签、界标是同一门语言。
   字色 --wood-80（＝设计稿的 --wood-dark），在这层纸上量到 5.80~6.79，
   20rpx 的小字按正文算，要 4.5:1，够。 */
.pill {
  font-size: 21rpx;                 /* 设计稿 10.5px */
  padding: 4rpx 14rpx;              /* 设计稿 2px 7px */
  border-radius: 4rpx;              /* 设计稿 2px —— 直角，不是胶囊 */
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  flex-shrink: 0;
}
/* 两个变体：朱签用在"要紧"的那一条（设计稿的 .pill.zhu）；
   金签留给既有的「字幕」这类附加说明。两个都只换字色和框色，
   底纸不换——底纸一换就又变回色块了。 */
.pill.zhu  { color: var(--zhu);    border-color: rgba(158,43,37,.32); }
.pill.gold { color: var(--jin-70); border-color: rgba(158,125,69,.34); }

/* 详情页收藏按钮（展馆/文创/课程/资源共用） */
/* 三处调用都在 .detail-wrap（padding: 24rpx 28rpx）里，这里再给 28rpx 横向外边距
   会把胶囊比同页其他内容多缩进一个 28rpx，右边缘对不齐联系卡片与海报按钮。
   横向留给容器，这里只管上下节奏。 */
.fav-bar { display: flex; justify-content: flex-end; margin: 24rpx 0 8rpx; }
/* 文案在「收藏」(2 字) 与「已收藏」(3 字) 之间切换 = 25rpx 宽度差，
   而胶囊是右对齐的，不锁宽就会每点一次左边缘蹦一下。按长的那个态定死下限：
   图标 32rpx + gap 8rpx + 3×25rpx 文字 + 28rpx×2 内边距 = 171rpx。 */
.fav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: 25rpx;
  color: var(--sub);
  box-sizing: border-box;
  min-width: 172rpx;
}
.fav-btn.fav-on {
  color: var(--color-danger);
  border-color: #F3C9C2;
  background: #FDF1EF;
}
.fav-bar-inline { margin: 20rpx 0 0; justify-content: flex-start; }
/* 资源列表里它与 .res-dl 并排。两颗都是正圆，尺寸/底色必须一致，
   否则同一行里一大一小、一个带描边一个不带，看着像没对齐。跟 .res-dl 取齐：
   72rpx + var(--sky-2) + 无描边，选中态再用红系区分。 */
.fav-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--sky-2);
  flex-shrink: 0;
}
.fav-icon:active { background: var(--sky); }
.fav-icon.fav-on { background: #FDF1EF; }
.fav-icon.fav-on:active { background: #F8E3DF; }
