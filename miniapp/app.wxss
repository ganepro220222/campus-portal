/* app.wxss — 全局样式 */
page {
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #1F2547;
  background-color: #F5F8FC;
  box-sizing: border-box;
}

/* 品牌色与设计变量 */
page {
  --navy:        #2B356E;
  --navy-deep:   #1E2654;
  --navy-ink:    #141A38;
  --blue:        #3F57B5;
  --blue-soft:   #5C72C9;
  --sky:         #D0E7F7;
  --sky-2:       #E8F2FB;
  --sky-3:       #F2F7FC;
  --paper:       #F5F8FC;
  --card:        #FFFFFF;
  --gold:        #BE9C44;
  --gold-soft:   #E7D9AE;
  --gold-line:   #D8C79A;
  --ink:         #1F2547;
  --sub:         #5A648A;
  /* 由 #8A93B2 调深到 #67708C。旧值在白底上的对比度只有 3.04:1、在 --paper 上 2.86:1，
     都低于 WCAG AA 对正文的 4.5:1；而它承担的是全站的提示文字、tabBar 未选中标签、
     空态说明这些"看不清就真的看不见"的角色。新值白底 4.91、paper 底 4.61，两处都过线。
     与 --sub(#5A648A, 5.79) 的层级仍在，只是拉近了一点——sub 用在更大的字号与更重的字重上。 */
  --muted:       #67708C;
  --line:        #E7ECF6;
  --shadow:      0 10px 30px rgba(31,40,90,.10);
  --shadow-sm:   0 4px 14px rgba(31,40,90,.08);

  /* 兼容旧变量名 */
  --color-primary:   #2B356E;
  --color-primary-light: #3F57B5;
  --color-text:      #1F2547;
  --color-text-sub:  #5A648A;
  --color-text-hint: #67708C;
  --color-border:    #E7ECF6;
  --color-bg:        #F5F8FC;
  --color-bg-white:  #FFFFFF;
  --color-success:   #52C41A;
  --color-warning:   #FAAD14;
  --color-danger:    #FF4D4F;
}

/* ── 宋体辅助类 ── */
.serif { font-family: "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif; }

/* ── Flex 工具类 ── */
.flex        { display: flex; }
.flex-col    { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between{ display: flex; align-items: center; justify-content: space-between; }
.flex-1      { flex: 1; }

.text-navy   { color: var(--navy); }
.text-sub    { color: var(--sub); }
.text-hint   { color: var(--muted); }
.text-center { text-align: center; }
.text-bold   { font-weight: bold; }

.mt-8  { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.p-16  { padding: 16rpx; }
.p-24  { padding: 24rpx; }
.p-32  { padding: 32rpx; }

/* ── 卡片容器（白底 + 海军蓝阴影）── */
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  border: 1px solid var(--line);
  box-shadow: var(--shadow-sm);
}

/* ── section 标题（左侧蓝色竖线）── */
.sec-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  position: relative;
  padding-left: 20rpx;
  font-family: "Noto Serif SC", serif;
}
.sec-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #3F57B5, #2B356E);
}

/* ── 分类胶囊 ── */
.cat-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--sub);
  background: var(--card);
  border: 1rpx solid var(--line);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.cat-tag.cat-active {
  background: linear-gradient(135deg, #3F57B5, #2B356E);
  color: #fff;
  border-color: transparent;
}

/* ── 封面图占位 ── */
.cover-image {
  width: 100%;
  border-radius: 24rpx;
  background-color: var(--sky-2);
}

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--muted);
}
.empty-state text { margin-top: 16rpx; font-size: 26rpx; }

/*
 * 页面加载/错误态（uibatch6 视觉对接完成）。
 *
 * 与活动详情/报名页既有的 .state-box / .detail-retry / .detail-refresh-bar 同一套配方，
 * 差别只在那两页是页面内私有 class、这里是全局的。四处「重新加载」胶囊
 * （.page-state-action / .detail-retry / .enroll-retry / .pl-retry）现在静息同为 --sky-2、
 * 按下同为 --sky，不再各写各的十六进制。
 *
 * 横向边距默认 28rpx，对齐详情页 .detail-wrap 与资源列表 .res 的栏距；
 * 栏距是 32rpx 的 5 个 Tab/列表页在各自 wxss 里覆写（搜 page-refresh-bar）。
 */
.page-state-box {
  padding: 120rpx 40rpx;
  text-align: center;
}
/* 同页的空态（.empty-state）都有 40px / #C3CCE0 的图标，错误态原本只有一行灰字，
   两个全页状态看着不像一家人。用同样的尺寸与颜色补上——警示语义由三角形和文案表达，
   红色留给正文中间那条必须抢注意力的 .page-refresh-bar。 */
.page-state-icon {
  display: block;
  margin-bottom: 20rpx;
}
.page-state-text {
  display: block;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.6;
}
.page-state-action {
  display: inline-block;
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 16rpx 40rpx;
  border-radius: 28rpx;
}
.page-state-action:active { background: var(--sky); }
.page-state-link {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--blue);
}
.page-state-link:active { opacity: 0.7; }
/* 文案是无 class 的 <text> 子节点，字号/字重/颜色靠继承落到它身上 */
.page-refresh-bar {
  margin: 16rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(192, 57, 43, 0.08);
  border: 1rpx solid rgba(192, 57, 43, 0.18);
  border-radius: 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #C0392B;
}
.page-refresh-bar:active { background: rgba(192, 57, 43, 0.12); }

/* ── 底部安全区 ── */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* ── 通用按钮 ── */
.btn-navy,
.btn-gold,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: normal;
}
.btn-navy {
  height: 88rpx;
  background: linear-gradient(135deg, #3F57B5, #2B356E);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}
.btn-gold {
  height: 88rpx;
  background: linear-gradient(135deg, #CDA94E, #B58A2F);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}
.btn-ghost {
  height: 88rpx;
  background: rgba(255,255,255,.10);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: 1rpx solid rgba(255,255,255,.28);
}

/*
 * 原生 button 垂直居中：勿用 line-height = height（基础库内边距会导致文字偏下）。
 * 各页主按钮/提交按钮统一 flex；disabled 时覆盖基础库 30% 黑字。
 */
button.btn-primary,
button.btn-outline,
button.btn-disabled,
button.save-btn,
button.fb-submit,
button.pe-submit,
button.lbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

/*
 * 通栏按钮的宽度钉死。真机 iPad 上这几个按钮明显比同一列的输入框窄一大截，
 * 按钮文字是 nowrap、又被基础库自带的 overflow:hidden 切掉
 * （登录页「微信授权登录」只剩半截）。页面里写的都是 width:100%，
 * 浏览器里复现不出来，说明是基础库自己的按钮宽度规则在宽屏下生效了——
 * 那条规则的选择器我们看不到，只能用 !important 压住。
 *
 * 只列**独占一行**的按钮。activity/detail 的 .btn-primary / .btn-outline 放在
 * display:flex 的 .foot-bar 里，有单按钮和「查看凭证 + 取消报名」两种排法，
 * 钉成 100% 会把那一行挤坏，所以不在此列。
 */
button.lbtn,
button.save-btn,
button.fb-submit,
button.pe-submit {
  width: 100% !important;
  max-width: none !important;
  min-width: 0;
  box-sizing: border-box;
}
button.btn-primary[disabled],
button.save-btn[disabled],
button.fb-submit[disabled],
button.pe-submit[disabled] {
  color: #fff;
}
button.btn-outline[disabled] {
  color: #2B356E;
}
button.lbtn-primary[disabled] {
  color: #2B356E;
}
button.lbtn-ghost[disabled] {
  color: #fff;
}

/* ── 文件类型色标 ── */
.ft-pdf  { background: #C0392B; }
.ft-ppt  { background: #D27B2C; }
.ft-mp4  { background: #3F57B5; }
.ft-mp3  { background: #3F9A6B; }
.ft-doc  { background: #2C66C2; }
.ft-xlsx { background: #1E7A45; }

/* 展馆/封面渐变色阶 hc1-hc5 */
.hc1 { background: linear-gradient(135deg, #2B356E, #475BA6); }
.hc2 { background: linear-gradient(135deg, #365E8C, #2E7C8C); }
.hc3 { background: linear-gradient(135deg, #7A2E36, #A0505A); }
.hc4 { background: linear-gradient(135deg, #3F6B4A, #5C9A6B); }
.hc5 { background: linear-gradient(135deg, #5A4E86, #7E72B0); }

/* Banner 渐变色阶 s1-s3 */
.s1 { background: linear-gradient(120deg, #1E2654, #3F57B5); }
.s2 { background: linear-gradient(120deg, #243056, #4A4E86); }
.s3 { background: linear-gradient(120deg, #1B2A4A, #2E5C7A); }

/* 关联小程序「App 入口横条」——首页与二级页共用，1→N 统一样式 */
.app-list { display: flex; flex-direction: column; gap: 20rpx; }
.app-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(31, 40, 90, 0.08);
}
.app-row-hover { transform: translateY(-2rpx); box-shadow: 0 12rpx 28rpx rgba(31, 40, 90, 0.14); }
/* 真·圆角 App 图标：aspectFit 铺满方形（满版方图完美填充；透明/长图则以色阶托底居中） */
.app-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(31, 40, 90, 0.2);
}
.app-icon-img { width: 100%; height: 100%; }
.app-icon-seal { color: #fff; font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; }
.app-body { flex: 1; min-width: 0; }
.app-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.app-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #2B356E;
  background: #EEF2FB;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.app-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.app-open {
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #2B356E;
  flex-shrink: 0;
}

/* 胶囊标签 */
.pill {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: var(--sky-2);
  color: var(--navy);
  font-weight: 600;
  flex-shrink: 0;
}
.pill.gold { background: #FBF3DD; color: #9C7C2E; }

/* 详情页收藏按钮（展馆/文创/课程/资源共用） */
/* 三处调用都在 .detail-wrap（padding: 24rpx 28rpx）里，这里再给 28rpx 横向外边距
   会把胶囊比同页其他内容多缩进一个 28rpx，右边缘对不齐联系卡片与海报按钮。
   横向留给容器，这里只管上下节奏。 */
.fav-bar { display: flex; justify-content: flex-end; margin: 24rpx 0 8rpx; }
/* 文案在「收藏」(2 字) 与「已收藏」(3 字) 之间切换 = 25rpx 宽度差，
   而胶囊是右对齐的，不锁宽就会每点一次左边缘蹦一下。按长的那个态定死下限：
   图标 32rpx + gap 8rpx + 3×25rpx 文字 + 28rpx×2 内边距 = 171rpx。 */
.fav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  font-size: 25rpx;
  color: var(--sub);
  box-sizing: border-box;
  min-width: 172rpx;
}
.fav-btn.fav-on {
  color: #C0392B;
  border-color: #F3C9C2;
  background: #FDF1EF;
}
.fav-bar-inline { margin: 20rpx 0 0; justify-content: flex-start; }
/* 资源列表里它与 .res-dl 并排。两颗都是正圆，尺寸/底色必须一致，
   否则同一行里一大一小、一个带描边一个不带，看着像没对齐。跟 .res-dl 取齐：
   72rpx + var(--sky-2) + 无描边，选中态再用红系区分。 */
.fav-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--sky-2);
  flex-shrink: 0;
}
.fav-icon:active { background: var(--sky); }
.fav-icon.fav-on { background: #FDF1EF; }
.fav-icon.fav-on:active { background: #F8E3DF; }
