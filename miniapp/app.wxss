/* app.wxss — 全局样式 */
/* 宋体子集。走内嵌而不是 wx.loadFontFace：后者只收网络地址，
   还要域名白名单 + Access-Control-Allow-Origin，安卓多个品牌的校验又不一致，
   做不到「所有设备都正常显示」。内嵌是唯一各端都稳的办法。
   产物由 scripts/build-font-subset.js 生成，check:font-subset 守着它和源字体一致。 */
@import "styles/font-shuyuan-song.wxss";

page {
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--ink);
  background-color: var(--paper);
  box-sizing: border-box;
}

/* ══════════════ 原生控件让位的四条原则 ══════════════
   navigationStyle:custom 之后，页面顶上永远有两个画不了、也挪不动的东西：
   状态栏和右上角的胶囊（375pt 机型上胶囊在 x 281–368、y 48–80）。
   每一页都要和它们协调，顺序是**从上往下**，上面的压倒下面的：

     ① 优先保证页面布局。不要为了躲胶囊把整页的版式改了。
     ② 不能压在按钮上 —— 压住就按不到，这是功能损失，不是观感问题。
     ③ 尽量别压在文字上 —— 压住就读不到。
     ④ 压在装饰元素（屋檐、山水、底纹）上**可以接受**。

   所以胶囊落在屋檐的瓦面上是允许的；自绘的返回键不要和胶囊挤在同一行——
   挤在一起要么互相压，要么逼着整页给它让位，两条都违背①。
   返回键挂在檐下。这四条对所有页面有效。
   ══════════════════════════════════════════════════ */

/* ══ 令牌区开始 · 书院 · 檐棂印 ══ */
/* 「书院 · 檐棂印」全套令牌。取值与设计稿 design/demo/v2/shuyuan.css 一致，
   那边是唯一的出处，这里是搬运。

   旧名（--navy / --blue / --sky-* / --color-*）全部保留，但指向新值：
   页面里已经在用 var(--navy) 的地方一行不用改就跟着换色调，
   这是这一批"版面不动、只换色调"的关键。旧名的语义也标在后面，
   后续逐页收拾时再换成新名。 */
page {
  /* ── 纸 ── */
  --paper:       #F7F3E8;   /* 页底 */
  --paper-card:  #FFFBF2;   /* 卡片 */
  --paper-sunk:  #EEE6D4;   /* 凹进去的底（输入框、代码块） */
  --paper-1:     #F6F2E6;
  --paper-2:     #EEE9DA;
  --paper-3:     #E2DCC8;

  /* ── 杏 · 功能卡的暖沙底 ── */
  --xing-05:     #FCF3E4;
  --xing-10:     #F8E6C9;
  --xing-20:     #F2D9B4;
  --xing-30:     #E6C99C;

  /* ── 山 · 石青石绿 ── */
  --shan-4:      #A9CBBD;
  --shan-3:      #6FAE92;
  --shan-2:      #3E8FA2;
  --shan-1:      #2B6B92;
  /* 山脚：每道山的下沿要褪成土黄，不然四道山叠起来是四条硬边。
     只有卷首那幅画用得到，当初搬令牌时页面上没人用，就漏下了。 */
  --shan-foot:   #C09256;
  --shan-foot-l: #D8BA88;

  /* ── 青 · 画里的深色（题名、点景的墨骨） ── */
  --qing-80:     #445651;
  --qing-90:     #33423E;

  /* ── 绢 · 青白天色 ── */
  --juan-1:      #F2F5EE;
  --juan-2:      #E2EDE6;
  --juan-3:      #CFE2DC;

  /* ── 金棕 · UI 强调色 ── */
  --jin-20:      #E2CB9E;
  --jin-40:      #E2BB87;
  --jin-50:      #C69E62;
  --jin-60:      #9E7D45;
  --jin-70:      #7E6134;
  --jin-80:      #614923;

  /* ── 黛瓦 · 屋檐 ── */
  --tile:        #6E93A3;
  --tile-2:      #8AACBA;
  --tile-dark:   #456A7B;
  --tile-hi:     #ACC7D3;

  /* ── 木 · 裱边与檐木 ── */
  --wood-05:     #FEF9EF;
  --wood-20:     #F0E1C5;
  --wood-30:     #E4CEA8;
  --wood-35:     #DDC599;
  --wood-40:     #D5BA8B;
  --wood-45:     #CCAE7F;
  --wood-50:     #C2A57A;
  --wood-55:     #B79A6E;
  --wood-60:     #A68C64;
  --wood-65:     #957C58;
  --wood-70:     #856F4F;
  --wood-75:     #766246;
  --wood-80:     #68573B;   /* ＝设计稿的 --wood-dark：纸上的小字与细线 */
  --wood-85:     #5A4A2D;
  --wood-90:     #493D28;
  --wood-95:     #372F1F;
  /* 匾面阴刻填的墨。比 --ink 更纯黑一点——它是填在木头凹槽里的漆，
     不是纸上的字，不跟正文那三档走。 */
  --mo-90:       #232120;

  /* ── 朱 · 点缀 ── */
  --zhu:         #9E2B25;
  --zhu-soft:    #F2E0DA;
  /* 登录键那一枚是**立体的漆钮**：上沿提亮、下沿压深、底下再垫一道边，
     四个色缺一不可，少了就是一块平涂的红方块。 */
  --zhu-lit:     #B33A2C;
  --zhu-d:       #7C1C17;
  --zhu-edge:    #4E120E;

  /* ── 石 · 次按钮（微信授权那一枚）──
     不用灰：这套里没有中性灰，石青灰才是它的家族色。同样四档，同样的立体做法。 */
  --shi:         #C2D3D8;
  --shi-lit:     #D9E6E9;
  --shi-d:       #ADC2C8;
  --shi-edge:    #8DA5AD;

  /* ── 金线 ── */
  --gold:        #CBA86B;   /* 装饰用的浅金（细线、描边） */
  --gold-soft:   #E2CB9E;
  --gold-line:   #D9BE8E;

  /* ── 墨 · 文字 ──
     三档都用 scripts/check-contrast.js 量过：
       --ink   卡片 14.65 / 页底 13.64
       --sub   卡片  7.79 / 页底  7.26
       --muted 卡片  5.66 / 页底  5.27
     全部高于 WCAG AA 对正文的 4.5:1。--muted 承担提示文字、
     tabBar 未选中标签、空态说明这些"看不清就真的看不见"的角色，
     往浅里调之前先跑那个脚本。 */
  --ink:         #23262E;
  --sub:         #4C505C;
  --muted:       #6B6459;
  /* 设计稿里另有 --ink-2 / --ink-3 两个名字：ink-2 和 --sub 同值，
     ink-3 比 --muted 暖一点，专给"纸上的小字"（题签、页脚、输入框占位）。
     搬过来是为了登录页那几处能照抄设计稿的值，不用换算。 */
  --ink-2:       #4C505C;
  --ink-3:       #5D584B;
  --ghost:       #D6CDB8;   /* 空态大图标、占位符这类纯装饰的浅色 */
  --line:        #E4DCC8;
  --line-soft:   #EFE8D8;

  /* 投影改暖：原来是 rgba(31,40,90,…) 的冷灰蓝，压在纸色上会发灰 */
  --shadow:      0 10px 30px rgba(74,50,30,.12);
  --shadow-sm:   0 4px 14px rgba(74,50,30,.10);

  /* ── 旧名兼容层 ──
     语义写在后面，后续逐页替换时照着这张表改。 */
  --navy:        #7E6134;   /* 旧：主色。现在是金棕深，用于强调文字、选中态、深色按钮底 */
  --navy-deep:   #614923;   /* 旧：主色更深一档 */
  --navy-ink:    #3F2F17;   /* 旧：主色最深 */
  --blue:        #9E7D45;   /* 旧：次强调 */
  --blue-soft:   #C69E62;   /* 旧：次强调浅 */
  --sky:         #CFE2DC;   /* 旧：浅色块 → 绢青 */
  --sky-2:       #E2EDE6;
  --sky-3:       #F2F5EE;
  --card:        #FFFBF2;   /* 旧：卡片底 = --paper-card */

  --color-primary:       #7E6134;
  --color-primary-light: #9E7D45;
  --color-text:          #23262E;
  --color-text-sub:      #4C505C;
  --color-text-hint:     #6B6459;
  --color-border:        #E4DCC8;
  --color-bg:            #F7F3E8;
  --color-bg-white:      #FFFBF2;
  /* 功能色也换成这套里的颜色：成功走石绿、危险走朱、警告走赭。
     三个都在纸底上量过 ≥4.5:1（石绿 4.89 / 朱 7.19 / 赭 4.63）。 */
  --color-success:       #3F7A5E;
  --color-warning:       #8F6216;
  --color-danger:        #9E2B25;

  /* ══ 角叶开始 · 由 scripts/build-jiaoye-tokens.mjs 生成，勿手改 ══ */
