/* app.wxss — 全局样式 */
/* 宋体子集内嵌（styles/font-shuyuan-song.wxss）；scripts/build-font-subset.js 生成 */
@import "styles/font-shuyuan-song.wxss";

page {
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--ink);
  background-color: var(--paper);
  box-sizing: border-box;
}

/* 自定义导航：状态栏与胶囊不可画；优先保版式，勿压按钮/正文，可压装饰；返回键挂檐下 */

/* 令牌与设计稿一致；旧名 --navy/--blue/--sky-* 仍指向新值 */
page {
  /* ── 纸 ── */
  --paper:       #F7F3E8;   /* 页底 */
  --paper-card:  #FFFBF2;   /* 卡片 */
  --paper-sunk:  #EEE6D4;   /* 凹进去的底（输入框、代码块） */
  --paper-1:     #F6F2E6;
  --paper-2:     #EEE9DA;
  --paper-3:     #E2DCC8;

  /* ── 杏 · 功能卡的暖沙底 ── */
  --xing-05:     #FCF3E4;
  --xing-10:     #F8E6C9;
  --xing-20:     #F2D9B4;
  --xing-30:     #E6C99C;

  /* ── 山 · 石青石绿 ── */
  --shan-4:      #A9CBBD;
  --shan-3:      #6FAE92;
  --shan-2:      #3E8FA2;
  --shan-1:      #2B6B92;
  /* 山脚下沿土黄，避免山层硬边 */
  --shan-foot:   #C09256;
  --shan-foot-l: #D8BA88;

  /* ── 青 · 画里的深色（题名、点景的墨骨） ── */
  --qing-80:     #445651;
  --qing-90:     #33423E;

  /* ── 绢 · 青白天色 ── */
  --juan-1:      #F2F5EE;
  --juan-2:      #E2EDE6;
  --juan-3:      #CFE2DC;

  /* ── 金棕 · UI 强调色 ── */
  --jin-20:      #E2CB9E;
  --jin-40:      #E2BB87;
  --jin-50:      #C69E62;
  --jin-60:      #9E7D45;
  --jin-70:      #7E6134;
  --jin-80:      #614923;

  /* ── 黛瓦 · 屋檐 ── */
  --tile:        #6E93A3;
  --tile-2:      #8AACBA;
  --tile-dark:   #456A7B;
  --tile-hi:     #ACC7D3;

  /* ── 木 · 裱边与檐木 ── */
  --wood-05:     #FEF9EF;
  --wood-20:     #F0E1C5;
  --wood-30:     #E4CEA8;
  --wood-35:     #DDC599;
  --wood-40:     #D5BA8B;
  --wood-45:     #CCAE7F;
  --wood-50:     #C2A57A;
  --wood-55:     #B79A6E;
  --wood-60:     #A68C64;
  --wood-65:     #957C58;
  --wood-70:     #856F4F;
  --wood-75:     #766246;
  --wood-80:     #68573B;   /* ＝设计稿的 --wood-dark：纸上的小字与细线 */
  --wood-85:     #5A4A2D;
  --wood-90:     #493D28;
  --wood-95:     #372F1F;
  /* 匾面阴刻填墨，比 --ink 略纯 */
  --mo-90:       #232120;

  /* ── 朱 · 点缀 ── */
  --zhu:         #9E2B25;
  --zhu-soft:    #F2E0DA;
  /* 登录朱钮立体四档 */
  --zhu-lit:     #B33A2C;
  --zhu-d:       #7C1C17;
  --zhu-edge:    #4E120E;

  /* ── 石 · 次按钮立体四档 ── */
  --shi:         #C2D3D8;
  --shi-lit:     #D9E6E9;
  --shi-d:       #ADC2C8;
  --shi-edge:    #8DA5AD;

  /* ── 金线 ── */
  --gold:        #CBA86B;   /* 装饰浅金 */
  --gold-soft:   #E2CB9E;
  --gold-line:   #D9BE8E;

  /* ── 墨 · 文字（对比：ink 13.6+ / sub 7.2+ / muted 5.2+）── */
  --ink:         #23262E;
  --sub:         #4C505C;
  --muted:       #6B6459;
  /* --ink-2＝--sub；--ink-3 略暖，纸上小字 */
  --ink-2:       #4C505C;
  --ink-3:       #5D584B;
  --ghost:       #D6CDB8;   /* 空态大图标、占位符这类纯装饰的浅色 */
  --line:        #E4DCC8;
  --line-soft:   #EFE8D8;

  /* 投影改暖：原来是 rgba(31,40,90,…) 的冷灰蓝，压在纸色上会发灰 */
  --shadow:      0 10px 30px rgba(74,50,30,.12);
  --shadow-sm:   0 4px 14px rgba(74,50,30,.10);

  /* ── 旧名兼容层 ──
     语义写在后面，后续逐页替换时照着这张表改。 */
  --navy:        #7E6134;   /* 旧：主色。现在是金棕深，用于强调文字、选中态、深色按钮底 */
  --navy-deep:   #614923;   /* 旧：主色更深一档 */
  --navy-ink:    #3F2F17;   /* 旧：主色最深 */
  --blue:        #9E7D45;   /* 旧：次强调 */
  --blue-soft:   #C69E62;   /* 旧：次强调浅 */
  --sky:         #CFE2DC;   /* 旧：浅色块 → 绢青 */
  --sky-2:       #E2EDE6;
  --sky-3:       #F2F5EE;
  --card:        #FFFBF2;   /* 旧：卡片底 = --paper-card */

  --color-primary:       #7E6134;
  --color-primary-light: #9E7D45;
  --color-text:          #23262E;
  --color-text-sub:      #4C505C;
  --color-text-hint:     #6B6459;
  --color-border:        #E4DCC8;
  --color-bg:            #F7F3E8;
  --color-bg-white:      #FFFBF2;
  /* 功能色也换成这套里的颜色：成功走石绿、危险走朱、警告走赭。
     三个都在纸底上量过 ≥4.5:1（石绿 4.89 / 朱 7.19 / 赭 4.63）。 */
  --color-success:       #3F7A5E;
  --color-warning:       #8F6216;
  --color-danger:        #9E2B25;

  /* ══ 角叶开始 · 由 scripts/build-jiaoye-tokens.mjs 生成，勿手改 ══ */
