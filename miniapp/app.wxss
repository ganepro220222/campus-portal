/* ══ 令牌区结束 ══ */

/* 宋体辅助类；字体内嵌于 styles/font-shuyuan-song.wxss */
.serif { font-family: "ShuyuanSong", "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif; }

/* ── Flex 工具类 ── */
.flex        { display: flex; }
.flex-col    { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between{ display: flex; align-items: center; justify-content: space-between; }
.flex-1      { flex: 1; }

/* 原来这儿还有个 .text-navy，全仓没人用，名字又还是旧调色板的，留着只会误导 */
.text-sub    { color: var(--sub); }
.text-hint   { color: var(--muted); }
.text-center { text-align: center; }
.text-bold   { font-weight: bold; }

.mt-8  { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8  { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.p-16  { padding: 16rpx; }
.p-24  { padding: 24rpx; }
.p-32  { padding: 32rpx; }

/* ── 卡片容器（白底 + 海军蓝阴影）── */
.card {
  background: var(--paper-card);
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  border: 1px solid var(--line);
  box-shadow: var(--shadow-sm);
}

/* 段头：朱印 + 标题；供首页与二级页共用 */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0;
}
.sec-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 38rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.seal-sm {
  width: 44rpx;                 /* ＝设计稿 22px */
  height: 44rpx;
  flex: none;
  display: block;
}
.sec-more {
  font-size: 24rpx;
  color: var(--jin-70);
  display: flex;
  align-items: center;
  gap: 4rpx;
}
/* 版框双线 + 中缝朱红菱形（鱼尾） */
.sec-rule {
  margin: 12rpx 0 24rpx;
  position: relative;
}
.sec-rule::after {
  content: '';
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 50%;
  width: 11rpx;
  height: 11rpx;
  transform: translate(-50%, -50%) rotate(45deg);
  background: var(--zhu);
  box-shadow: 0 0 0 5rpx var(--paper);
}
.sec-rule-a,
.sec-rule-b {
  display: block;
  height: 2rpx;
  background: var(--line);
}
.sec-rule-b { margin-top: 2rpx; opacity: .5; }

/* ── 空状态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: var(--muted);
}
.empty-state text { margin-top: 16rpx; font-size: 26rpx; }

/* 页面加载 / 错误态；横向边距默认 28rpx，32rpx 栏距页各自覆写 */
.page-state-box {
  padding: 120rpx 40rpx;
  text-align: center;
}
/* 同页的空态（.empty-state）都有 40px / var(--ghost) 的图标，错误态原本只有一行灰字，
   两个全页状态看着不像一家人。用同样的尺寸与颜色补上——警示语义由三角形和文案表达，
   红色留给正文中间那条必须抢注意力的 .page-refresh-bar。 */
.page-state-icon {
  display: block;
  margin-bottom: 20rpx;
}
.page-state-text {
  display: block;
  font-size: 28rpx;
  color: var(--muted);
  line-height: 1.6;
}
/* 「重新加载」：素钮。它是错误态里的次操作，不该比正文还抢眼——
   原来是 --sky-2 的淡绿底 + 28rpx 全圆胶囊，两样都是旧稿留下的。
   现在同登录页的次按钮：纸面从亮到暗压一道，顶上一条受光白线，直角 10rpx。 */
.page-state-action {
  display: inline-block;
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--jin-70);
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  border: 1rpx solid var(--line);
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9);
  padding: 16rpx 40rpx;
  border-radius: 10rpx;
}
/* 按下变深一档：纸被按进去，受光的白线随之收掉 */
.page-state-action:active {
  background: linear-gradient(180deg, var(--paper-2), var(--paper-3));
  box-shadow: inset 0 2rpx 4rpx rgba(74,50,30,.14);
}
.page-state-link {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--jin-70);
}
.page-state-link:active { opacity: 0.7; }
/* 文案是无 class 的 <text> 子节点，字号/字重/颜色靠继承落到它身上 */
.page-refresh-bar {
  margin: 16rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(158, 43, 37, 0.08);
  border: 1rpx solid rgba(158, 43, 37, 0.18);
  border-radius: 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--zhu);
}
.page-refresh-bar:active { background: rgba(158, 43, 37, 0.12); }

/* ── 底部安全区 ── */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* 这里原先是 .btn-navy / .btn-gold / .btn-ghost 三个通用按钮，
   44rpx 全圆胶囊 + blue→navy 渐变。全仓 wxml / js / 其它 wxss 一处没引用
   （登录页用的是自己的 .lbtn-ghost，不是这个），一并删掉。
   各页的主/次按钮现在统一走朱砂漆钮与素钮两种，见登录页与活动详情。 */

/*
 * 原生 button 垂直居中：勿用 line-height = height（基础库内边距会导致文字偏下）。
 * 各页主按钮/提交按钮统一 flex；disabled 时覆盖基础库 30% 黑字。
 */
button.btn-primary,
button.btn-outline,
button.btn-disabled,
button.save-btn,
button.fb-submit,
button.pe-submit,
button.lbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
}

/* 通栏按钮钉 width:100%（宽屏基础库会缩窄）；.foot-bar 内按钮除外 */
button.lbtn,
button.save-btn,
button.fb-submit,
button.pe-submit {
  width: 100% !important;
  max-width: none !important;
  min-width: 0;
  box-sizing: border-box;
}
button.btn-primary[disabled],
button.save-btn[disabled],
button.fb-submit[disabled],
button.pe-submit[disabled] {
  color: var(--paper-card);
}
button.btn-outline[disabled] {
  color: var(--jin-70);
}
button.lbtn-primary[disabled] {
  color: var(--jin-70);
}
button.lbtn-ghost[disabled] {
  color: var(--paper-card);
}

/* ── 文件类型色标 ── */
.ft-pdf  { background: var(--color-danger); }
.ft-ppt  { background: #D27B2C; }
.ft-mp4  { background: var(--blue); }
.ft-mp3  { background: #3F9A6B; }
.ft-doc  { background: #2C66C2; }
.ft-xlsx { background: #1E7A45; }

/* 无封面兜底色 hc1–hc5（index%5）；山水色同系深浅，白图标对比 ≥5.19 */
.hc1 { background: linear-gradient(135deg, var(--qing-90), var(--tile-dark)); }
.hc2 { background: linear-gradient(135deg, var(--qing-90), var(--shan-1)); }
.hc3 { background: linear-gradient(135deg, var(--zhu-edge), var(--zhu-d)); }
.hc4 { background: linear-gradient(135deg, var(--wood-95), var(--wood-85)); }
.hc5 { background: linear-gradient(135deg, var(--qing-90), var(--qing-80)); }

/* 轮播旧色阶 .s1~.s3 已删 */

/* 装裱：木边 → 画心 → 角叶 → 题签/绢；有封面时 WXML 挂 .has-cover */
.mount {
  padding: 7rpx;
  border-radius: 12rpx;
  background-color: var(--wood-50);
  /* 木纹竖条；--wood-fig-v 贴图未搬 */
  background-image:
    repeating-linear-gradient(90deg,
      rgba(58,34,14,.10) 0 2rpx, rgba(255,240,220,.05) 2rpx 4rpx, transparent 4rpx 10rpx),
    repeating-linear-gradient(90deg,
      rgba(58,34,14,.09) 0 4rpx, transparent 4rpx 18rpx,
      rgba(58,34,14,.06) 18rpx 22rpx, transparent 22rpx 46rpx),
    linear-gradient(150deg, var(--wood-30), var(--wood-40) 55%, var(--wood-60));
  box-shadow:
    inset 0 2rpx 0 rgba(255,240,220,.45),
    inset 0 -2rpx 0 rgba(58,34,14,.35),
    0 4rpx 12rpx rgba(74,50,30,.16);
}
.mount--lg { padding: 10rpx; border-radius: 20rpx; }
.mount-art {
  position: relative;
  width: 100%;
  border-radius: 6rpx;
  overflow: hidden;
  box-shadow: inset 0 0 0 2rpx rgba(58,34,14,.45),
              inset 0 4rpx 14rpx rgba(20,14,6,.40);
}
/* 角叶；--bj 不超过短边约 1/3 */
.mount-art::before {
  content: '';
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 2;
  pointer-events: none;
  --bj: 44rpx;
  background:
    var(--jiaoye-tl) left top / var(--bj) var(--bj) no-repeat,
    var(--jiaoye-tr) right top / var(--bj) var(--bj) no-repeat,
    var(--jiaoye-bl) left bottom / var(--bj) var(--bj) no-repeat,
    var(--jiaoye-br) right bottom / var(--bj) var(--bj) no-repeat;
}
.mount--lg .mount-art::before { --bj: 64rpx; }
.mount--sm .mount-art::before { --bj: 28rpx; }
/* 封面满铺画心底层 */
.mount-cover {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
/* 回纹带（页面用）；tabBar 组件另有一份，画法须一致 */
.fret {
  height: 40rpx;
  background-color: rgba(173, 130, 72, .07);
  background-image: var(--fret-cut), var(--fret-lit);
  background-position: 0 0, 0 2.2rpx;
  background-size: 96rpx 40rpx;
  background-repeat: repeat-x;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 252, 244, .55),
    inset 0 -2rpx 0 rgba(107, 67, 38, .10);
}
/* 二级页那一档：上下各留一段，当分隔用（设计稿写的是 margin: 22px 0 0） */
.fret--div { margin: 44rpx 0 0; }

/* ── 内容纸 ──
   卷首是一幅画顶到屏幕最上缘，内容纸从画脚浮起来压住山脚。
   首页和动态详情页是同一件东西，所以住在这儿。
   设计稿的 .sheet：-26px 上移、18px 圆角、一道金线 + 一层青影，
   上沿一道提手（卷轴的轴头）。 */
.sheet {
  position: relative;
  z-index: 3;
  margin-top: -52rpx;                     /* ＝设计稿 -26px，纸盖住画的下沿 */
  border-radius: 36rpx 36rpx 0 0;
  background: var(--paper);
  box-shadow: 0 -4rpx 0 rgba(200,164,92,.30),
              0 -20rpx 52rpx rgba(74,102,96,.13);
}
/* 纸的上沿留一道提手，像卷轴的轴头 */
.sheet::before {
  content: '';
  display: block;
  width: 92rpx;
  height: 6rpx;
  margin: 18rpx auto 8rpx;
  border-radius: 4rpx;
  background: var(--wood-40);
  opacity: .7;
}

/* 封面上那方白牌：半透明的纸垫着馆名，左边一枚小器物。
   定稿里它和题签是**两件**——牌在图上写简称，签在框下写全名。
   牌和签各写各的，不要叠成两行字。 */
.hc-plate {
  position: absolute;
  z-index: 4;
  left: 14rpx;
  bottom: 14rpx;
  max-width: calc(100% - 28rpx);
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx 6rpx 12rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, rgba(252,250,244,.86), rgba(252,250,244,.66));
  box-shadow: inset 0 0 0 2rpx rgba(122,110,85,.24);
}
.hc-mark { flex: none; opacity: .9; }
/* 同一方牌挪到左上角的那一档（活动卡的类型签） */
.hc-plate--tl { top: 14rpx; bottom: auto; }
.hc-plate-tx {
  font-size: 27rpx;
  letter-spacing: 3rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 没有封面图时垫在画心里的绢底 + 一枚器物图标。
   和 .mount-art 一起用，所以住在这儿而不是某一页里——
   动态、课程、展馆、活动四张列表页是同一件东西。 */
.thumb-blank {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: var(--juan-1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.7),
              inset 0 0 0 2rpx rgba(150,120,66,.10);
}

/* 有真封面图时压一层暗角。照片千差万别，没有它浅色照片上的字没法读；
   没有照片的兜底态是自家那幅浅青的画，不需要压暗。 */
.mount-art.has-cover::after {
  content: '';
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 1;
  pointer-events: none;
  box-shadow: inset 0 -92rpx 112rpx -40rpx rgba(20,16,12,.50),
              inset 0 52rpx 68rpx -36rpx rgba(20,16,12,.30);
}
/* 竖排题签：单字宽自然断行，不用 writing-mode */
.tag-v {
  position: absolute;
  z-index: 5;
  right: 28rpx;
  top: 0;
  box-sizing: content-box;
  width: 26rpx;                /* ＝一个字宽；再宽就会两个字挤一行 */
  padding: 22rpx 12rpx 16rpx;
  font-size: 26rpx;
  line-height: 1.32;
  text-align: center;
  color: var(--wood-90);
  background: linear-gradient(180deg, var(--paper-1), var(--paper-3));
  border-radius: 0 0 6rpx 6rpx;
  border-bottom: 6rpx solid var(--zhu);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,.34), inset 0 0 0 2rpx rgba(122,110,85,.35);
}
/* 绢条：标题压在一条半透明的绢上，左沿一道朱。
   绢本来就是浅的，所以兜底态用浅绢；压在照片上时才转深，否则字读不出来。 */
.silk {
  position: absolute;
  z-index: 4;
  left: 0;
  bottom: 32rpx;
  max-width: 78%;
  padding: 24rpx 68rpx 26rpx 30rpx;
  border-left: 5rpx solid var(--zhu);
  background: linear-gradient(94deg,
    rgba(252,250,244,.90) 0%, rgba(252,250,244,.78) 58%,
    rgba(252,250,244,.34) 86%, rgba(252,250,244,0) 100%);
}
.has-cover .silk {
  background: linear-gradient(94deg,
    rgba(26,23,20,.78) 0%, rgba(26,23,20,.64) 58%,
    rgba(26,23,20,.28) 86%, rgba(26,23,20,0) 100%);
}

/* 关联小程序「App 入口横条」——首页与二级页共用，1→N 统一样式 */
.app-list { display: flex; flex-direction: column; gap: 20rpx; }
.app-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.08);
}
.app-row-hover { transform: translateY(-2rpx); box-shadow: 0 12rpx 28rpx rgba(74,50,30, 0.14); }
/* 真·圆角 App 图标：aspectFit 铺满方形（满版方图完美填充；透明/长图则以色阶托底居中） */
.app-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(74,50,30, 0.2);
}
.app-icon--circle { border-radius: 50%; }
/* 有图时用白底托住，避免透明 PNG 叠在 hc1 深蓝上只剩月牙 */
.app-icon--plate {
  background: var(--paper-card);
  box-shadow: 0 6rpx 16rpx rgba(74,50,30, 0.12);
}
.app-icon-img { width: 100%; height: 100%; }
.app-icon-seal { color: var(--paper-card); font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; }
.app-body { flex: 1; min-width: 0; }
.app-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 「协同小程序 · 点击打开」那一条。原来是 #EEF2FB 的冷蓝白全圆角胶囊——
   旧调色板漏下来的，而它就挂在首页「关联应用」那一行，天天看得见。
   收成和 .pill 同一方小签：直角、纸底、细框、一道受光白线。 */
.app-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  padding: 4rpx 14rpx;
  border-radius: 4rpx;
}
.app-sub {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.app-open {
  display: flex;
  align-items: center;
  gap: 2rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--jin-70);
  flex-shrink: 0;
}

/* 小签：直角纸底细框（--wood-80 对比约 5.8~6.8） */
.pill {
  font-size: 21rpx;                 /* 设计稿 10.5px */
  padding: 4rpx 14rpx;              /* 设计稿 2px 7px */
  border-radius: 4rpx;              /* 设计稿 2px —— 直角，不是胶囊 */
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  flex-shrink: 0;
}
/* 两个变体：朱签 / 金签，只换字色与框色 */
.pill.zhu  { color: var(--zhu);    border-color: rgba(158,43,37,.32); }
.pill.gold { color: var(--jin-70); border-color: rgba(158,125,69,.34); }

/* 详情页收藏；横向边距交给 .detail-wrap */
.fav-bar { display: flex; justify-content: flex-end; margin: 24rpx 0 8rpx; }
/* 收藏签；min-width 锁「已收藏」态宽度 */
.fav-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  font-size: 25rpx;
  color: var(--sub);
  box-sizing: border-box;
  min-width: 172rpx;
}
.fav-btn.fav-on {
  color: var(--zhu);
  border-color: rgba(158,43,37,.32);
  background: var(--zhu-soft);
  box-shadow: none;
}
.fav-bar-inline { margin: 20rpx 0 0; justify-content: flex-start; }
/* 与 .res-dl 并排的纸钮 + 金线（72rpx） */
.fav-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 0 0 1rpx rgba(198,158,98,.45), inset 0 2rpx 0 rgba(255,252,244,.9);
  flex-shrink: 0;
}
.fav-icon:active {
  background: linear-gradient(180deg, var(--paper-2), var(--paper-3));
  box-shadow: inset 0 0 0 1rpx rgba(198,158,98,.45), inset 0 2rpx 4rpx rgba(74,50,30,.14);
}
/* 已收藏：钮面盖成朱，金线换朱线 */
.fav-icon.fav-on {
  background: var(--zhu-soft);
  box-shadow: inset 0 0 0 1rpx rgba(158,43,37,.32);
}
/* 按下不再另配一个更深的粉色，改成在同一张朱纸上压一层朱的薄影：
   少一个写死的色值，深浅关系反而更准。 */
.fav-icon.fav-on:active {
  background: linear-gradient(rgba(124,28,23,.10), rgba(124,28,23,.10)), var(--zhu-soft);
  box-shadow: inset 0 0 0 1rpx rgba(158,43,37,.32), inset 0 2rpx 4rpx rgba(124,28,23,.16);
}
