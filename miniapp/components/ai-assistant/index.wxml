<!-- 知识问答浮标；ENABLE_AI_CHAT=false 时整块不渲染 -->
<block wx:if="{{enabled}}">
<!-- 金镶玉圆牌：鎏金外箍 + 青白玉牌面 + 当中阴刻小篆「问」。
     玉的质感（水头、绺、阴刻）在 PNG 里，图由 scripts/build-ai-fab.mjs 生成。 -->
<view class="ai-fab" style="bottom: calc({{bottom}}rpx + env(safe-area-inset-bottom));" bindtap="open">
  <view class="pulse"></view>
  <image class="ai-fab-img" src="/assets/images/ai-fab.png" mode="aspectFit" />
</view>

<!-- 遮罩 -->
<view class="mask {{open ? 'show' : ''}}" bindtap="close" catchtouchmove="noop"></view>

<!-- 底部抽屉 -->
<view class="sheet {{open ? 'show' : ''}} {{onTabBar ? 'above-tabbar' : ''}}">
  <view class="sheet-head">
    <!-- 抽屉头像就是浮标本身那枚玉牌：点开前后是同一件东西，不该换脸。
         原来是棕色圆底 + 单色线描「问」牌，和首页那枚对不上。 -->
    <view class="avt"><image class="avt-img" src="/assets/images/ai-fab.png" mode="aspectFit" /></view>
    <view class="sheet-head-txt">
      <view class="sheet-title">知识问答</view>
      <view class="sheet-sub" wx:if="{{quotaText}}">{{quotaText}}</view>
    </view>
    <view class="sheet-close" bindtap="close">
      <icon name="chevron-right" size="18" color="#6B6459" sw="2.6" />
    </view>
  </view>

  <scroll-view scroll-y class="sheet-body" scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <block wx:for="{{messages}}" wx:key="index">
      <view class="bubble {{item.role}}" id="m{{index}}">{{item.text}}</view>
    </block>
    <view class="chips" wx:if="{{firstAsk}}">
      <view class="chip" wx:for="{{chips}}" wx:key="*this" data-q="{{item}}" bindtap="onChip">{{item}}</view>
    </view>
  </scroll-view>

  <view class="sheet-foot">
    <view class="sheet-input">
      <input
        class="ai-input"
        value="{{input}}"
        placeholder="向知识问答提问…"
        placeholder-class="ai-ph"
        maxlength="500"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="send"
      />
      <!-- 发送 = 雁字。纸飞机是西方符号；中文里"寄信"的本相是雁阵排成人字 -->
      <view class="send" bindtap="send"><icon name="send" size="25" color="#FFFBF2" /></view>
    </view>
    <view class="ai-note">摘自平台已录入资料</view>
  </view>
</view>
</block>
