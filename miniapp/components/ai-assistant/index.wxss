/* 书院助手浮标 + 底部抽屉 */
/* 上一版是蓝色渐变圆 + 白色机器人图标 + 金色脉冲环：
   配色不搭，形制也不是这套东西（机器人是 AI 的国际符号）。
   现在是一枚金镶玉圆牌，牌面本身就是图，所以这里不再画底色与边框——
   再加一层圆底会把玉的边缘盖住。 */
.ai-fab {
  position: fixed;
  right: 32rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  /* 玉牌是实心的，投影用暖褐；金属件离纸面比按钮更近，压得比原来轻 */
  box-shadow: 0 12rpx 30rpx rgba(96,78,44, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 400;
}
.ai-fab:active { transform: scale(0.94); }
.ai-fab-img {
  width: 112rpx;
  height: 112rpx;
  display: block;
}
/* 脉冲环收细、改成金线的颜色：原来 4rpx 的环压在玉牌边上会糊掉金箍 */
.pulse {
  position: absolute;
  left: -6rpx; top: -6rpx; right: -6rpx; bottom: -6rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(203, 168, 107, 0.7);
  animation: aiPulse 2.2s infinite;
}
@keyframes aiPulse {
  0%   { transform: scale(1);   opacity: 0.7; }
  70%  { transform: scale(1.4); opacity: 0; }
  100% { opacity: 0; }
}
.ai-badge {
  position: absolute;
  top: -8rpx; right: -8rpx;
  background: var(--jin-60);
  color: var(--paper-card);
  font-size: 18rpx;
  font-weight: 700;
  padding: 3rpx 12rpx;
  border-radius: 20rpx;
  border: 3rpx solid var(--paper-card);
}

.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  /* 原来是 rgba(15,20,46,.45) 的冷蓝黑，压在暖调页面上发灰 */
  background: rgba(20, 16, 12, 0.5);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 600;
}
.mask.show { opacity: 1; pointer-events: auto; }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 80vh;
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-radius: 44rpx 44rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.36s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: 610;
  display: flex;
  flex-direction: column;
}
.sheet.show { transform: translateY(0); }

/* tabBar 页：bottom 抬到栏上（144rpx＝回纹 40 + 栏身 104 + 安全区）。
   自定义 tabBar 在页面外，z-index 压不住；收起位移须含同一高度。 */
.sheet.above-tabbar {
  bottom: calc(144rpx + env(safe-area-inset-bottom));
  /* 先写无 env 的兜底，再写带安全区的精确值 */
  transform: translateY(calc(100% + 144rpx + 68rpx));
  transform: translateY(calc(100% + 144rpx + env(safe-area-inset-bottom)));
}
/* 须写在 .sheet.above-tabbar 之后，否则展开态被收起位移盖住 */
.sheet.above-tabbar.show { transform: translateY(0); }
.sheet.above-tabbar .sheet-foot {
  padding-bottom: 16rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}
/* 抽屉头像 = 浮标那枚玉牌本身。牌面自带金箍和玉的质感，
   所以这里不画底色也不画描边，再压一层圆底会把金箍盖住（和 .ai-fab 同理）。 */
.avt {
  width: 76rpx; height: 76rpx;
  flex-shrink: 0;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(96,78,44,.22);
}
.avt-img { width: 76rpx; height: 76rpx; display: block; }
.sheet-head-txt { flex: 1; }
.sheet-title { font-weight: 700; color: var(--ink); font-size: 30rpx; }
.sheet-sub { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.sheet-close {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transform: rotate(90deg);
}

.sheet-body {
  flex: 1;
  min-height: 0;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}
.bubble {
  max-width: 80%;
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  font-size: 27rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
  word-break: break-word;
}
.bubble.ai {
  /* 对面说的话：白纸。原来是 --sky-3 的淡绿 */
  background: var(--paper-1);
  color: var(--ink);
  border-top-left-radius: 8rpx;
  border: 1rpx solid var(--line);
}
.bubble.me {
  /* 自己说的话：杏色纸，同全屏对话页的 .bubble.me。
     原来是 blue→navy 的深色渐变块，一屏几句就把纸面全压住了。 */
  background-color: var(--xing-10);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  color: var(--ink);
  border: 1rpx solid var(--xing-30);
  border-top-right-radius: 8rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,252,244,.8);
  margin-left: auto;
}
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  font-size: 24rpx;
  padding: 14rpx 24rpx;
  /* 可点的小签，同全屏对话页的 .chip。原来是 32rpx 全圆胶囊 + --sky 描边 */
  border-radius: 8rpx;
  background: linear-gradient(180deg, rgba(255,252,244,.95), rgba(234,226,208,.6));
  color: var(--jin-70);
  border: 1rpx solid var(--line);
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
}
.chip:active {
  background: linear-gradient(180deg, var(--paper-2), var(--paper-3));
  box-shadow: inset 0 2rpx 4rpx rgba(74,50,30,.14);
}

/* 底栏：输入区 + AI 生成标识 */
.sheet-foot {
  flex-shrink: 0;
  border-top: 1rpx solid var(--line);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.sheet-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx 0;
}
.ai-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--muted);
  padding: 10rpx 28rpx 0;
}
.ai-input {
  flex: 1;
  height: 84rpx;
  border: 1rpx solid var(--line);
  /* 输入面凹进纸里；圆角收到 14rpx，不再是一颗 42rpx 的全圆药丸 */
  border-radius: 14rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  background: var(--paper-sunk);
  box-shadow: inset 0 2rpx 4rpx rgba(74,50,30,.10);
}
.ai-ph { color: var(--muted); }
/* 发送键改朱砂。抽屉里唯一的主操作，朱是这套设计的点缀色，
   全站用得极省（印、菱形、轮播当前页、公告左沿），落在这里正好；
   原来那道棕金渐变和左上角的玉牌抢，两个圆看着像一对，分不出谁是按钮。 */
.send {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  /* 平涂的朱，不做渐变。设计稿里朱一律是平的（菱形、圆点、公告左沿、
     绢条左沿），一做渐变就成了"另一种红"；深浅两头也没有对应的令牌，
     硬调两个色值出来等于在令牌体系外面自立一套。
     立体感交给一道内高光和一层投影，两件都用 rgba，不占新颜色。 */
  background: var(--zhu);
  box-shadow: 0 6rpx 16rpx rgba(110,30,26,.28),
              inset 0 2rpx 0 rgba(255,236,232,.30),
              inset 0 -3rpx 6rpx rgba(70,16,14,.26);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.send:active { transform: translateY(2rpx); box-shadow: 0 2rpx 6rpx rgba(110,30,26,.30); }
