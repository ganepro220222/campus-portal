/* 书院助手浮标 + 底部抽屉 */
/* 上一版是蓝色渐变圆 + 白色机器人图标 + 金色脉冲环：
   配色不搭，形制也不是这套东西（机器人是 AI 的国际符号）。
   现在是一枚金镶玉圆牌，牌面本身就是图，所以这里不再画底色与边框——
   再加一层圆底会把玉的边缘盖住。 */
.ai-fab {
  position: fixed;
  right: 32rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  /* 玉牌是实心的，投影用暖褐；金属件离纸面比按钮更近，压得比原来轻 */
  box-shadow: 0 12rpx 30rpx rgba(96,78,44, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 400;
}
.ai-fab:active { transform: scale(0.94); }
.ai-fab-img {
  width: 112rpx;
  height: 112rpx;
  display: block;
}
/* 脉冲环收细、改成金线的颜色：原来 4rpx 的环压在玉牌边上会糊掉金箍 */
.pulse {
  position: absolute;
  left: -6rpx; top: -6rpx; right: -6rpx; bottom: -6rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(203, 168, 107, 0.7);
  animation: aiPulse 2.2s infinite;
}
@keyframes aiPulse {
  0%   { transform: scale(1);   opacity: 0.7; }
  70%  { transform: scale(1.4); opacity: 0; }
  100% { opacity: 0; }
}
.ai-badge {
  position: absolute;
  top: -8rpx; right: -8rpx;
  background: var(--jin-60);
  color: var(--card);
  font-size: 18rpx;
  font-weight: 700;
  padding: 3rpx 12rpx;
  border-radius: 20rpx;
  border: 3rpx solid var(--card);
}

.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(15, 20, 46, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 600;
}
.mask.show { opacity: 1; pointer-events: auto; }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: 80vh;
  background: var(--card);
  border-radius: 44rpx 44rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.36s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: 610;
  display: flex;
  flex-direction: column;
}
.sheet.show { transform: translateY(0); }

/* tabBar 页面：抽屉整体抬到导航栏之上。
   不能靠 z-index 压过去——自定义 tabBar 是页面之外的独立层，
   页面里给再高的 z-index 也盖不住它（真机实测：输入框与发送键被整条切掉）。
   108rpx 与 custom-tab-bar/index.wxss 的 .tabbar 高度一致；
   安全区那段已由 tabbar 自己的 padding-bottom 占掉，这里再算一次会多让一截。 */
.sheet.above-tabbar {
  bottom: calc(108rpx + env(safe-area-inset-bottom));
}
.sheet.above-tabbar .sheet-foot {
  padding-bottom: 16rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 36rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}
.avt {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--blue), var(--navy));
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.sheet-head-txt { flex: 1; }
.sheet-title { font-weight: 700; color: var(--ink); font-size: 30rpx; }
.sheet-sub { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }
.sheet-close {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transform: rotate(90deg);
}

.sheet-body {
  flex: 1;
  min-height: 0;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}
.bubble {
  max-width: 80%;
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  font-size: 27rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
  word-break: break-word;
}
.bubble.ai {
  background: var(--sky-3);
  color: var(--ink);
  border-top-left-radius: 8rpx;
  border: 1rpx solid var(--line);
}
.bubble.me {
  background: linear-gradient(135deg, var(--blue), var(--navy));
  color: var(--card);
  border-top-right-radius: 8rpx;
  margin-left: auto;
}
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  font-size: 24rpx;
  padding: 14rpx 24rpx;
  border-radius: 32rpx;
  background: var(--card);
  color: var(--navy);
  border: 1rpx solid var(--sky);
}
.chip:active { background: var(--sky-3); }

/* 底栏：输入区 + AI 生成标识 */
.sheet-foot {
  flex-shrink: 0;
  border-top: 1rpx solid var(--line);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.sheet-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx 0;
}
.ai-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--muted);
  padding: 10rpx 28rpx 0;
}
.ai-input {
  flex: 1;
  height: 84rpx;
  border: 1rpx solid var(--line);
  border-radius: 42rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  background: var(--paper);
}
.ai-ph { color: var(--muted); }
.send {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--blue), var(--navy));
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.send:active { opacity: 0.85; }
