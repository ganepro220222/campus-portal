/* components/loading/index.wxss */
.loading-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; z-index: 9999; }
.loading-box  { background: var(--paper-card); border-radius: 16rpx; padding: 40rpx 48rpx; display: flex; flex-direction: column; align-items: center; }
/* 转圈：底环原来是写死的 #eee（中性灰），在米白纸上发青。
   换成本套的纸阶 --paper-3，转头用金棕。 */
.loading-spinner { width: 60rpx; height: 60rpx; border: 6rpx solid var(--paper-3); border-top-color: var(--jin-60); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 16rpx; font-size: 26rpx; color: var(--muted); }
