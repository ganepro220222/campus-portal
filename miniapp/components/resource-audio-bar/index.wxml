<!-- components/resource-audio-bar/index.wxml -->
<view wx:if="{{visible}}" class="rab-root">
  <view class="rab-spacer"></view>
  <view class="rab">
    <view class="rab-btn" catchtap="onClose" hover-class="rab-btn-hover">
      <icon name="close" size="18" color="#4C505C" />
    </view>
    <view class="rab-btn {{playing ? 'rab-btn-on' : ''}}" catchtap="onToggle" hover-class="rab-btn-hover">
      <icon wx:if="{{error}}" name="refresh" size="18" color="#7E6134" />
      <icon wx:elif="{{playing}}" name="pause" size="18" color="#FFFBF2" />
      <icon wx:else name="play" size="18" color="#7E6134" />
    </view>
    <view class="rab-main">
      <view class="rab-name">{{name}}</view>
      <view class="rab-row">
        <text class="rab-time">{{currentText}}</text>
        <slider
          class="rab-slider"
          min="0"
          max="100"
          step="1"
          value="{{progress}}"
          activeColor="#7E6134"
          backgroundColor="#D5DCEC"
          block-size="12"
          disabled="{{duration <= 0 || error}}"
          bindchanging="onSeekChanging"
          bindchange="onSeekChange"
        />
        <text class="rab-time">{{durationText}}</text>
      </view>
      <text wx:if="{{error}}" class="rab-error">{{error}}</text>
      <text wx:elif="{{hint}}" class="rab-hint">{{hint}}</text>
    </view>
  </view>
</view>
