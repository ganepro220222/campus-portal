/* components/resource-audio-bar/index.wxss */
.rab-root {
  flex-shrink: 0;
}
.rab-spacer {
  height: calc(148rpx + env(safe-area-inset-bottom));
}
.rab {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 350;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  /* 底栏是纸，不是白玻璃 */
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -8rpx 24rpx rgba(74,50,30, 0.08);
}
.rab-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  /* 纸钮 + 金线，同 .fav-icon / .res-dl。原来是 --sky-2 的淡绿底 */
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 0 0 1rpx rgba(198,158,98,.45), inset 0 2rpx 0 rgba(255,252,244,.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 播放中：朱钮。朱在这套里只做标记位，"正在响"正是要标记的那个状态；
   原来是 --navy 的棕金实心块，和静息的淡绿差得不明显。 */
.rab-btn-on {
  background: var(--zhu);
  box-shadow: inset 0 2rpx 0 rgba(255,236,232,.28), 0 2rpx 6rpx rgba(110,30,26,.24);
}
.rab-btn-hover {
  background: linear-gradient(180deg, var(--paper-2), var(--paper-3));
  box-shadow: inset 0 0 0 1rpx rgba(198,158,98,.45), inset 0 2rpx 4rpx rgba(74,50,30,.14);
}
.rab-btn-on.rab-btn-hover {
  background: linear-gradient(rgba(124,28,23,.16), rgba(124,28,23,.16)), var(--zhu);
  box-shadow: inset 0 2rpx 4rpx rgba(70,16,14,.28);
}
.rab-main {
  flex: 1;
  min-width: 0;
}
.rab-name {
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rab-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 4rpx;
}
.rab-time {
  font-size: 20rpx;
  color: var(--muted);
  width: 72rpx;
  flex-shrink: 0;
}
.rab-time:last-child {
  text-align: right;
}
.rab-slider {
  flex: 1;
  min-width: 0;
  margin: 0;
}
.rab-error {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--zhu);
}
.rab-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}
