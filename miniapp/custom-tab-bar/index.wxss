/* 自定义底部导航 —— 方案「书院 · 檐棂印」
   对照 design/demo/v2/shuyuan.css 的 .fret / .tabbar / .tab 三条规则。
   设计稿是 375pt 宽的 px，这里一律 ×2 换成 rpx。 */

.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
}

/* ── 回纹带 ──────────────────────────────────────────────────
   同一组纹样画两遍：深色（--fret-cut）当刻痕在上，
   浅色（--fret-lit）往下错 2.2rpx 当受光面在下。
   两层缺一层就不是「刻」出来的，是贴上去的。
   底色是一层极淡的金棕——设计稿里就是写死的 rgba，照搬。 */
.fret {
  height: 40rpx;
  background-color: rgba(173, 130, 72, .07);
  background-image: var(--fret-cut), var(--fret-lit);
  background-position: 0 0, 0 2.2rpx;
  background-size: 96rpx 40rpx;
  background-repeat: repeat-x;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 252, 244, .55),
    inset 0 -2rpx 0 rgba(107, 67, 38, .10);
}

/* ── 栏身 ────────────────────────────────────────────────────
   底是纸，不是毛玻璃。原来这里是 rgba(255,255,255,.96) + backdrop-filter，
   那是旧稿的白玻璃：压在米白纸上会显出一块**更白**的条，
   整页的纸感到最底下断掉。换成 --paper-card + 淡纤维（--fiber，opacity .05，
   比书页那张 --fiber-page 淡一档，因为这是一层薄纸不是一页书）。 */
.tabbar {
  display: flex;
  align-items: center;
  /* 显式给高度，不让内容撑：让位高度（utils/tabRoutes.js 的 TAB_BAR_HEIGHT_RPX、
     书院助手抽屉的 bottom）都按这个数算，撑出来的高度没人算得准。
     content-box（wxss 默认，app.wxss 只给了 page 一个 border-box），
     所以安全区那段 padding 加在 104rpx 之外。 */
  height: 104rpx;
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-top: 1rpx solid var(--line);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 252, 244, .9),
    0 -6rpx 24rpx rgba(74, 50, 30, .06);
  /* 设计稿的 22px 底边在真机上就是 Home Indicator 那一条，
     所以交给安全区，不写死——没有刘海的机型不该白白多出一截。 */
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab:active {
  opacity: 0.7;
}

/* 未选中 --jin-70，选中 --jin-80。图标那一跳更大（--jin-60 → --jin-80），
   颜色在 index.js 里给，因为图标是烤成图片的，颜色得进 data URI。 */
.tab-txt {
  font-size: 21rpx;
  line-height: 1.2;
  color: var(--jin-70);
  transition: color 0.2s;
  white-space: nowrap;
}

.tab.on .tab-txt {
  color: var(--jin-80);
}
