<!-- packageA/craft/detail.wxml -->
<view class="detail-page">
  <nav-bar title="文创详情" />

  <view wx:if="{{loading}}" class="page-state-box">
    <text class="page-state-text">加载中…</text>
  </view>

  <view wx:elif="{{loadError}}" class="page-state-box">
    <icon class="page-state-icon" name="alert" size="40" color="#C3CCE0" />
    <text class="page-state-text">文创加载失败，请检查网络后重试</text>
    <view class="page-state-action" bindtap="onRetry">重新加载</view>
    <view class="page-state-link" bindtap="onBackList">返回文创列表</view>
  </view>

  <view wx:elif="{{notFound}}" class="page-state-box">
    <text class="page-state-text">文创不存在或已下架</text>
    <view class="page-state-link" bindtap="onBackList">返回文创列表</view>
  </view>

  <block wx:elif="{{detail}}">
    <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
      <text>文创信息刷新失败，点击重试</text>
    </view>

  <scroll-view scroll-y class="detail-scroll" enhanced show-scrollbar="{{false}}">
    <view class="detail-wrap">

      <!-- 多角度图片轮播 -->
      <view class="gal">
        <swiper class="gslides" circular="{{slides.length > 1}}" bindchange="onGallery"
          indicator-dots="{{slides.length > 1}}" indicator-color="rgba(255,255,255,.4)" indicator-active-color="#ffffff">
          <swiper-item wx:for="{{slides}}" wx:key="angleLabel">
            <view class="gimg {{item.cls}}" bindtap="onPreview" data-url="{{item.imageUrl}}">
              <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="gimg-img" />
              <icon wx:else name="{{item.icon}}" size="60" color="rgba(255,255,255,0.55)" />
            </view>
          </swiper-item>
        </swiper>
        <view class="gcap">{{detail.name}} · {{slides[galleryIndex].angleLabel}}（点击查看大图）</view>
      </view>

      <!-- 介绍 -->
      <view class="craft-intro">
        <view class="ci-head">
          <view class="ci-title serif">{{detail.name}}</view>
          <view class="lang-switch">
            <view class="lang-btn {{lang === 'zh' ? 'lang-on' : ''}}" data-lang="zh" bindtap="onLangSwitch">中文</view>
            <view class="lang-btn {{lang === 'en' ? 'lang-on' : ''}}" data-lang="en" bindtap="onLangSwitch">EN</view>
          </view>
        </view>
        <view class="ci-tags">
          <text class="pill gold">非遗工艺</text>
          <text class="pill">多图鉴赏</text>
        </view>
        <view class="ci-body">{{lang === 'zh' ? detail.introZh : detail.introEn}}</view>
      </view>

      <!-- 联系方式 -->
      <view class="contact">
        <view class="contact-title serif">合作与咨询</view>
        <view class="c-row" bindtap="onPhone" data-val="{{detail.contact.phone}}">
          <view class="c-ic c-blue"><icon name="megaphone" size="18" color="#ffffff" /></view>
          <view class="c-body"><text class="c-k">电话</text><text class="c-v">{{detail.contact.phone}}</text></view>
          <text class="c-act">拨打</text>
        </view>
        <view class="c-row" bindtap="onCopy" data-val="{{detail.contact.wechat}}">
          <view class="c-ic c-green"><icon name="wechat" size="18" color="#ffffff" /></view>
          <view class="c-body"><text class="c-k">微信</text><text class="c-v">{{detail.contact.wechat}}</text></view>
          <text class="c-act">复制</text>
        </view>
        <view class="c-row" bindtap="onCopy" data-val="{{detail.contact.email}}">
          <view class="c-ic c-gold"><icon name="send" size="18" color="#ffffff" /></view>
          <view class="c-body"><text class="c-k">邮箱</text><text class="c-v">{{detail.contact.email}}</text></view>
          <text class="c-act">复制</text>
        </view>
      </view>

      <view class="fav-bar">
        <view class="fav-btn {{collected ? 'fav-on' : ''}}" bindtap="onCollect">
          <icon name="bookmark" size="16" color="{{collected ? '#C0392B' : '#5A648A'}}" />
          <text>{{collectLabel}}</text>
        </view>
      </view>

      <view class="poster-btn-wrap">
        <button class="poster-btn" bindtap="onPoster">
          <icon name="poster" size="18" color="#ffffff" />
          <text>一键生成分享海报</text>
        </button>
      </view>

      <view class="detail-bottom"></view>
    </view>
  </scroll-view>
  </block>

</view>
