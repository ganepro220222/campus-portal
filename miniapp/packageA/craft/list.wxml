<!-- packageA/craft/list.wxml -->
<view class="craft-page">
  <nav-bar title="文创展示" />
  <scroll-view scroll-y class="craft-scroll" enhanced show-scrollbar="{{false}}">

    <view class="craft-intro">
      <text class="ci-zh serif">匠心精品 · 好物推荐</text>
      <text class="ci-en">Selected Creative Works</text>
    </view>

    <view wx:if="{{loading && !craftList.length && !error}}" class="page-state-box">
      <text class="page-state-text">加载中…</text>
    </view>

    <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
      <text>列表刷新失败，点击重试</text>
    </view>

    <view class="craft-grid">
      <view
        wx:for="{{craftList}}"
        wx:key="id"
        class="ccard"
        bindtap="onCardTap"
        data-id="{{item.id}}"
      >
        <view class="ccard-cover {{item.colorClass}}">
          <view wx:if="{{item.cover}}" class="ccard-bg">
            <image src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="ccard-img" />
          </view>
          <icon name="{{item.icon}}" size="46" color="rgba(255,255,255,0.9)" />
          <text wx:if="{{item.badge}}" class="ccard-badge">{{item.badge}}</text>
        </view>
        <view class="ccard-foot">
          <text class="ccard-name serif">{{item.name}}</text>
          <text class="ccard-desc">{{item.intro}}</text>
          <view class="pill">{{item.categoryName}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{error && !loading && !craftList.length}}" class="page-state-box">
      <icon class="page-state-icon" name="alert" size="40" color="#C3CCE0" />
      <text class="page-state-text">加载失败，请检查网络后重试</text>
      <view class="page-state-action" bindtap="onRetry">重新加载</view>
    </view>

    <view wx:elif="{{!loading && !craftList.length && !error}}" class="empty-state">
      <icon name="medal" size="40" color="#C3CCE0" />
      <text>暂无文创内容</text>
    </view>

    <view class="list-bottom"></view>
  </scroll-view>
</view>
