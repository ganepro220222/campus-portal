/* packageA/craft/list.wxss */
.craft-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 页顶原来是一道 --sky-2 的淡绿往下褪成纸，旧稿的"顶部有色"套路 */
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}
.craft-scroll { flex: 1; overflow: hidden; }

.craft-intro { padding: 28rpx 32rpx 4rpx; }
.ci-zh { font-size: 34rpx; font-weight: 700; color: var(--ink); display: block; }
.ci-en { font-size: 20rpx; color: var(--muted); letter-spacing: 1rpx; margin-top: 6rpx; display: block; }

.craft-grid {
  padding: 20rpx 32rpx 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 24rpx;
}
.ccard {
  /* 网格项 min-width:0，避免撑开列宽 */
  min-width: 0;
  border-radius: 26rpx;
  overflow: hidden;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.10);
  transition: transform 0.15s;
}
.ccard:active { transform: translateY(-4rpx); }
.ccard-cover {
  position: relative;
  height: 210rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.ccard-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ccard-img { width: 100%; height: 100%; opacity: 0.42; }
.ccard-badge {
  position: absolute;
  top: 14rpx; right: 14rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--paper-card);
  /* 原来是 rgba(12,16,36,.32) 的冷蓝黑 + 白描边 + 16rpx 胶囊；
     换成暖墨 + 金线 + 直角，和全站的小签同族 */
  background: rgba(20, 16, 12, 0.42);
  border: 1rpx solid rgba(203, 168, 107, 0.55);
  padding: 3rpx 12rpx;
  border-radius: 4rpx;
}
.ccard-foot { padding: 18rpx 20rpx 22rpx; }
.ccard-name {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.35;
  word-break: break-all;
}
.ccard-desc {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ccard-foot .pill { margin-top: 14rpx; }

.list-bottom { height: calc(60rpx + env(safe-area-inset-bottom)); }

/* 全局 .page-refresh-bar 默认 28rpx 横向边距（对齐详情页栏距），本页内容栏距是 32rpx（.craft-intro / .craft-grid），
   不覆写的话红条会比下方卡片各窄 4rpx，边缘对不齐。加根类提权，避免依赖样式表先后顺序。 */
.craft-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
