/* packageA/hall/detail.wxss */
/* 页底：纸 + 淡纤维，和其它页同一档 */
.detail-page {
  height: 100vh; display: flex; flex-direction: column;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}
.detail-scroll { flex: 1; overflow: hidden; }
.detail-wrap { padding: 24rpx 28rpx 0; }
.detail-bottom { height: calc(60rpx + env(safe-area-inset-bottom)); }

/* ── 画廊：裱起来的画心 ──
   和首页轮播、展馆封面、动态缩略图同一套装裱：木纹裱边 + 内框金线。
   原来是 28rpx 圆角 + 冷灰蓝投影，三张兜底还是旧蓝紫渐变。 */
.gal {
  position: relative;
  padding: 10rpx;
  border-radius: 20rpx;
  background-color: var(--wood-50);
  background-image:
    repeating-linear-gradient(90deg,
      rgba(58,34,14,.10) 0 2rpx, rgba(255,240,220,.05) 2rpx 4rpx, transparent 4rpx 10rpx),
    linear-gradient(150deg, var(--wood-30), var(--wood-40) 55%, var(--wood-60));
  box-shadow: 0 8rpx 24rpx rgba(74,50,30,.16);
}
.gslides {
  height: 420rpx;
  border-radius: 6rpx;
  overflow: hidden;
  box-shadow: inset 0 0 0 2rpx rgba(58,34,14,.45);
}
.gimg {
  height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.gimg-photo {
  width: 100%;
  height: 100%;
}
/* 没有图时垫绢底，不再用旧蓝紫的三档色块。三档只差一点点色相，
   是为了相邻两张不同色，不是为了"这张是什么类型"。 */
.gi1 { background: var(--juan-1); }
.gi2 { background: var(--juan-2); }
.gi3 { background: var(--juan-3); }
.gcap {
  position: absolute;
  left: 10rpx; right: 10rpx; bottom: 10rpx;
  padding: 48rpx 24rpx 20rpx;
  z-index: 2;
  /* 原来是 rgba(12,16,36,.7) 的冷蓝黑，压在暖调页面上发灰 */
  background: linear-gradient(transparent, rgba(20, 16, 12, 0.66));
  color: var(--paper-card);
  font-size: 24rpx;
  line-height: 1.45;
}

/* VR 入口 */
.vr-block {
  margin-top: 24rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  padding: 24rpx 26rpx;
  box-shadow: var(--shadow-sm);
}
.vr-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  height: 88rpx;
  /* 这一页的主操作。走朱砂漆钮（同登录页）：上沿提亮、下沿压深、底下垫一道边，
     四层缺一层就是一块平涂的红方块。原来是全圆角 + blue→navy 渐变。 */
  border-radius: 12rpx;
  background: linear-gradient(180deg, var(--zhu-lit), var(--zhu) 52%, var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.30),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 4rpx 10rpx rgba(158,43,37,.28);
  color: var(--paper-card);
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}
.vr-btn::after { border: none; }
/* 不可用：褪成素钮，不是一块冷蓝灰（原来是 #E8ECF4） */
.vr-btn-off {
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9);
  color: var(--muted);
}
.vr-hint {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}

/* 语音讲解 */
.audio {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  padding: 22rpx 26rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow-sm);
}
.ap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  /* 播放钮：朱砂漆钮的小一号 */
  background: linear-gradient(180deg, var(--zhu-lit), var(--zhu) 52%, var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.28), 0 3rpx 8rpx rgba(158,43,37,.24);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding-left: 4rpx;
  box-sizing: border-box;
}
/* 播放中：换成金钮，一眼分得出两个态 */
.ap-on {
  /* 金钮压深一档：--jin-50 上白图标只有 2.40:1；jin-60 起步是 3.72:1，过图形要的 3 */
  background: linear-gradient(180deg, var(--jin-60), var(--jin-80));
  box-shadow: inset 0 2rpx 0 rgba(255,250,240,.35), 0 3rpx 8rpx rgba(126,97,52,.26);
  padding-left: 0;
}
.aw { flex: 1; display: flex; align-items: center; gap: 6rpx; height: 56rpx; }
.aw-paused .wv-bar { animation-play-state: paused; opacity: 0.55; }
.wv-bar {
  flex: 1;
  background: var(--jin-50);
  border-radius: 4rpx;
  height: 14rpx;
  animation: wv 1.1s ease-in-out infinite;
}
@keyframes wv {
  0%, 100% { height: 14rpx; }
  50% { height: 44rpx; }
}
.at { font-size: 22rpx; color: var(--muted); flex-shrink: 0; }

/* 介绍 */
.hall-intro {
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow-sm);
}
.hi-title { font-size: 38rpx; font-weight: 700; color: var(--ink); line-height: 1.35; }
.hi-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hi-p {
  font-size: 27rpx;
  line-height: 1.9;
  color: var(--ink);
  margin-top: 18rpx;
  text-align: justify;
}
/* 海报按钮：居中、随内容宽度，上限不超过卡片 */
.poster-btn-wrap {
  display: flex;
  justify-content: center;
  margin-top: 26rpx;
}
.poster-btn {
  width: auto;
  max-width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 0 32rpx;
  height: 92rpx;
  border-radius: 12rpx;
  /* 金钮压深一档：--jin-50 太亮，纸白的字压上去只有 2.40:1。
     jin-70 起步量到 5.57:1，过正文要的 4.5。 */
  background: linear-gradient(180deg, var(--jin-70), var(--jin-80));
  box-shadow: inset 0 2rpx 0 rgba(255,250,240,.35);
  color: var(--paper-card);
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  box-shadow: inset 0 2rpx 0 rgba(255,250,240,.35), 0 6rpx 18rpx rgba(126,97,52,.26);
}
.poster-btn text {
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.3;
}
.poster-btn::after { border: none; }

/* 沉浸式长卷 */
.immersive {
  margin-top: 24rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.imm-head {
  padding: 28rpx 28rpx 16rpx;
  border-bottom: 1rpx dashed var(--line);
}
.imm-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.imm-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.imm-nav {
  white-space: nowrap;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}
.imm-chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 12rpx 24rpx;
  /* 小签，不是全圆角胶囊（同 app.wxss 的 .pill） */
  border-radius: 4rpx;
  font-size: 24rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
}
/* 选中的那一段走朱印 */
.imm-chip-on {
  color: var(--paper-card);
  border-color: var(--zhu-d);
  background: linear-gradient(180deg, var(--zhu), var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.28),
              inset 0 -2rpx 0 rgba(78,18,14,.45);
  font-weight: 600;
}
.imm-body { padding: 8rpx 0 12rpx; }
.imm-section { padding: 24rpx 28rpx 8rpx; }
.imm-section + .imm-section {
  border-top: 1rpx dashed var(--line);
  margin-top: 8rpx;
}
.imm-sec-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.imm-sec-num {
  width: 44rpx;
  height: 44rpx;
  /* 凹进纸里的一方，同动态详情「相关推荐」的序号 */
  border-radius: 4rpx;
  background: var(--paper-sunk);
  color: var(--wood-80);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.imm-sec-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.35;
  word-break: break-all;
}
.imm-card { margin-bottom: 22rpx; }
.imm-img {
  height: 320rpx;
  border-radius: 22rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.imm-photo { width: 100%; height: 100%; }
.imm-cap {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--sub);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  word-break: break-all;
}

/* 顶部阅读进度：贴合导航栏下沿的细线，不遮挡任何交互元素 */
.read-progress {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: 6rpx;
  background: rgba(96,78,44, 0.08);
  z-index: 50;
}
.read-progress-bar {
  height: 100%;
  border-radius: 0 6rpx 6rpx 0;
  background: linear-gradient(90deg, var(--jin-50), var(--zhu));
  transition: width 0.15s ease;
}
