<!-- packageA/news/detail.wxml -->
<view class="detail-page">
  <!-- 加载 / 失败 / 下架时卷首还没出来，顶栏不能跟着藏进画里。 -->
  <nav-bar wx:if="{{loading || loadError || notFound}}" title="书院动态" />

  <view wx:if="{{loading}}" class="page-state-box">
    <text class="page-state-text">加载中…</text>
  </view>

  <view wx:elif="{{loadError}}" class="page-state-box">
    <icon class="page-state-icon" name="alert" size="40" color="#957C58" />
    <text class="page-state-text">内容加载失败，请检查网络后重试</text>
    <view class="page-state-action" bindtap="onRetry">重新加载</view>
    <view class="page-state-link" bindtap="onBackList">返回动态列表</view>
  </view>

  <view wx:elif="{{notFound}}" class="page-state-box">
    <text class="page-state-text">内容不存在或已下架</text>
    <view class="page-state-link" bindtap="onBackList">返回动态列表</view>
  </view>

  <block wx:elif="{{article}}">
    <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
      <text>内容刷新失败，点击重试</text>
    </view>

    <scroll-view scroll-y class="detail-scroll" enhanced show-scrollbar="{{false}}">
      <view class="detail-wrap">

        <!-- 文章 -->
        <view class="article">
          <!-- 卷首：和首页同一幅小青绿，矮一档（这一页的主角是正文不是画）。
               上传了封面图时，图**裱成一方册页压在画上**，画不退场——
               画是这套方案的身份，不该被一张用户上传的图挤掉。
               屋檐、返回键、题签都在图之上，所以图再满也压不住它们。 -->
          <view class="art-hero">
            <image class="art-hero-shan" src="/assets/images/hero-shan-art.png" mode="scaleToFill" aria-hidden="true" />
            <view wx:if="{{article.cover && !article.coverFailed}}" class="art-hero-veil"></view>
            <!-- 这里**不加** has-cover：那个类带的是一层很重的暗角，
                 是给"图上压着字"的框用的（轮播、展馆封面）。册页上没有字，
                 加了只会把封面压成一块黑。 -->
            <view wx:if="{{article.cover && !article.coverFailed}}" class="hero-mount mount">
              <view class="mount-art">
                <image
                  class="mount-cover art-hero-img"
                  src="{{article.cover}}"
                  mode="{{article.coverImageMode}}"
                  lazy-load
                  data-cover="{{article.cover}}"
                  binderror="onCoverError"
                />
              </view>
            </view>
            <!-- 题签：竖着写的一条签，贴在画的右上。封面图再满也压不住它——
                 它本来就在画心之外。 -->
            <text wx:if="{{article.category}}" class="tag-v serif">{{article.category}}</text>
            <nav-bar title="书院动态" overlay="{{true}}" />
          </view>

          <view class="sheet">
          <!-- 标题落在纸上，不压在画上：封面图是用户传的，
               花成什么样都不该影响读标题。 -->
          <view class="art-head">
            <text wx:if="{{article.category}}" class="ah-cat">{{article.category}}</text>
            <view class="ah-title serif">{{article.title}}</view>
          </view>
          <view class="art-body">
            <view class="art-meta">
              <text>{{article.date}}</text>
              <text>阅读 {{article.read}}</text>
              <text wx:if="{{article.category}}" class="pill zhu">{{article.category}}</text>
            </view>
            <view wx:if="{{article.showLead && article.lead}}" class="art-lead {{article.dropCap ? '' : 'art-lead--plain'}}">
              <text class="drop serif {{article.dropCap ? '' : 'drop--raised'}}">{{article.drop}}</text>{{article.leadRest}}
            </view>
            <view wx:if="{{article.useRichText}}" class="art-rich">
              <rich-text class="art-rich-nodes" nodes="{{article.contentHtml}}" space="nbsp" />
            </view>
            <block wx:else>
              <view class="art-p" wx:for="{{article.paras}}" wx:key="index">{{item}}</view>
            </block>

            <view class="act-row">
              <view class="act {{liked ? 'act-on' : ''}}" bindtap="onLike">
                <icon name="thumb" size="16" color="{{liked ? '#9E2B25' : '#4C505C'}}" />
                <text>{{likeLabel}}</text>
              </view>
              <view class="act {{collected ? 'act-on' : ''}}" bindtap="onCollect">
                <icon name="bookmark" size="16" color="{{collected ? '#9E2B25' : '#4C505C'}}" />
                <text>{{collectLabel}}</text>
              </view>
              <button class="act act-share-btn" open-type="share" hover-class="act-share-hover">
                <icon name="share" size="16" color="#4C505C" />
                <text>分享</text>
              </button>
            </view>
          </view>
          </view><!-- /sheet -->
        </view>

        <!-- 回纹带：正文和「相关推荐」之间的分隔（设计稿 news-detail.html
             在这个位置放的就是 .fret）。tab 页那条在标签栏上方，同一件东西。 -->
        <view class="fret fret--div"></view>

        <!-- 相关推荐。段头和首页各段是同一件：一枚朱印 + 题名（设计稿
             news-detail.html 用的就是 .sec-head > .sec-title > .seal-sm）。 -->
        <view class="reco">
          <view class="sec-head">
            <view class="sec-title serif">
              <image class="seal-sm" src="/assets/images/seal-zhu.png" mode="aspectFit" />
              相关推荐</view>
          </view>
          <view class="reco-it" wx:for="{{reco}}" wx:key="id" data-id="{{item.id}}" bindtap="onRecoTap">
            <view class="reco-num {{index === 0 ? 'reco-num--mark' : ''}}">{{index + 1}}</view>
            <view class="reco-txt">
              <view class="reco-n">{{item.n}}</view>
              <view class="reco-m">{{item.m}}</view>
            </view>
          </view>
        </view>

        <view class="detail-bottom"></view>
      </view>
    </scroll-view>
  </block>

  <ai-assistant bottom="60" />
</view>
