/* packageA/news/detail.wxss */
.detail-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.detail-scroll { flex: 1; overflow: hidden; }
/* 卷首出血，横距交给纸内各段 */
.detail-wrap { padding: 0; }
.detail-bottom { height: calc(60rpx + env(safe-area-inset-bottom)); }

/* 画 + 纸；非卡片壳 */
.article { margin-bottom: 24rpx; }
/* 卷首：标题在纸上；画通栏；封面裱成册页压画上 */
.art-hero {
  position: relative;
  height: 536rpx;             /* ＝设计稿 268px，比首页矮一档 */
  overflow: hidden;
}
.art-hero-shan {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  /* 268 高专用图，非首页 368 压缩 */
}
/* 册页压在画上时，画要退一步——不压的话两幅图抢焦点 */
.art-hero-veil {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 2;
  pointer-events: none;
  background: rgba(248, 243, 230, .30);
}
/* 册页：横幅，不是竖轴——文章封面绝大多数是横图，竖框会把它裁烂。
   宽度按比例给，高度由 3:2 定，换机型时册页和卷首一起缩放。 */
/* 位置和设计稿不同，这一处是量出来改的，理由写清楚：
   设计稿给的是 top:86px / width:52%，但那份演示稿里**没有封面图**，
   册页那一档没跟顶栏一起验过。按它摆，册页会盖住返回键和标题——
   违反「原生控件让位」的②③两条（压住按钮就按不到，压住文字就读不到）。
   所以改成从标题行下沿起排：
     顶栏行底 = 状态栏 + 檐 92rpx - 重叠 4rpx + 标题行 80rpx ≈ 256rpx
     纸从 536 - 52 = 484rpx 处盖上来
   册页落在 258→478 这一段里（44% 宽 → 330rpx，3:2 → 220rpx 高），
   上下各留一线，谁也不压谁。 */
.hero-mount {
  position: absolute;
  z-index: 3;
  left: 50%;
  transform: translateX(-50%);
  top: 258rpx;
  width: 44%;
}
.hero-mount .mount-art {
  height: 0;
  padding-bottom: 66.67%;     /* 3 : 2 */
}
.art-hero-img { width: 100%; height: 100%; }
/* 题签：贴在画的右上，比标题行再低一点，不和它抢那一行 */
.art-hero .tag-v { top: 208rpx; right: 40rpx; z-index: 6; }

/* ── 标题落在纸上 ── */
.art-head { padding: 8rpx 40rpx 0; }
.ah-cat {
  display: inline-flex;
  align-items: center;
  font-size: 23rpx;
  letter-spacing: 4.8rpx;
  color: var(--zhu-d);
}
/* 签前一道朱短线，和栏目印是同一门语言 */
.ah-cat::before {
  content: '';
  width: 30rpx;
  height: 2rpx;
  margin-right: 14rpx;
  background: var(--zhu);
  opacity: .8;
}
.ah-title {
  margin-top: 18rpx;
  font-size: 46rpx;
  line-height: 1.52;
  letter-spacing: 1.2rpx;
  color: var(--ink);
}
.art-body { padding: 30rpx 40rpx 0; }
/* 原来这一行是「📅 日期」「👁 阅读」两个 emoji 加文字。
   emoji 由系统字体画，各端长得都不一样，而且是整页唯一的彩色元素。
   定稿里这一行就是素素的三段小字，分类另走小签。 */
.art-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  padding-bottom: 26rpx;
  margin-bottom: 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.art-p {
  font-size: 29rpx;
  line-height: 1.9;
  color: var(--ink);
  margin-bottom: 22rpx;
  text-align: justify;
}
.art-lead {
  font-size: 29rpx;
  line-height: 1.9;
  color: var(--sub);
  margin-bottom: 22rpx;
  padding-bottom: 22rpx;
  border-bottom: 1rpx dashed var(--line);
  text-align: justify;
  /*
   * .drop 是 float:left，脱离普通流。这里建立 BFC 把它兜回来，
   * 否则首字比绕排文字高时会越过下面那条虚线，虚线从大字腰上横穿过去。
   * 用 overflow 而不是 display:flow-root，是因为老 iOS 的 WKWebView 不认后者。
   */
  overflow: hidden;
}
/* 短摘要不下沉（见 shouldDropCap），改成行内略抬高，避免老师觉得「这条没放大」 */
.art-lead--plain {
  color: var(--sub);
}
.art-rich {
  font-size: 29rpx;
  line-height: 1.9;
  color: var(--ink);
  margin-bottom: 22rpx;
  text-align: justify;
}
/* 打在组件上，内部段落才有机会继承 29rpx；只写在包裹 view 上，rich-text 经常吃不到 */
.art-rich-nodes {
  display: block;
  width: 100%;
  font-size: 29rpx;
  line-height: 1.9;
  color: var(--ink);
}
.art-rich image {
  max-width: 100%;
  border-radius: 12rpx;
  margin: 16rpx 0;
}
/* 首字下沉：书口的做法，压一枚朱色底。
   原来是金棕的粗体字、没有底 —— 那只是"第一个字大一号"，
   不是书口那枚印。照设计稿的 .drop 收：朱字、朱晕底、直角。 */
.drop {
  float: left;
  font-size: 78rpx;
  line-height: 0.92;
  color: var(--zhu);
  padding: 10rpx 18rpx;
  margin: 8rpx 18rpx 0 0;
  background: var(--zhu-soft);
  border-radius: 4rpx;
}
.drop--raised {
  float: none;
  display: inline;
  font-size: 42rpx;
  line-height: 1.2;
  padding: 2rpx 8rpx;
  margin: 0 6rpx 0 0;
  vertical-align: -2rpx;
}

.act-row { display: flex; gap: 18rpx; margin-top: 8rpx; }
.act {
  flex: 1;
  height: 78rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9), 0 2rpx 4rpx rgba(74,50,30,.08);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 25rpx;
  color: var(--sub);
}
/* 按下去是纸被按了一下，不是换一块绢青 */
.act:active { background: var(--paper-2); }
/* 选中态照设计稿的 .act.on：朱字 + 朱框 + 朱晕底 */
.act-on { color: var(--zhu); border-color: rgba(158,43,37,.34); background: var(--zhu-soft); }
.act-share-btn {
  flex: 1;
  height: 78rpx;
  margin: 0;
  padding: 0;
  font-weight: normal;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  line-height: normal;
}
.act-share-btn::after { border: none; }
.act-share-hover { background: var(--paper-2); }

/* 相关推荐：落纸上，自留横距；上距 44rpx＝设计稿 22px */
.reco {
  margin: 44rpx 28rpx 0;
  padding: 0 0 36rpx;
}
/* 段头同上；margin-top 28rpx＝设计稿 14px */
.reco .sec-head { margin-top: 28rpx; margin-bottom: 8rpx; }
.reco-it {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.reco-it:last-of-type { border-bottom: none; }
/* 序号：凹进纸里的一方，不是一块绢青色块（设计稿的 .reco-num） */
.reco-num {
  flex: 0 0 44rpx;
  height: 44rpx;
  border-radius: 4rpx;
  background: var(--paper-sunk);
  color: var(--wood-80);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 三条里第一条的序号盖成朱——朱在这套里只做标记位，标的是"最该先看的那条"。
   设计稿写的是 .reco-it:nth-child(2)：那是因为 .sec-head 占了第 1 个孩子，
   算下来正好是第一条推荐。这里不抄那个下标——它依赖"段头一定在里面、
   一定只有一个"，谁往 .reco 里再塞一个元素就整体错位。
   改成 wxml 按 index 给类，意思写在脸上。 */
.reco-num.reco-num--mark {
  background: var(--zhu);
  color: var(--paper-card);
}
.reco-n { font-size: 26rpx; color: var(--ink); line-height: 1.45; }
.reco-m { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
