/* packageA/news/list.wxss */
.news-page {
  min-height: 100vh;
  /* 页顶原来是一道 --sky-2 的淡绿往下褪成纸，旧稿的"顶部有色"套路 */
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}

/* 分类栏（吸顶） */
.cats {
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  padding: 16rpx 0;
  /* 吸顶的分类栏是纸，不是旧调色板那层冷蓝白玻璃。
     吸顶就必须不透明——半透明的话下面的卡片滚过去会从纹样里透出来。 */
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-bottom: 1rpx solid var(--line);
}
.cats-inner { display: inline-flex; gap: 16rpx; padding: 0 28rpx; }
.cat {
  flex: 0 0 auto;
  font-size: 25rpx;
  padding: 12rpx 28rpx;
  /* 分类：一排小签，选中的那一方盖成朱印。
     原来是 32rpx 全圆胶囊，选中态是 blue→navy 的渐变色块。 */
  border-radius: 8rpx;
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  border: 1rpx solid var(--line);
  color: var(--sub);
}
.cat-on {
  background: var(--zhu);
  box-shadow: none;
  color: var(--paper-card);
  border-color: var(--zhu-d);
}

/* 列表 */
.news-list { padding: 20rpx 28rpx 0; }
.ncard {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-sm);
}
.ncard:active { background: var(--paper-2); }
.nthumb {
  flex: 0 0 184rpx;
  height: 132rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}
.nthumb-img { width: 100%; height: 100%; }
.nbody { flex: 1; min-width: 0; }
.ntitle {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.nmeta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.nmeta-r { display: flex; align-items: center; gap: 14rpx; flex-shrink: 0; }
.nread { display: flex; align-items: center; gap: 5rpx; }
.nread text { font-size: 20rpx; color: var(--muted); }
.ndate { font-size: 21rpx; color: var(--muted); }

.list-tip { text-align: center; color: var(--muted); font-size: 23rpx; padding: 30rpx; }
.list-tip-retry { color: var(--jin-70); }
.list-bottom { height: calc(40rpx + env(safe-area-inset-bottom)); }
