<!-- packageB/course/detail.wxml -->
<view class="detail-page">
  <nav-bar title="在线课程" />

  <view wx:if="{{loading}}" class="page-state-box">
    <text class="page-state-text">加载中…</text>
  </view>

  <view wx:elif="{{loadError}}" class="page-state-box">
    <icon class="page-state-icon" name="alert" size="40" color="#C3CCE0" />
    <text class="page-state-text">课程加载失败，请检查网络后重试</text>
    <view class="page-state-action" bindtap="onRetry">重新加载</view>
    <view class="page-state-link" bindtap="onBackList">返回课程列表</view>
  </view>

  <view wx:elif="{{notFound}}" class="page-state-box">
    <text class="page-state-text">课程不存在或已下架</text>
    <view class="page-state-link" bindtap="onBackList">返回课程列表</view>
  </view>

  <block wx:elif="{{course}}">
    <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
      <text>课程信息刷新失败，点击重试</text>
    </view>

    <scroll-view scroll-y class="detail-scroll" enhanced show-scrollbar="{{false}}">
      <view class="detail-wrap">

        <!-- 播放器 -->
        <view class="player">
          <view class="player-bg"></view>
          <view class="cc" bindtap="onCC">
            <icon name="cc" size="13" color="#ffffff" /> AI 字幕
          </view>
          <view class="play" bindtap="onPlay"><icon name="play" size="26" color="#2B356E" /></view>
        </view>

        <!-- 课程信息 -->
        <view class="cmeta">
          <view class="cmeta-title serif">{{course.name}}</view>
          <view wx:if="{{progressHint}}" class="progress-hint">{{progressHint}}</view>
          <view class="cmeta-tags">
            <text wx:for="{{course.tags}}" wx:key="*this" class="pill {{item === 'AI 字幕' ? 'gold' : ''}}">{{item}}</text>
          </view>
          <view class="minfo">
            <view class="mi"><icon name="users" size="15" color="#2B356E" /><text>授课对象：{{course.audience}}</text></view>
            <view class="mi"><icon name="clock" size="15" color="#2B356E" /><text>课程时长：{{course.duration}}</text></view>
            <view class="mi"><icon name="calendar" size="15" color="#2B356E" /><text>开课时间：{{course.openTime}}</text></view>
            <view class="mi"><icon name="book" size="15" color="#2B356E" /><text>分类：{{course.category}}</text></view>
          </view>
          <view class="intro">{{course.intro}}</view>
          <view class="fav-bar fav-bar-inline">
            <view class="fav-btn {{collected ? 'fav-on' : ''}}" bindtap="onCollect">
              <icon name="bookmark" size="16" color="{{collected ? '#C0392B' : '#5A648A'}}" />
              <text>{{collectLabel}}</text>
            </view>
          </view>
        </view>

        <!-- 配套资源 -->
        <view class="res-title">配套资源下载</view>
        <view class="res" wx:for="{{course.resources}}" wx:key="id">
          <view class="ft ft-{{item.fileType || item.type}}">{{item.fileType || item.type}}</view>
          <view class="res-info">
            <view class="res-n">{{item.name}}</view>
            <view class="res-s">{{item.fileSizeText || item.size}}</view>
          </view>
          <view class="res-dl {{downloadingId === item.id ? 'is-loading' : ''}}" bindtap="onDownload" data-id="{{item.id}}" data-name="{{item.name}}" data-file-type="{{item.fileType || item.type}}">
            <text wx:if="{{downloadingId === item.id}}" class="res-dl-loading">下载中</text>
            <icon wx:else name="download" size="17" color="#2B356E" />
          </view>
        </view>

        <view class="detail-bottom"></view>
      </view>
    </scroll-view>
  </block>

  <ai-assistant bottom="60" />
</view>
