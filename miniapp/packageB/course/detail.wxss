/* packageB/course/detail.wxss */
/* 页底：纸 + 淡纤维，和其它详情页同一档 */
.detail-page {
  height: 100vh; display: flex; flex-direction: column;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}
.detail-scroll { flex: 1; overflow: hidden; }
.detail-wrap { padding: 24rpx 28rpx 0; }
.detail-bottom { height: calc(60rpx + env(safe-area-inset-bottom)); }

/* 播放器 */
.player {
  border-radius: 28rpx;
  overflow: hidden;
  /* 播放器该是暗的（视频本来就暗），但要暗在这套的暖调上。
     原来是 #0c1024 —— 旧稿的冷蓝黑，压在米白纸上像贴了块别人的屏。
     --mo-90 是匾面阴刻填的墨，同样黑，是暖的。 */
  background: var(--mo-90);
  position: relative;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
}
.player-bg {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  /* 原来是 navy-deep→blue；换成青墨到檐木，还是同一道斜光，只是不冷了 */
  background: linear-gradient(120deg, var(--qing-90), var(--wood-90));
  opacity: 0.85;
}
.play {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  /* 暗底上的播放钮：一张纸 + 一圈金线，和全站的纸钮同族 */
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  box-shadow: inset 0 0 0 2rpx rgba(198,158,98,.55),
              inset 0 2rpx 0 rgba(255,252,244,.9),
              0 8rpx 24rpx rgba(20, 16, 12, 0.36);
  padding-left: 6rpx;
  box-sizing: border-box;
}
.cc {
  position: absolute;
  top: 22rpx; right: 22rpx;
  z-index: 3;
  font-size: 21rpx;
  color: var(--paper-card);
  background: rgba(190, 156, 68, 0.9);
  padding: 7rpx 16rpx;
  /* 直角小签，不是胶囊 */
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.pbar { position: absolute; left: 26rpx; right: 26rpx; bottom: 24rpx; z-index: 3; }
.ptrack { height: 8rpx; border-radius: 4rpx; background: rgba(255, 255, 255, 0.25); }
.pfill { height: 100%; width: 34%; border-radius: 4rpx; background: var(--gold); }
.ptime {
  display: flex;
  justify-content: space-between;
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

/* 课程信息 */
.cmeta {
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow-sm);
}
.cmeta-title { font-size: 38rpx; font-weight: 700; color: var(--ink); }
.cmeta-tags { display: flex; gap: 14rpx; margin: 18rpx 0 24rpx; flex-wrap: wrap; }
.minfo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18rpx; }
.mi {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--sub);
}
.mi text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.intro {
  font-size: 26rpx;
  line-height: 1.8;
  color: var(--ink);
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx dashed var(--line);
}

/* 配套资源 */
.res-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin: 32rpx 0 18rpx;
  padding-left: 20rpx;
  position: relative;
}
.res-title::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  /* 段头的竖标：朱，同全站 */
  background: var(--zhu);
}
.res {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}
.ft {
  flex: 0 0 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--paper-card);
  font-size: 20rpx;
  font-weight: 700;
  text-transform: uppercase;
}
.res-info { flex: 1; min-width: 0; }
.res-n { font-size: 26rpx; color: var(--ink); font-weight: 500; }
.res-s { font-size: 21rpx; color: var(--muted); margin-top: 6rpx; }
.res-dl {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  /* 纸钮 + 金线，和 .fav-icon 取齐（两颗常常并排出现，形制必须一样）。
     原来是 --sky-2 的淡绿底、无描边。 */
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 0 0 1rpx rgba(198,158,98,.45), inset 0 2rpx 0 rgba(255,252,244,.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.res-dl:active,
.res-dl.is-loading {
  background: linear-gradient(180deg, var(--paper-2), var(--paper-3));
  box-shadow: inset 0 0 0 1rpx rgba(198,158,98,.45), inset 0 2rpx 4rpx rgba(74,50,30,.14);
}
.res-dl-loading { font-size: 17rpx; color: var(--jin-70); }
