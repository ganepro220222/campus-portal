<!-- packageB/course/player.wxml — 真视频播放 -->
<view class="player-page">

  <view class="stage">
    <video
      wx:if="{{videoUrl && !loadError && !videoFailed}}"
      id="courseVideo"
      class="course-video"
      src="{{videoUrl}}"
      poster="{{cover}}"
      initial-time="{{initialTime}}"
      direction="90"
      controls
      show-center-play-btn
      enable-play-gesture
      object-fit="contain"
      bindtimeupdate="onTimeUpdate"
      bindended="onEnded"
      bindplay="onPlay"
      bindpause="onPause"
      binderror="onVideoError"
      bindseekcomplete="onSeekComplete"
      bindloadedmetadata="onVideoLoadedMetadata"
    />
    <view wx:elif="{{loadError}}" class="video-empty">
      <text class="video-empty-ic">▶</text>
      <text>课程加载失败</text>
      <view class="player-retry" bindtap="onRetryLoad">重新加载</view>
    </view>
    <view wx:elif="{{videoFailed}}" class="video-empty">
      <text class="video-empty-ic">▶</text>
      <text>视频播放失败</text>
      <view class="player-retry" bindtap="onRetryVideo">重新加载</view>
    </view>
    <view wx:else class="video-empty">
      <text class="video-empty-ic">▶</text>
      <text>课程视频暂未配置</text>
    </view>
    <view wx:if="{{hasSubtitle}}" class="cc-badge {{cc ? 'cc-on' : ''}}" catchtap="onCC">
      <icon name="cc" size="13" color="#ffffff" /> AI 字幕
    </view>
  </view>

  <view wx:if="{{cc && subtitleText}}" class="subtitle">
    <view class="sub-tag"><icon name="cc" size="12" color="#2B356E" /> AI</view>
    <text class="sub-tx">{{subtitleText}}</text>
  </view>

  <view wx:if="{{progressLoadError}}" class="page-refresh-bar" bindtap="onRetryProgress">
    <text>上次学习位置加载失败，视频已从头开始。点击重新获取</text>
  </view>
  <view wx:elif="{{offerResumeJump}}" class="page-refresh-bar player-resume-bar" bindtap="onJumpToSaved">
    <text>已找到上次位置 {{savedPositionLabel}}，点击跳转</text>
  </view>

  <scroll-view scroll-y class="player-scroll" enhanced show-scrollbar="{{false}}">
    <view class="now serif">{{course.name}}</view>
    <view class="now-sub">{{progressStatusText}}</view>
    <view wx:if="{{course.intro}}" class="intro">{{course.intro}}</view>
    <view class="player-bottom"></view>
  </scroll-view>

</view>
