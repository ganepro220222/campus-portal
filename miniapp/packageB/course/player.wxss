/* packageB/course/player.wxss */
/* 页底：纸 + 淡纤维 */
.player-page {
  height: 100vh; display: flex; flex-direction: column;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}

.stage {
  position: relative;
  height: 420rpx;
  flex-shrink: 0;
  /* 播放台该是暗的，但要暗在这套的暖调上。原来是 #0c1024 的冷蓝黑，
     和课程详情的播放器同一笔账，一起换成 --mo-90（匾面阴刻填的墨）。 */
  background: var(--mo-90);
  overflow: hidden;
}
.course-video {
  width: 100%;
  height: 100%;
}
.video-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  /* 这几行字是压在**暗台**上的，原来却用 --muted（纸上的提示灰）：
     量过只有 3.22:1，正文要 4.5:1，一直都偏暗看不清。
     换成纸色，对 --mo-90 是 12.3:1。 */
  color: var(--paper-3);
  font-size: 26rpx;
}
.video-empty-ic {
  font-size: 48rpx;
  /* 大三角是装饰，压暗一档，别抢走那行字 */
  color: var(--wood-40);
  line-height: 1;
}
.player-retry {
  margin-top: 8rpx;
  padding: 10rpx 28rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 暗台上的次操作：直角 10rpx + 一圈金线，不再是 28rpx 的全圆胶囊 */
  border-radius: 10rpx;
  border: 1rpx solid rgba(203, 168, 107, 0.55);
  background: rgba(203, 168, 107, 0.10);
  color: var(--gold-soft);
  font-size: 24rpx;
}
.cc-badge {
  position: absolute;
  top: 24rpx; right: 24rpx;
  z-index: 3;
  font-size: 21rpx;
  color: var(--paper-card);
  background: rgba(255, 255, 255, 0.14);
  padding: 8rpx 18rpx;
  /* 直角小签，同课程详情的 .cc */
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid rgba(203, 168, 107, 0.5);
}
/* 旧调色板的那支金换成本套的 --jin-50 */
.cc-badge.cc-on { background: rgba(198, 158, 98, 0.92); border-color: transparent; }

.subtitle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 18rpx 28rpx 0;
  padding: 18rpx 22rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
}
.sub-tag {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--jin-70);
  /* 小签，同 .pill */
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  border: 1rpx solid var(--line);
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
}
.sub-tx { flex: 1; font-size: 24rpx; line-height: 1.6; color: var(--ink); }

.player-scroll { flex: 1; overflow: hidden; padding: 0 28rpx; }
.now { font-size: 34rpx; font-weight: 700; color: var(--ink); margin-top: 26rpx; }
.now-sub { font-size: 23rpx; color: var(--muted); margin-top: 8rpx; }
.player-resume-bar {
  background: rgba(96,78,44, 0.08);
  border-color: rgba(96,78,44, 0.18);
  color: var(--jin-70);
}
.player-resume-bar:active { background: rgba(96,78,44, 0.12); }
.intro {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-2);
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 22rpx;
}
.player-bottom { height: calc(60rpx + env(safe-area-inset-bottom)); }
