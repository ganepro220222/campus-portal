<!-- packageB/resource/list.wxml -->
<view class="res-page">
  <nav-bar title="资源下载" />

  <view class="res-top">
    <view class="res-search">
      <icon name="search" size="17" color="#67708C" />
      <input class="rs-input" placeholder="搜索资源名称…" placeholder-class="rs-ph"
        value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    </view>
    <scroll-view scroll-x class="res-cats" enhanced show-scrollbar="{{false}}">
      <view class="rc-inner">
        <view
          wx:for="{{cats}}"
          wx:key="*this"
          class="rc {{activeCat === index ? 'rc-on' : ''}}"
          data-i="{{index}}"
          bindtap="switchCat"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view scroll-y class="res-scroll" enhanced show-scrollbar="{{false}}">
    <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
      <text>列表刷新失败，点击重试</text>
    </view>

    <view class="res" wx:for="{{resourceList}}" wx:key="id">
      <view class="ft {{item.ftClass}}">{{item.ftLabel}}</view>
      <view class="res-info">
        <view class="res-n">{{item.name}}</view>
        <view class="res-meta">
          <text class="pill">{{item.kind}}</text>
          <text class="res-s">{{item.categoryName}} · {{item.fileSizeText}}</text>
        </view>
      </view>
      <view class="res-actions">
        <view class="fav-icon {{item.collected ? 'fav-on' : ''}}" catchtap="onCollect" data-id="{{item.id}}">
          <icon name="bookmark" size="16" color="{{item.collected ? '#C0392B' : '#5A648A'}}" />
        </view>
        <view class="res-dl {{downloadingId === item.id ? 'is-loading' : ''}}" catchtap="onDownload" data-id="{{item.id}}" data-name="{{item.name}}" data-file-type="{{item.fileType}}">
          <text wx:if="{{downloadingId === item.id}}" class="res-dl-loading">下载中</text>
          <icon wx:else name="download" size="18" color="#2B356E" />
        </view>
      </view>
    </view>

    <view wx:if="{{error && !loading && !all.length}}" class="page-state-box">
      <icon class="page-state-icon" name="alert" size="40" color="#C3CCE0" />
      <text class="page-state-text">加载失败，请检查网络后重试</text>
      <view class="page-state-action" bindtap="onRetry">重新加载</view>
    </view>

    <view wx:elif="{{!loading && !resourceList.length && !error}}" class="empty-state">
      <icon name="download" size="40" color="#C3CCE0" />
      <text>暂无相关资源</text>
    </view>

    <view class="list-bottom"></view>
  </scroll-view>
</view>
