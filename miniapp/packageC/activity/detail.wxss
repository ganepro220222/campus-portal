/* packageC/activity/detail.wxss */
.detail-page {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  flex-direction: column;
}

.detail-scroll {
  flex: 1;
  height: 0;
}

.state-box {
  padding: 120rpx 40rpx;
  text-align: center;
}
.state-text { font-size: 28rpx; color: var(--muted); line-height: 1.6; }

.detail-retry {
  display: inline-block;
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  /* 重试键：素钮，不是绢青胶囊 */
  color: var(--jin-70);
  padding: 16rpx 40rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9);
}
.detail-retry:active { background: var(--paper-3); }

.detail-retry-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--jin-70);
}
.detail-retry-link:active { opacity: 0.7; }

.detail-refresh-bar {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: rgba(158, 43, 37, 0.08);
  border: 1rpx solid rgba(158, 43, 37, 0.18);
  border-radius: 16rpx;
  text-align: center;
}
.detail-refresh-bar:active { background: rgba(158, 43, 37, 0.12); }
.detail-refresh-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--zhu);
}

/* 封面 */
.hero {
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
/* 顶部高光 + 底部压暗，让白卡叠加更自然 */
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(120% 80% at 50% 0%, rgba(255, 255, 255, 0.18), transparent 60%),
    linear-gradient(180deg, transparent 55%, rgba(20, 16, 12, 0.34) 100%);
  z-index: 1;
}
.hero-img { width: 100%; height: 100%; position: absolute; left: 0; top: 0; }
.hero-tag {
  position: absolute;
  left: 28rpx;
  top: 28rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--paper-card);
  background: rgba(12, 16, 36, 0.32);
  border: 1rpx solid rgba(240, 220, 160, 0.6);
  padding: 7rpx 20rpx;
  border-radius: 20rpx;
  z-index: 2;
  backdrop-filter: blur(6rpx);
}

/* 主体卡片 */
.body {
  margin: -40rpx 24rpx 0;
  background: var(--paper-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 34rpx 28rpx 24rpx;
  box-shadow: 0 -6rpx 24rpx rgba(74,50,30, 0.08);
  position: relative;
  z-index: 3;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.45;
  margin-bottom: 22rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--sub);
  margin-bottom: 14rpx;
}

.quota-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 0 4rpx;
}
.quota-chip {
  font-size: 24rpx;
  font-weight: 600;
  /* 名额：小签。原来是绢青 → 冷蓝白的渐变胶囊 */
  color: var(--jin-70);
  border-radius: 4rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  padding: 10rpx 22rpx;
}
.quota-chip.full { color: var(--muted); }
.review-chip {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--wood-80);
  border-radius: 4rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  padding: 10rpx 18rpx;
}

.enroll-window {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
  margin: 16rpx 0;
}

.status-banner {
  font-size: 26rpx;
  font-weight: 600;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  margin: 20rpx 0;
  border-left: 8rpx solid transparent;
}
.status-pending { color: var(--jin-70); background: var(--xing-05); border-left-color: var(--jin-60); }
/* 三档状态只用这套自己的颜色：待审素、通过金、驳回朱（同 packageC/profile/list） */
.status-approved { color: var(--jin-70); background: var(--xing-05); border-left-color: var(--jin-60); }
.status-rejected { color: var(--zhu); background: var(--zhu-soft); border-left-color: var(--zhu); }
.voucher-inline {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-top: 10rpx;
  color: var(--jin-80);
}

.section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed var(--line);
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
  position: relative;
  padding-left: 20rpx;
}
.section-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  /* 段头的竖标：朱，和首页段头那枚印是同一条线索 */
  background: var(--zhu);
}
.intro {
  font-size: 27rpx;
  color: var(--sub);
  line-height: 1.85;
  white-space: pre-wrap;
  text-align: justify;
}

.scroll-bottom {
  height: calc(170rpx + env(safe-area-inset-bottom));
}

/* 底部操作栏 */
.foot-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  /* 底栏是纸，不是白玻璃 —— 和标签栏同一条账（白玻璃压在米白纸上会显出
     一条更白的带，整页的纸感在最底下断掉） */
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -4rpx 20rpx rgba(74,50,30, 0.06);
  display: flex;
  gap: 16rpx;
  z-index: 10;
}

.btn-primary,
.btn-outline,
.btn-disabled {
  flex: 1;
  height: 92rpx;
  border-radius: 12rpx;
  font-size: 31rpx;
  font-weight: 700;
  border: none;
  margin: 0;
  padding: 0;
}
.btn-primary::after,
.btn-outline::after,
.btn-disabled::after { border: none; }
/* 报名 = 这一页的主操作，走朱砂漆钮（同登录页、展馆 VR 键） */
.btn-primary {
  color: var(--paper-card);
  background: linear-gradient(180deg, var(--zhu-lit), var(--zhu) 52%, var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.30),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 4rpx 10rpx rgba(158,43,37,.28);
}
/* 次操作：素钮 */
.btn-outline {
  color: var(--jin-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9);
}
.btn-disabled {
  color: var(--muted);
  background: var(--paper-2);
}
.btn-half { flex: 1; }
