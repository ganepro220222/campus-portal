/* packageC/activity/enroll.wxss */
.enroll-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

.enroll-scroll {
  flex: 1;
}

.state-box {
  padding: 120rpx 40rpx;
  text-align: center;
}
.state-text { font-size: 28rpx; color: var(--muted); line-height: 1.6; }

.enroll-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 16rpx 40rpx;
  border-radius: 28rpx;
}
.enroll-retry:active { background: var(--sky); }

.enroll-retry-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--blue);
}
.enroll-retry-link:active { opacity: 0.7; }

/* 活动摘要 */
.summary-card {
  margin: 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.06);
  position: relative;
  overflow: hidden;
}
.summary-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, var(--jin-50), var(--jin-60));
}
.summary-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.45;
  margin-bottom: 16rpx;
}
.summary-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--sub);
  margin-bottom: 10rpx;
}

/* 表单 */
.form-card {
  margin: 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx 28rpx 32rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.06);
}
.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
  position: relative;
  padding-left: 20rpx;
}
.form-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, var(--blue), var(--navy));
}
.form-hint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 26rpx;
}

.field { margin-bottom: 24rpx; }
.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.field-input {
  height: 92rpx;
  padding: 0 26rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.field-err .field-input {
  border-color: rgba(192, 57, 43, 0.45);
  background: rgba(192, 57, 43, 0.04);
}
.field-error {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-danger);
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 31rpx;
  font-weight: 700;
  color: var(--card);
  background: linear-gradient(135deg, var(--blue), var(--navy));
  border: none;
  margin-top: 12rpx;
  box-shadow: 0 12rpx 30rpx rgba(96,78,44, 0.32);
}
.btn-primary::after { border: none; }

/* 报名结果 */
.result-card {
  margin: 24rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 52rpx 32rpx 40rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
/* 顶部徽记发光底座 */
.result-card icon:first-child {
  padding: 24rpx;
  border-radius: 50%;
  background: rgba(201, 162, 39, 0.12);
}
.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-top: 24rpx;
}
.result-code {
  font-size: 40rpx;
  color: var(--navy);
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-top: 20rpx;
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, var(--sky-2), #E1ECF9);
  border-radius: 16rpx;
}
.result-hint {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  margin: 20rpx 0 34rpx;
}

.voucher-qr-box {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FAFBFE;
  border: 1rpx solid var(--line);
}
.voucher-qr-img {
  width: 320rpx;
  height: 320rpx;
  display: block;
  margin: 0 auto;
}
.voucher-qr-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.voucher-qr-canvas-offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 240px;
  height: 240px;
  opacity: 0;
  pointer-events: none;
}

.btn-outline {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--navy);
  background: var(--card);
  border: 2rpx solid var(--navy);
  margin-bottom: 18rpx;
}
.btn-outline::after { border: none; }
.btn-link {
  font-size: 26rpx;
  color: var(--blue);
  background: transparent;
  border: none;
  line-height: 1.5;
}
.btn-link::after { border: none; }

.scroll-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
