/* packageC/activity/enroll.wxss */
.enroll-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

.enroll-scroll {
  flex: 1;
}

.state-box {
  padding: 120rpx 40rpx;
  text-align: center;
}
.state-text { font-size: 28rpx; color: var(--muted); line-height: 1.6; }

.enroll-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--jin-70);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  padding: 16rpx 40rpx;
  border-radius: 10rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9);
}
.enroll-retry:active { background: var(--paper-3); }

.enroll-retry-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--jin-70);
}
.enroll-retry-link:active { opacity: 0.7; }

/* 活动摘要 */
.summary-card {
  margin: 24rpx;
  background: var(--paper-card);
  border-radius: 24rpx;
  padding: 28rpx 28rpx 28rpx 32rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.06);
  position: relative;
  overflow: hidden;
}
.summary-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, var(--jin-50), var(--jin-60));
}
.summary-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.45;
  margin-bottom: 16rpx;
}
.summary-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--sub);
  margin-bottom: 10rpx;
}

/* 表单 */
.form-card {
  margin: 24rpx;
  background: var(--paper-card);
  border-radius: 24rpx;
  padding: 30rpx 28rpx 32rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.06);
}
.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
  position: relative;
  padding-left: 20rpx;
}
.form-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  /* 段头竖标走朱，和首页段头那枚印同一条线索 */
  background: var(--zhu);
}
.form-hint {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 26rpx;
}

.field { margin-bottom: 24rpx; }
.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.field-input {
  height: 92rpx;
  padding: 0 26rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}
.field-err .field-input {
  border-color: rgba(158, 43, 37, 0.45);
  background: rgba(158, 43, 37, 0.04);
}
.field-error {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--zhu);
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  /* 提交报名 = 主操作，朱砂漆钮（同活动详情、登录页） */
  border-radius: 12rpx;
  font-size: 31rpx;
  font-weight: 700;
  color: var(--paper-card);
  background: linear-gradient(180deg, var(--zhu-lit), var(--zhu) 52%, var(--zhu-d));
  border: none;
  margin-top: 12rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.30),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 4rpx 10rpx rgba(158,43,37,.28);
}
.btn-primary::after { border: none; }

/* 报名结果 */
.result-card {
  margin: 24rpx;
  background: var(--paper-card);
  border-radius: 24rpx;
  padding: 52rpx 32rpx 40rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
/* 顶部徽记发光底座 */
.result-card icon:first-child {
  padding: 24rpx;
  border-radius: 50%;
  background: rgba(201, 162, 39, 0.12);
}
.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-top: 24rpx;
}
.result-code {
  /* 报名号：一方凹进纸里的牌，字走墨 —— 原来是绢青→冷蓝白的渐变块 */
  font-size: 40rpx;
  color: var(--ink);
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-top: 20rpx;
  padding: 16rpx 40rpx;
  background: var(--paper-sunk);
  border-radius: 8rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(120,96,52,.18),
              0 2rpx 0 rgba(255,252,244,.9);
}
.result-hint {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
  margin: 20rpx 0 34rpx;
}

.voucher-qr-box {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
}
.voucher-qr-img {
  width: 320rpx;
  height: 320rpx;
  display: block;
  margin: 0 auto;
}
.voucher-qr-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.voucher-qr-canvas-offscreen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 240px;
  height: 240px;
  opacity: 0;
  pointer-events: none;
}

.btn-outline {
  width: 100%;
  height: 88rpx;
  /* 次操作：素钮 */
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--jin-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9);
  margin-bottom: 18rpx;
}
.btn-outline::after { border: none; }
.btn-link {
  font-size: 26rpx;
  color: var(--jin-70);
  background: transparent;
  border: none;
  line-height: 1.5;
}
.btn-link::after { border: none; }

.scroll-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
