<!-- packageC/feedback/index.wxml -->
<view class="fb-page">
  <nav-bar title="意见反馈" />
  <scroll-view scroll-y class="fb-scroll" enhanced show-scrollbar="{{false}}">

    <view class="fb-card">
      <view class="fb-label">反馈类型</view>
      <view class="fb-types">
        <view
          wx:for="{{types}}"
          wx:key="*this"
          class="fb-type {{typeIndex === index ? 'on' : ''}}"
          data-i="{{index}}"
          bindtap="onType"
        >{{item}}</view>
      </view>

      <view class="fb-label">反馈内容<text class="req">*</text></view>
      <textarea
        class="fb-textarea"
        placeholder="请描述你遇到的问题或建议，我们会认真对待每一条反馈…"
        placeholder-class="fb-ph"
        value="{{content}}"
        bindinput="onContent"
        maxlength="500"
      />
      <view class="fb-count">{{content.length}}/500</view>

      <view class="fb-label">附图（选填，最多 {{maxImages}} 张，需登录）</view>
      <view class="fb-images">
        <view
          wx:for="{{images}}"
          wx:key="id"
          class="fb-img-cell"
        >
          <image
            class="fb-img"
            src="{{item.url || item.localPath}}"
            mode="aspectFill"
            bindtap="onPreviewImage"
            data-src="{{item.url || item.localPath}}"
          />
          <view wx:if="{{item.uploading}}" class="fb-img-mask">上传中…</view>
          <view wx:elif="{{item.failed}}" class="fb-img-mask fb-img-fail">失败</view>
          <view class="fb-img-del" data-id="{{item.id}}" catchtap="onRemoveImage">×</view>
        </view>
        <view
          wx:if="{{images.length < maxImages}}"
          class="fb-img-add"
          bindtap="onChooseImages"
        >
          <text class="fb-img-add-plus">+</text>
          <text class="fb-img-add-tip">添加图片</text>
        </view>
      </view>

      <view class="fb-label">联系方式</view>
      <input
        class="fb-input"
        placeholder="手机号 / 微信（选填，便于必要时联系）"
        placeholder-class="fb-ph"
        value="{{contact}}"
        bindinput="onContact"
      />
    </view>

    <view class="fb-tip">
      <icon name="chat" size="14" color="#BE9C44" />
      <text>提交后，如有管理员回复，将发送至消息中心</text>
    </view>

    <view class="fb-pad"></view>
  </scroll-view>

  <view class="fb-bar">
    <button class="fb-submit {{submitting ? 'ing' : ''}}" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '提交反馈'}}
    </button>
  </view>
</view>
