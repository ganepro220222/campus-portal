/* packageC/feedback/index.wxss */
/* 页底：纸 + 淡纤维 */
.fb-page {
  height: 100vh; display: flex; flex-direction: column;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}
/* 横向内边距放到内容层：scroll-view 的右侧 padding 会被微信滚动容器忽略，导致右侧内容贴边被截 */
.fb-scroll { flex: 1; overflow: hidden; padding: 24rpx 0 0; }

.fb-card {
  margin: 0 28rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.fb-label { font-size: 27rpx; font-weight: 600; color: var(--ink); margin-bottom: 18rpx; }
.fb-label:not(:first-child) { margin-top: 30rpx; }
.req { color: var(--zhu); margin-left: 4rpx; }

.fb-types { display: flex; flex-wrap: wrap; gap: 16rpx; }
/* 反馈类型：一排小签，选中的那一方盖成朱印。
   原来是 30rpx 全圆胶囊 + --sky-3 淡绿底，选中态另来一条 blue→navy 渐变色块。 */
.fb-type {
  font-size: 25rpx;
  color: var(--sub);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  border: 1rpx solid var(--line);
  padding: 12rpx 30rpx;
  border-radius: 8rpx;
}
.fb-type.on {
  background: var(--zhu);
  box-shadow: none;
  color: var(--paper-card);
  border-color: var(--zhu-d);
}

.fb-textarea {
  width: 100%;
  height: 240rpx;
  background: var(--paper-sunk);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 22rpx;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.6;
  box-sizing: border-box;
}
.fb-ph { color: var(--muted); }
.fb-count { text-align: right; font-size: 21rpx; color: var(--muted); margin-top: 10rpx; }

.fb-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.fb-img-cell,
.fb-img-add {
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}
.fb-img {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--paper-sunk);
}
.fb-img-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 原来是 rgba(31,37,71,.45) 的冷蓝黑 */
  background: rgba(20, 16, 12, 0.55);
  color: var(--paper-card);
  font-size: 22rpx;
}
.fb-img-fail {
  flex-direction: column;
  gap: 6rpx;
  /* 失败遮罩改用这套里的朱，不是另一支番茄红 */
  background: rgba(158, 43, 37, 0.62);
}
.fb-img-retry { font-size: 20rpx; opacity: 0.92; }
/* 可见圆点仍 48rpx，热区靠透明 ::after 扩到 88rpx（44pt）。
   要点：父级 .fb-img-cell 是 overflow:hidden，**往外扩的部分会连同热区一起被裁掉**。
   元素本身距上/右各 6rpx，所以外侧最多只能扩 6rpx；再多写也不会生效——
   之前写 -20rpx，实际热区只有 6+48+20 = 74rpx（37pt），并没有到 44pt。
   改成不对称外扩：外侧 -6rpx（正好贴到 cell 边），内侧 -34rpx，
   合计 6+48+34 = 88rpx，整块都落在 cell 内。
   内侧只扩到刚好 88rpx 为止：缩略图本身绑了预览点击，删除区越大越容易误删。 */
.fb-img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(35, 28, 20, 0.58);
  color: var(--paper-card);
  font-size: 30rpx;
  line-height: 48rpx;
  text-align: center;
}
.fb-img-del::after {
  content: "";
  position: absolute;
  /* 元素贴的是右上角：横向外侧是 right、内侧是 left；纵向外侧是 top、内侧是 bottom。
     所以外侧两条（right / top）各 -6rpx，内侧两条（left / bottom）各 -34rpx。 */
  left: -34rpx; top: -6rpx; right: -6rpx; bottom: -34rpx;
}
.fb-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: var(--paper-sunk);
  border: 1rpx dashed var(--line);
}
.fb-img-add-plus {
  font-size: 44rpx;
  color: var(--muted);
  line-height: 1;
}
.fb-img-add-tip {
  font-size: 21rpx;
  color: var(--muted);
}

.fb-input {
  width: 100%;
  height: 88rpx;
  background: var(--paper-sunk);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.fb-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 26rpx 32rpx 0;
}
.fb-tip text { font-size: 22rpx; color: var(--sub); }
.fb-pad { height: 40rpx; }

.fb-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  /* 底栏是纸，不是白玻璃——白玻璃压在米白纸上会显出一条更白的带 */
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-top: 1rpx solid var(--line);
}
.fb-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  /* 这一页的主操作：朱砂漆钮，直角 12rpx。四层缺一层就是一块平涂的红方块 */
  border-radius: 12rpx;
  background: linear-gradient(180deg, var(--zhu-lit), var(--zhu) 52%, var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.30),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 4rpx 10rpx rgba(158,43,37,.28);
  color: var(--paper-card);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
}
.fb-submit::after { border: none; }
.fb-submit.ing { opacity: 0.7; }
