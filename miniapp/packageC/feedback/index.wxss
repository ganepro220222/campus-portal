/* packageC/feedback/index.wxss */
.fb-page { height: 100vh; display: flex; flex-direction: column; background: #F5F8FC; }
/* 横向内边距放到内容层：scroll-view 的右侧 padding 会被微信滚动容器忽略，导致右侧内容贴边被截 */
.fb-scroll { flex: 1; overflow: hidden; padding: 24rpx 0 0; }

.fb-card {
  margin: 0 28rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.fb-label { font-size: 27rpx; font-weight: 600; color: var(--ink); margin-bottom: 18rpx; }
.fb-label:not(:first-child) { margin-top: 30rpx; }
.req { color: var(--color-danger); margin-left: 4rpx; }

.fb-types { display: flex; flex-wrap: wrap; gap: 16rpx; }
.fb-type {
  font-size: 25rpx;
  color: var(--sub);
  background: var(--sky-3);
  border: 1rpx solid var(--line);
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
}
.fb-type.on {
  background: linear-gradient(135deg, #3F57B5, #2B356E);
  color: #fff;
  border-color: transparent;
}

.fb-textarea {
  width: 100%;
  height: 240rpx;
  background: var(--sky-3);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 22rpx;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.6;
  box-sizing: border-box;
}
.fb-ph { color: var(--muted); }
.fb-count { text-align: right; font-size: 21rpx; color: var(--muted); margin-top: 10rpx; }

.fb-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.fb-img-cell,
.fb-img-add {
  width: 168rpx;
  height: 168rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}
.fb-img {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--sky-3);
}
.fb-img-mask {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 37, 71, 0.45);
  color: #fff;
  font-size: 22rpx;
}
.fb-img-fail { background: rgba(180, 60, 60, 0.55); }
/* 可见圆点仍 48rpx，热区靠透明 ::after 扩到 88rpx（44pt）。
   要点：父级 .fb-img-cell 是 overflow:hidden，**往外扩的部分会连同热区一起被裁掉**。
   元素本身距上/右各 6rpx，所以外侧最多只能扩 6rpx；再多写也不会生效——
   之前写 -20rpx，实际热区只有 6+48+20 = 74rpx（37pt），并没有到 44pt。
   改成不对称外扩：外侧 -6rpx（正好贴到 cell 边），内侧 -34rpx，
   合计 6+48+34 = 88rpx，整块都落在 cell 内。
   内侧只扩到刚好 88rpx 为止：缩略图本身绑了预览点击，删除区越大越容易误删。 */
.fb-img-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 30rpx;
  line-height: 48rpx;
  text-align: center;
}
.fb-img-del::after {
  content: "";
  position: absolute;
  /* 元素贴的是右上角：横向外侧是 right、内侧是 left；纵向外侧是 top、内侧是 bottom。
     所以外侧两条（right / top）各 -6rpx，内侧两条（left / bottom）各 -34rpx。 */
  left: -34rpx; top: -6rpx; right: -6rpx; bottom: -34rpx;
}
.fb-img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: var(--sky-3);
  border: 1rpx dashed var(--line);
}
.fb-img-add-plus {
  font-size: 44rpx;
  color: var(--muted);
  line-height: 1;
}
.fb-img-add-tip {
  font-size: 21rpx;
  color: var(--muted);
}

.fb-input {
  width: 100%;
  height: 88rpx;
  background: var(--sky-3);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.fb-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 26rpx 32rpx 0;
}
.fb-tip text { font-size: 22rpx; color: var(--sub); }
.fb-pad { height: 40rpx; }

.fb-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--line);
}
.fb-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #3F57B5, #2B356E);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
  box-shadow: 0 12rpx 30rpx rgba(43, 53, 110, 0.32);
}
.fb-submit::after { border: none; }
.fb-submit.ing { opacity: 0.7; }
