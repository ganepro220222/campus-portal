/* packageC/feedback/list.wxss */
.fb-list-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 页底：纸 + 淡纤维 */
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}
.fb-empty-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 12rpx;
  display: block;
}
.fb-list-scroll { flex: 1; min-height: 0; padding-top: 16rpx; }
.fb-row {
  margin: 0 28rpx 16rpx;
  padding: 24rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
}
.fb-row:active { background: var(--paper-2); }
.fb-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.fb-row-type {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--jin-70);
}
.fb-row-status {
  font-size: 22rpx;
  color: var(--muted);
}
.fb-row-status.on { color: var(--jin-60); font-weight: 600; }
.fb-row-content {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.fb-row-time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.fb-list-bottom { height: calc(140rpx + env(safe-area-inset-bottom)); }
.fb-list-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  /* 底栏是纸，不是白玻璃 */
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-top: 1rpx solid var(--line);
}
.fb-list-bar .fb-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  /* 主操作：朱砂漆钮，直角 12rpx */
  color: var(--paper-card);
  background: linear-gradient(180deg, var(--zhu-lit), var(--zhu) 52%, var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.30),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 4rpx 10rpx rgba(158,43,37,.28);
  border: none;
  border-radius: 12rpx;
}
.fb-list-bar .fb-submit:active { opacity: 0.88; }
