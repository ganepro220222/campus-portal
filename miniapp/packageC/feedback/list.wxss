/* packageC/feedback/list.wxss */
.fb-list-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F8FC;
}
.fb-empty-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 12rpx;
  display: block;
}
.fb-list-scroll { flex: 1; min-height: 0; padding-top: 16rpx; }
.fb-row {
  margin: 0 28rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
}
.fb-row:active { background: var(--sky-3); }
.fb-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.fb-row-type {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--navy);
}
.fb-row-status {
  font-size: 22rpx;
  color: var(--muted);
}
.fb-row-status.on { color: #BE9C44; font-weight: 600; }
.fb-row-content {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.fb-row-time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.fb-list-bottom { height: calc(140rpx + env(safe-area-inset-bottom)); }
.fb-list-bar {
  flex-shrink: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
}
.fb-list-bar .fb-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #3F57B5, #2B356E);
  border: none;
  border-radius: 44rpx;
}
.fb-list-bar .fb-submit:active { opacity: 0.88; }
