/* packageC/message/index.wxss */
.msg-page {
  height: 100vh;
  background: var(--paper);
  display: flex;
  flex-direction: column;
}
.msg-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.msg-state { padding: 80rpx; text-align: center; color: var(--muted); }
.msg-empty-sub { font-size: 24rpx; color: var(--muted); margin-top: 12rpx; display: block; }

.msg-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx 8rpx;
}
.msg-unread-tip { font-size: 24rpx; color: var(--muted); }
.msg-read-all { font-size: 24rpx; color: var(--jin-70); font-weight: 600; }

.msg-scroll { flex: 1; min-height: 0; }
.msg-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 0 28rpx 16rpx;
  padding: 24rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
}
/* 未读：左沿一道朱 + 杏纸底。朱在这套里只做标记位，"没看过"正是要标的那件事。
   原来是写死的 #D6E4F8 冷蓝描边 + #FAFCFF 冷白底，翻成纸面之后几乎看不出差别。 */
.msg-item.unread {
  border-color: var(--xing-30);
  background: var(--xing-05);
  box-shadow: inset 4rpx 0 0 var(--zhu);
}
.msg-item:active { background: var(--paper-2); }
.msg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--jin-60);
  flex-shrink: 0;
  margin-top: 10rpx;
}
.msg-body { flex: 1; min-width: 0; }
.msg-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
}
.msg-content {
  font-size: 25rpx;
  color: var(--sub);
  line-height: 1.6;
  margin-top: 10rpx;
  display: block;
  white-space: pre-wrap;
}
.msg-time {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 12rpx;
  display: block;
}
.msg-bottom { height: calc(40rpx + env(safe-area-inset-bottom)); }
