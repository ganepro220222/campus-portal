<!-- packageC/profile/edit.wxml — 个人资料编辑 -->
<view class="pe-page">
  <nav-bar title="个人资料" />
  <view wx:if="{{loading}}" class="pe-state">
    <text>加载中…</text>
  </view>

  <block wx:else>
    <scroll-view scroll-y class="pe-scroll" enhanced show-scrollbar="{{false}}">
      <view class="pe-card">
        <view class="pe-hint">完善资料后，活动报名将自动预填姓名与手机号。</view>

        <view class="pe-label">昵称</view>
        <input
          class="pe-input"
          placeholder="展示名称，选填"
          value="{{form.nickname}}"
          bindinput="onInput"
          data-field="nickname"
          maxlength="32"
        />

        <view class="pe-label">真实姓名<text class="req">*</text></view>
        <input
          class="pe-input"
          placeholder="请输入真实姓名"
          value="{{form.realName}}"
          bindinput="onInput"
          data-field="realName"
          maxlength="32"
        />

        <view class="pe-label">手机号<text class="req">*</text></view>
        <input
          class="pe-input"
          type="number"
          maxlength="11"
          placeholder="11 位手机号"
          value="{{form.phone}}"
          bindinput="onInput"
          data-field="phone"
        />

        <view class="pe-label">学院</view>
        <input
          class="pe-input"
          placeholder="选填"
          value="{{form.college}}"
          bindinput="onInput"
          data-field="college"
          maxlength="64"
        />

        <view class="pe-label">年级</view>
        <input
          class="pe-input"
          placeholder="选填，如 2024 级"
          value="{{form.grade}}"
          bindinput="onInput"
          data-field="grade"
          maxlength="16"
        />
      </view>
      <view class="pe-pad"></view>
    </scroll-view>

    <view class="pe-bar">
      <button class="pe-submit {{submitting ? 'ing' : ''}}" bindtap="onSubmit" disabled="{{submitting}}">
        {{submitting ? '保存中…' : '保存'}}
      </button>
    </view>
  </block>
</view>
