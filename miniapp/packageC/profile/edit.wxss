/* packageC/profile/edit.wxss */
.pe-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.pe-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: var(--muted);
  font-size: 28rpx;
}
.pe-retry {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--sky);
}
.pe-scroll { flex: 1; overflow: hidden; padding: 24rpx 0 0; }

.pe-card {
  margin: 0 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
}
.pe-hint {
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  background: var(--sky-3);
  border-radius: 16rpx;
}
.pe-label { font-size: 27rpx; font-weight: 600; color: var(--ink); margin-bottom: 14rpx; }
.pe-label:not(:first-of-type) { margin-top: 26rpx; }
.req { color: var(--color-danger); margin-left: 4rpx; }

.pe-input {
  width: 100%;
  height: 84rpx;
  background: var(--sky-3);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 0 22rpx;
  font-size: 27rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.pe-pad { height: 40rpx; }
.pe-bar {
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
}
.pe-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--blue), var(--navy));
  color: var(--card);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  border: none;
  box-shadow: 0 12rpx 30rpx rgba(96,78,44, 0.32);
}
.pe-submit::after { border: none; }
.pe-submit.ing { opacity: 0.7; }
