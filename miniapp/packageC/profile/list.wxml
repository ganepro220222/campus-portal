<!-- packageC/profile/list.wxml — 个人中心子列表（收藏/报名/下载/足迹/徽章） -->
<view class="pl-page">
  <nav-bar title="{{navTitle}}" />
  <view wx:if="{{loading}}" class="pl-state"><text>加载中…</text></view>

  <view wx:elif="{{error && isEmpty}}" class="empty-state">
    <icon name="{{typeIcon}}" size="42" color="#C3CCE0" />
    <text>加载失败，请重试</text>
    <view class="pl-retry" bindtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{isEmpty}}" class="empty-state">
    <icon name="{{typeIcon}}" size="42" color="#C3CCE0" />
    <text>{{emptyText}}</text>
  </view>

  <!-- 学习足迹：按日期分组时间轴 -->
  <view wx:elif="{{type === 'footprints'}}" class="fp-timeline">
    <view wx:for="{{timelineGroups}}" wx:key="dateKey" class="fp-day">
      <view class="fp-day-head">
        <view class="fp-day-dot"></view>
        <text class="fp-day-label">{{item.dateLabel}}</text>
      </view>
      <view class="fp-day-list">
        <view
          wx:for="{{item.items}}"
          wx:for-item="fp"
          wx:key="id"
          class="fp-item"
          bindtap="onItemTap"
          data-route="{{fp.route}}"
        >
          <view class="fp-rail">
            <view class="fp-rail-line"></view>
            <view class="fp-rail-dot"></view>
          </view>
          <view class="fp-card">
            <view class="fp-card-top">
              <text class="fp-time">{{fp.timeLabel}}</text>
              <text class="fp-tag">{{fp.eventLabel}}</text>
            </view>
            <text class="fp-title">{{fp.title}}</text>
            <text wx:if="{{fp.targetTypeLabel}}" class="fp-sub">{{fp.targetTypeLabel}}</text>
          </view>
          <icon wx:if="{{fp.route}}" class="fp-arrow" name="chevron-right" size="16" color="#C3CCE0" />
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="pl-list">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="pl-item"
      bindtap="onItemTap"
      data-route="{{item.route}}"
    >
      <view class="pl-ic {{typeCls}} {{type === 'badges' && !item.earned ? 'pl-ic-off' : ''}}">
        <icon name="{{typeIcon}}" size="22" color="#ffffff" />
      </view>

      <view class="pl-body">
        <text class="pl-title">{{item.title || item.name || item.fileName}}</text>
        <text wx:if="{{item.subtitle}}" class="pl-sub">{{item.subtitle}}</text>
        <text wx:if="{{item.eventLabel}}" class="pl-sub">{{item.eventLabel}} · {{item.targetTypeLabel || item.targetType}}</text>
        <text wx:if="{{item.description && type === 'badges'}}" class="pl-sub">{{item.description}}</text>
        <text wx:if="{{item.createTime || item.downloadedAt || item.achievedAt}}" class="pl-time">{{item.createTime || item.downloadedAt || item.achievedAt}}</text>
      </view>

      <view class="pl-right">
        <view
          wx:if="{{type === 'downloads' && item.canRedownload}}"
          class="pl-redownload {{redownloadingId === item.resourceId ? 'is-loading' : ''}}"
          catchtap="onRedownload"
          data-id="{{item.resourceId}}"
        >{{redownloadingId === item.resourceId ? '下载中' : '再次下载'}}</view>
        <view wx:if="{{item.statusLabel}}" class="pl-status st-{{item.statusClass}}">{{item.statusLabel}}</view>
        <view wx:elif="{{type === 'badges'}}" class="pl-badge {{item.earned ? 'on' : ''}}">{{item.earned ? '已获得' : '未获得'}}</view>
        <icon wx:elif="{{item.route}}" name="chevron-right" size="16" color="#C3CCE0" />
      </view>
    </view>
  </view>

  <view class="pl-bottom"></view>
</view>
