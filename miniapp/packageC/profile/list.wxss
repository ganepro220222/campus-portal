/* packageC/profile/list.wxss */
.pl-page { min-height: 100vh; background: linear-gradient(180deg, #EAF1FB 0, #F5F8FC 220rpx); }
.pl-state { padding: 100rpx 40rpx; text-align: center; color: var(--muted); font-size: 28rpx; }

.pl-retry {
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 16rpx 40rpx;
  border-radius: 28rpx;
}
.pl-retry:active { background: var(--sky-3); }

.pl-list { padding: 24rpx 28rpx 0; }
.pl-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-sm);
}
.pl-item:active { background: var(--sky-3); }

.pl-ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(31, 40, 90, 0.16);
}
.tc-rose { background: linear-gradient(135deg, #C0607A, #8E3B52); }
.tc-blue { background: linear-gradient(135deg, #3F57B5, #2B356E); }
.tc-green { background: linear-gradient(135deg, #3F9A6B, #2E7C55); }
.tc-slate { background: linear-gradient(135deg, #5A6488, #39406A); }
.tc-gold { background: linear-gradient(135deg, #CDA94E, #B58A2F); }
.pl-ic-off { background: #C3CCE0; box-shadow: none; }

.pl-body { flex: 1; min-width: 0; }
.pl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pl-sub {
  font-size: 23rpx;
  color: var(--sub);
  margin-top: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pl-time { font-size: 21rpx; color: var(--muted); margin-top: 10rpx; display: block; }

.pl-right { flex-shrink: 0; display: flex; align-items: center; }
.pl-status {
  font-size: 21rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}
.st-pending { color: #9C7C2E; background: #FBF3DD; }
.st-approved { color: var(--navy); background: var(--sky-2); }
.st-rejected { color: #C0392B; background: rgba(192, 57, 43, 0.10); }

.pl-badge {
  font-size: 21rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: #EEF1F8;
  color: var(--muted);
}
.pl-badge.on { background: rgba(201, 162, 39, 0.15); color: #C9A227; }

/* 文案在「再次下载」(4 字 = 88rpx) 与「下载中」(3 字 = 66rpx) 之间切换，
   而 .pl-right 是 flex-shrink:0、.pl-body 是 flex:1——不锁宽的话点一下芯片缩 22rpx，
   左边两行截断的标题跟着重排，看起来就是「抖了一下」。按长的那个态定死下限。 */
.pl-redownload {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 10rpx 20rpx;
  border-radius: 22rpx;
  white-space: nowrap;
  box-sizing: border-box;
  min-width: 128rpx;
  text-align: center;
}
.pl-redownload.is-loading {
  opacity: 0.65;
}
.pl-redownload:active {
  background: var(--sky-3);
}

.pl-bottom { height: calc(40rpx + env(safe-area-inset-bottom)); }

/* 学习足迹时间轴 */
.fp-timeline {
  padding: 24rpx 28rpx 0;
}
.fp-day {
  margin-bottom: 12rpx;
}
.fp-day-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}
.fp-day-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3F57B5, #2B356E);
  box-shadow: 0 0 0 6rpx rgba(63, 87, 181, 0.15);
  flex-shrink: 0;
}
.fp-day-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.fp-day-list {
  margin-left: 16rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(63, 87, 181, 0.18);
}
.fp-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.fp-item:active .fp-card {
  background: var(--sky-3);
}
.fp-rail {
  width: 24rpx;
  position: relative;
  flex-shrink: 0;
}
.fp-rail-line {
  display: none;
}
.fp-rail-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #C3CCE0;
  position: absolute;
  left: -31rpx;
  top: 28rpx;
}
.fp-card {
  flex: 1;
  min-width: 0;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  box-shadow: var(--shadow-sm);
}
.fp-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.fp-time {
  font-size: 22rpx;
  color: var(--muted);
}
.fp-tag {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.fp-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
}
.fp-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--sub);
}
.fp-arrow {
  align-self: center;
  flex-shrink: 0;
  margin-right: 4rpx;
}
