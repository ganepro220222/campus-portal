/* packageC/profile/list.wxss */
.pl-page { min-height: 100vh; background: linear-gradient(180deg, var(--sky-2) 0, var(--paper) 220rpx); }
.pl-state { padding: 100rpx 40rpx; text-align: center; color: var(--muted); font-size: 28rpx; }

.pl-retry {
  margin-top: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 16rpx 40rpx;
  border-radius: 28rpx;
}
/* 全仓 19 处可点面的按下反馈里，17 处是变深（.res-dl、.fav-icon、.chip、.legal-retry…），
   只有本文件这两处用 --sky-3 变浅，按下去像是「弹起来」而不是「按下去」。
   静息同为 --sky-2，按深一档到 --sky，与 .res-dl / .fav-icon 完全对齐。 */
.pl-retry:active { background: var(--sky); }

.pl-refresh-bar {
  margin: 16rpx 28rpx 0;
  padding: 20rpx 24rpx;
  /* 原来这三处走的是旧调色板的危险红，换成本套的朱 */
  background: rgba(158, 43, 37, 0.08);
  border: 1rpx solid rgba(158, 43, 37, 0.18);
  border-radius: 12rpx;
  text-align: center;
}
.pl-refresh-bar:active { background: rgba(158, 43, 37, 0.12); }
.pl-refresh-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-danger);
}

.pl-list { padding: 24rpx 28rpx 0; }
.pl-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-sm);
}
.pl-item:active { background: var(--paper-2); }

/* ── 行首的器物 ──
   原来是五种彩色圆角方块（玫红 / 蓝 / 绿 / 灰蓝 / 金），按列表类型换色。
   可一页只有一种类型，那个色在页内不区分任何东西——它只是把十几行
   排成一列的彩块，而且玫红、绿、灰蓝三支根本不在这套配色里。
   统一成纸钮 + 一圈金线，和「我的」菜单、nav-bar 的返回键同一族。 */
.pl-ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(252, 250, 244, 0.8);
  box-shadow: 0 2rpx 8rpx rgba(96, 78, 44, 0.16),
              inset 0 0 0 2rpx rgba(150, 120, 66, 0.26);
}
/* 未获得的徽章：钮还在，只是褪成纸色、没有金圈，一眼看出是"空着的" */
.pl-ic-off {
  background: var(--paper-2);
  box-shadow: inset 0 0 0 2rpx rgba(150, 120, 66, 0.12);
}

.pl-body { flex: 1; min-width: 0; }
.pl-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pl-sub {
  font-size: 23rpx;
  color: var(--sub);
  margin-top: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pl-time { font-size: 21rpx; color: var(--muted); margin-top: 10rpx; display: block; }

.pl-right { flex-shrink: 0; display: flex; align-items: center; }
/* 状态与徽章都走小签（同 app.wxss 的 .pill）：直角、纸底、细框。
   原来是全圆角芯片，且「通过」用绢青底、「驳回」用旧危险红、
   「未获得」用 #EEF1F8 的冷蓝白 —— 一行里三种不搭的底色。
   现在只换字色和框色，底纸不换：底纸一换就又变回色块了。 */
.pl-status,
.pl-badge {
  font-size: 21rpx;
  padding: 8rpx 16rpx;
  border-radius: 4rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
}
/* 三档状态只用这套自己的颜色，不另起一支绿。
   「已通过」本来用 --color-success（石绿 #3F7A5E）—— 那是我当初为功能色
   自己配的，在页底纸上量到 4.89 够用，可小签的底是一道渐变，
   到下沿那一档只剩 **4.33**，21rpx 的小字过不了 4.5。
   而且它是全仓**唯一**一处拿这个令牌当文字色的地方，没有历史包袱。

   改成按这套自己的逻辑分三档：
     待审核 → 素签（默认那一档，什么都不覆写）——"还在等"，不需要标记
     已通过 → 金签（字与框都上金）——标记了，但安静
     已驳回 → 朱签 —— 朱是全站唯一的高饱和色，留给"这一件要紧"
   三档靠"有没有上色的框"分得开，文字本身也写着状态。量过 4.93~6.37。 */
.st-approved { color: var(--jin-70); border-color: rgba(158,125,69,.34); }
.st-rejected { color: var(--zhu);    border-color: rgba(158,43,37,.34); }
.pl-badge.on { color: var(--jin-70); border-color: rgba(158,125,69,.34); }

/* 文案在「再次下载」(4 字 = 88rpx) 与「下载中」(3 字 = 66rpx) 之间切换，
   而 .pl-right 是 flex-shrink:0、.pl-body 是 flex:1——不锁宽的话点一下芯片缩 22rpx，
   左边两行截断的标题跟着重排，看起来就是「抖了一下」。按长的那个态定死下限。 */
.pl-redownload {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 10rpx 20rpx;
  border-radius: 22rpx;
  white-space: nowrap;
  box-sizing: border-box;
  min-width: 128rpx;
  text-align: center;
}
.pl-redownload.is-loading {
  opacity: 0.65;
}
.pl-redownload:active {
  background: var(--sky);
}

.pl-bottom { height: calc(40rpx + env(safe-area-inset-bottom)); }

/* 学习足迹时间轴 */
.fp-timeline {
  padding: 24rpx 28rpx 0;
}
.fp-day {
  margin-bottom: 12rpx;
}
.fp-day-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}
.fp-day-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--zhu);
  box-shadow: 0 0 0 6rpx rgba(158,43,37, 0.12);
  flex-shrink: 0;
}
.fp-day-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.fp-day-list {
  margin-left: 16rpx;
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(158,125,69, 0.18);
}
.fp-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.fp-item:active .fp-card {
  background: var(--sky-3);
}
.fp-rail {
  width: 24rpx;
  position: relative;
  flex-shrink: 0;
}
.fp-rail-line {
  display: none;
}
.fp-rail-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--ghost);
  position: absolute;
  left: -31rpx;
  top: 28rpx;
}
.fp-card {
  flex: 1;
  min-width: 0;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  box-shadow: var(--shadow-sm);
}
.fp-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.fp-time {
  font-size: 22rpx;
  color: var(--muted);
}
.fp-tag {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--navy);
  background: var(--sky-2);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.fp-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
}
.fp-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--sub);
}
.fp-arrow {
  align-self: center;
  flex-shrink: 0;
  margin-right: 4rpx;
}
