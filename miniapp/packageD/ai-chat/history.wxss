/* packageD/ai-chat/history.wxss */
.history-page {
  min-height: 100vh;
  /* 页顶原来是一道 --sky-2 的淡绿往下褪成纸，旧稿的"顶部有色"套路 */
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}

.history-state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
}

.empty-state {
  padding: 120rpx 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.empty-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.empty-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.6;
}

.history-list {
  padding: 24rpx 28rpx 0;
}
.history-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-sm);
}
.history-item:active {
  background: var(--paper-2);
}
.history-ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  /* 纸钮 + 金线，同「我的」页菜单与 .fav-icon。
     原来是 blue→navy 的渐变方块，一列下来是一排一模一样的深色方块。 */
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  box-shadow: inset 0 0 0 1rpx rgba(198,158,98,.45), inset 0 2rpx 0 rgba(255,252,244,.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.history-body {
  flex: 1;
  min-width: 0;
}
.history-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.history-foot {
  padding: 8rpx 28rpx 0;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  /* 主操作：朱砂漆钮，直角 12rpx */
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--paper-card);
  background: linear-gradient(180deg, var(--zhu-lit), var(--zhu) 52%, var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.30),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 4rpx 10rpx rgba(158,43,37,.28);
  border: none;
  margin-top: 36rpx;
}
.btn-primary::after { border: none; }

.btn-outline {
  width: 100%;
  height: 88rpx;
  /* 次操作：素钮 */
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--jin-70);
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  border: 1rpx solid var(--line);
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9);
}
.btn-outline::after { border: none; }

.history-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
