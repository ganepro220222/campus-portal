/* packageD/ai-chat/index.wxss */
.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 页顶原来是一道 --sky-2 的淡绿往下褪成纸，那是旧稿的"顶部有色"套路。
     改成纸 + 淡纤维，顶上那点层次交给下面的玉牌与文字。 */
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}
.chat-body { flex: 1; overflow: hidden; padding: 0 28rpx; }

/* 顶部介绍 */
.chat-intro { display: flex; flex-direction: column; align-items: center; padding: 34rpx 0 28rpx; }
/* 玉牌自带金箍，不再画圆底——再压一层会把箍盖住（和 .ai-fab 同理） */
.ci-avatar {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 30rpx rgba(96,78,44, 0.32);
}
.ci-avatar-img { width: 112rpx; height: 112rpx; display: block; }
.ci-name { font-size: 34rpx; font-weight: 700; color: var(--ink); margin-top: 18rpx; }
.ci-desc { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.ci-history {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--jin-70);
  padding: 10rpx 24rpx;
  /* 素钮：直角、纸面压一道、顶上一条受光白线。原来是半透明白 + --sky 描边 */
  border-radius: 10rpx;
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
  border: 1rpx solid var(--line);
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9);
}
.ci-history:active { opacity: 0.85; }

/* 消息 */
.row { display: flex; align-items: flex-end; gap: 14rpx; margin-bottom: 24rpx; }
.row.me { flex-direction: row-reverse; }
.avt {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.avt-img { width: 56rpx; height: 56rpx; display: block; }
.bubble {
  max-width: 74%;
  font-size: 27rpx;
  line-height: 1.7;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  word-break: break-word;
}
.bubble.ai {
  background: var(--paper-card);
  color: var(--ink);
  border: 1rpx solid var(--line);
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--shadow-sm);
}
.bubble.me {
  /* 自己说的话：杏色纸。原来是 blue→navy 的深色渐变块，
     一屏里每句都是一坨深色，把对面 AI 的纸白全压住了。
     杏纸是这套里"功能卡的暖沙底"，正好和左边的白纸分得开又不抢。 */
  background-color: var(--xing-10);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  color: var(--ink);
  border: 1rpx solid var(--xing-30);
  border-bottom-right-radius: 8rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,252,244,.8), var(--shadow-sm);
}

/* 快捷问题 */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 4rpx 0 10rpx 70rpx; }
.chip {
  font-size: 24rpx;
  color: var(--jin-70);
  /* 快捷问题是可点的小签：直角 8rpx、纸底、细框、一道受光白线。
     原来是 30rpx 全圆胶囊 + --sky 描边。 */
  background: linear-gradient(180deg, rgba(255,252,244,.95), rgba(234,226,208,.6));
  border: 1rpx solid var(--line);
  padding: 14rpx 24rpx;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8), var(--shadow-sm);
}
.chip:active {
  background: linear-gradient(180deg, var(--paper-2), var(--paper-3));
  box-shadow: inset 0 2rpx 4rpx rgba(74,50,30,.14);
}
.chat-pad { height: 20rpx; }

/* 底栏：输入区 + AI 生成标识 */
.chat-foot {
  flex-shrink: 0;
  /* 底栏是纸，不是白玻璃 */
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-top: 1rpx solid var(--line);
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
}
.chat-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx 0;
}
.ai-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--muted);
  padding: 10rpx 28rpx 0;
}
.ci-in {
  flex: 1;
  height: 76rpx;
  /* 输入面凹进纸里；圆角收到 14rpx，不再是一颗 38rpx 的全圆药丸 */
  background: var(--paper-sunk);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(74,50,30,.10);
  padding: 0 26rpx;
  font-size: 27rpx;
  color: var(--ink);
}
.ci-ph { color: var(--muted); }
/* 和抽屉里那枚一样：平涂的朱，主操作用点缀色 */
.send {
  width: 76rpx; height: 76rpx;
  border-radius: 50%;
  background: var(--zhu);
  box-shadow: 0 6rpx 16rpx rgba(110,30,26,.28),
              inset 0 2rpx 0 rgba(255,236,232,.30),
              inset 0 -3rpx 6rpx rgba(70,16,14,.26);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.send:active { transform: translateY(2rpx); box-shadow: 0 2rpx 6rpx rgba(110,30,26,.30); }
