/* packageD/ai-chat/index.wxss */
.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, var(--sky-2) 0, var(--paper) 320rpx);
}
.chat-body { flex: 1; overflow: hidden; padding: 0 28rpx; }

/* 顶部介绍 */
.chat-intro { display: flex; flex-direction: column; align-items: center; padding: 34rpx 0 28rpx; }
/* 玉牌自带金箍，不再画圆底——再压一层会把箍盖住（和 .ai-fab 同理） */
.ci-avatar {
  width: 112rpx; height: 112rpx;
  border-radius: 50%;
  box-shadow: 0 12rpx 30rpx rgba(96,78,44, 0.32);
}
.ci-avatar-img { width: 112rpx; height: 112rpx; display: block; }
.ci-name { font-size: 34rpx; font-weight: 700; color: var(--ink); margin-top: 18rpx; }
.ci-desc { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }
.ci-history {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--navy);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid var(--sky);
}
.ci-history:active { opacity: 0.85; }

/* 消息 */
.row { display: flex; align-items: flex-end; gap: 14rpx; margin-bottom: 24rpx; }
.row.me { flex-direction: row-reverse; }
.avt {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.avt-img { width: 56rpx; height: 56rpx; display: block; }
.bubble {
  max-width: 74%;
  font-size: 27rpx;
  line-height: 1.7;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  word-break: break-word;
}
.bubble.ai {
  background: var(--card);
  color: var(--ink);
  border: 1rpx solid var(--line);
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--shadow-sm);
}
.bubble.me {
  background: linear-gradient(135deg, var(--blue), var(--navy));
  color: var(--card);
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(96,78,44, 0.28);
}

/* 快捷问题 */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin: 4rpx 0 10rpx 70rpx; }
.chip {
  font-size: 24rpx;
  color: var(--navy);
  background: var(--card);
  border: 1rpx solid var(--sky);
  padding: 14rpx 24rpx;
  border-radius: 30rpx;
  box-shadow: var(--shadow-sm);
}
.chip:active { background: var(--sky-2); }
.chat-pad { height: 20rpx; }

/* 底栏：输入区 + AI 生成标识 */
.chat-foot {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(16rpx);
  border-top: 1rpx solid var(--line);
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
}
.chat-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx 0;
}
.ai-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--muted);
  padding: 10rpx 28rpx 0;
}
.ci-in {
  flex: 1;
  height: 76rpx;
  background: var(--sky-3);
  border: 1rpx solid var(--line);
  border-radius: 38rpx;
  padding: 0 26rpx;
  font-size: 27rpx;
  color: var(--ink);
}
.ci-ph { color: var(--muted); }
/* 和抽屉里那枚一样：平涂的朱，主操作用点缀色 */
.send {
  width: 76rpx; height: 76rpx;
  border-radius: 50%;
  background: var(--zhu);
  box-shadow: 0 6rpx 16rpx rgba(110,30,26,.28),
              inset 0 2rpx 0 rgba(255,236,232,.30),
              inset 0 -3rpx 6rpx rgba(70,16,14,.26);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.send:active { transform: translateY(2rpx); box-shadow: 0 2rpx 6rpx rgba(110,30,26,.30); }
