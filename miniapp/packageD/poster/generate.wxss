/* packageD/poster/generate.wxss */
/* 页底原来是写死的 #EAEEF6 冷蓝灰——海报本身是深色的，底色只是个托盘，
   托盘换成纸，海报浮在纸上，和全站一致。
   注意：海报**里面**的四套模板（青瓦/墨色/朱韵/鎏金）本就是这套调色板，
   它是要存下来分享出去的一张图，不跟着页面翻浅。 */
.poster-page {
  height: 100vh; display: flex; flex-direction: column;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}
.poster-scroll { flex: 1; overflow: hidden; }

/* 预览 */
.preview { display: flex; justify-content: center; padding: 32rpx 0 8rpx; }
.poster {
  position: relative;
  width: 480rpx;
  height: 800rpx;
  border-radius: 24rpx;
  overflow: hidden;
  /* 投影改暖：原来是 rgba(20,26,56,.4) 的冷蓝灰，压在纸上会发灰 */
  box-shadow: 0 24rpx 60rpx rgba(74, 50, 30, 0.34);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
}
.p-frame {
  position: absolute;
  left: 20rpx; top: 20rpx; right: 20rpx; bottom: 20rpx;
  border: 1rpx solid;
  border-radius: 16rpx;
  opacity: 0.55;
  pointer-events: none;
}
.p-top {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  z-index: 2;
}
/* 方印配方牌：与登录页/关于页同一套语言，圆角比 0.226。海报尺寸小，不再加外框 */
.p-seal {
  width: 150rpx; height: 150rpx;
  border-radius: 34rpx;
  background: var(--paper-card);
  margin-top: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
/* 方牌不再受「内接圆」约束，占比统一到 0.70：105 / 1.122 = 94 */
.p-seal-img { width: 105rpx; height: 94rpx; }

.p-cover {
  position: relative;
  width: 360rpx;
  height: 204rpx;
  border-radius: 18rpx;
  overflow: hidden;
  margin-top: 36rpx;
  background: rgba(255, 255, 255, 0.12);
  z-index: 2;
}
.p-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.p-cover-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 19rpx;
  background: var(--paper-card);
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-cover-badge-img {
  width: 59rpx;
  height: 53rpx;
}

/* 画布那边是 lines.slice(0, 3)，预览不设上限的话，长标题会在预览里排到第四行、
   把底部二维码那一行挤出 800rpx 之外（.poster 是 overflow:hidden，直接被切掉），
   而存下来的图却只有三行——预览即成品就不成立了。这里跟画布对齐，同样封顶 3 行。 */
.p-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--paper-card);
  text-align: center;
  line-height: 1.4;
  margin-top: 54rpx;
  z-index: 2;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.p-title-cover {
  margin-top: 36rpx;
}
/* 逐行渲染时每行自成一个块，行高沿用 .p-title 的 1.4，与整串折行的观感一致 */
.p-title-ln { display: block; }
/* 线 — ❖ — 线，与登录页 .brand-div 同一套语言。
   旧版是一条通长的线加一个绝对定位的 ❖ 压在上面，两者重叠成一团；
   现在两段线各自朝外淡出，中间给菱形让出空隙。
   尺寸按海报宽 480rpx / 登录页 750rpx = 0.64 等比缩下来：
   线 92→58、间距 20→13、字号 22→14；字号取 18rpx 是因为 14rpx 在海报上几乎看不见，
   合计 58+14+18+14+58 = 162rpx，与旧版 160rpx 的占位基本一致，不影响上下留白。 */
.p-div {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 26rpx;
  z-index: 2;
}
.p-line { width: 58rpx; height: 1rpx; flex-shrink: 0; }
.p-orn { font-size: 18rpx; line-height: 1; }
.p-sub {
  font-size: 22rpx;
  color: rgba(232, 240, 252, 0.9);
  letter-spacing: 2rpx;
  margin-top: 18rpx;
  z-index: 2;
}
.p-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  z-index: 2;
}
.p-qr {
  position: relative;
  width: 96rpx; height: 96rpx;
  background: var(--paper-card);
  border-radius: 12rpx;
  flex-shrink: 0;
}
.p-qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(96,78,44, 0.35);
  background: rgba(255, 255, 255, 0.92);
}
/* 两行同色：第二行原来是 #A9B2C8，在白底占位板上只有 2.3:1，看不清；
   调到 --muted 的 var(--muted)（4.91:1）后与第一行同色，.p-qr-sub 也就没有存在意义了，
   一并删掉——留着一条不起作用的规则，下次很容易被人"顺手调浅一点"再破坏对比度。
   两行的层级靠行序与内容区分即可，这块只是保存前的占位板。

   框内可用宽 94rpx（96 减 1rpx 边框×2）。汉字advance 恒为 1em，
   两行分别是 4×17=68rpx 与 5×17=85rpx，都留有余量，所以 nowrap 是安全的——
   不禁止折行反而会被挤成三四行顶破 96rpx 的方框。 */
.p-qr-hint {
  font-size: 17rpx;
  line-height: 1.4;
  text-align: center;
  color: var(--muted);
  white-space: nowrap;
}
.p-foot-tx { display: flex; flex-direction: column; gap: 6rpx; }
.pf-1 { font-size: 22rpx; color: var(--paper-card); font-weight: 600; }
.pf-2 { font-size: 19rpx; color: rgba(232, 240, 252, 0.75); }

/* 模板选择 */
.tpl-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 24rpx 32rpx 6rpx;
}
.tpls { display: flex; gap: 22rpx; padding: 14rpx 32rpx 0; }
.tpl { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.tpl-sw {
  width: 120rpx; height: 150rpx;
  border-radius: 16rpx;
  position: relative;
  border: 3rpx solid transparent;
  box-shadow: 0 6rpx 16rpx rgba(74,50,30, 0.18);
}
/* 选中态走朱——朱在这套里只做标记位。原来是 --navy（棕金），
   和模板色板里的「鎏金」那一张撞在一起，分不出哪张被选中 */
.tpl-on .tpl-sw { border-color: var(--zhu); }
.tpl-check {
  position: absolute;
  right: 8rpx; top: 8rpx;
  width: 34rpx; height: 34rpx;
  border-radius: 50%;
  background: var(--zhu);
  display: flex;
  align-items: center;
  justify-content: center;
}
.tpl-name { font-size: 23rpx; color: var(--sub); }
.tpl-on .tpl-name { color: var(--zhu); font-weight: 600; }

.poster-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 28rpx 32rpx 0;
  padding: 18rpx 22rpx;
  background: var(--xing-05);
  border-radius: 16rpx;
}
.poster-tip text { font-size: 22rpx; color: var(--jin-70); }

.poster-bottom { height: calc(160rpx + env(safe-area-inset-bottom)); }

/* 保存条 */
.save-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  /* 底栏是纸，不是白玻璃 */
  background-color: var(--paper-card);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
  border-top: 1rpx solid var(--line);
}
.save-btn {
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  /* 金钮，直角 12rpx——同展馆/文创详情的海报键，一个动作一个样子 */
  border-radius: 12rpx;
  background: linear-gradient(180deg, var(--jin-50), var(--jin-70));
  color: var(--paper-card);
  font-size: 31rpx;
  font-weight: 700;
  border: none;
  gap: 12rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,250,240,.35), 0 6rpx 18rpx rgba(126,97,52,.26);
}
.save-btn::after { border: none; }
.saving { opacity: 0.7; }

/* 离屏画布 */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 300px;
  height: 500px;
}
