/* packageD/poster/generate.wxss */
.poster-page { height: 100vh; display: flex; flex-direction: column; background: #EAEEF6; }
.poster-scroll { flex: 1; overflow: hidden; }

/* 预览 */
.preview { display: flex; justify-content: center; padding: 32rpx 0 8rpx; }
.poster {
  position: relative;
  width: 480rpx;
  height: 800rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 60rpx rgba(20, 26, 56, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
}
.p-frame {
  position: absolute;
  left: 20rpx; top: 20rpx; right: 20rpx; bottom: 20rpx;
  border: 1rpx solid;
  border-radius: 16rpx;
  opacity: 0.55;
  pointer-events: none;
}
.p-top {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 2rpx;
  z-index: 2;
}
.p-seal {
  width: 150rpx; height: 150rpx;
  border-radius: 50%;
  background: #fff;
  margin-top: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.p-seal-img { width: 118rpx; height: 118rpx; }

.p-cover {
  position: relative;
  width: 360rpx;
  height: 204rpx;
  border-radius: 18rpx;
  overflow: hidden;
  margin-top: 36rpx;
  background: rgba(255, 255, 255, 0.12);
  z-index: 2;
}
.p-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}
.p-cover-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-cover-badge-img {
  width: 62rpx;
  height: 62rpx;
}

/* 画布那边是 lines.slice(0, 3)，预览不设上限的话，长标题会在预览里排到第四行、
   把底部二维码那一行挤出 800rpx 之外（.poster 是 overflow:hidden，直接被切掉），
   而存下来的图却只有三行——预览即成品就不成立了。这里跟画布对齐，同样封顶 3 行。 */
.p-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  line-height: 1.4;
  margin-top: 54rpx;
  z-index: 2;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.25);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.p-title-cover {
  margin-top: 36rpx;
}
.p-div { position: relative; width: 160rpx; height: 24rpx; margin-top: 26rpx; z-index: 2; }
.p-line { position: absolute; left: 0; right: 0; top: 50%; height: 1rpx; }
.p-orn {
  position: absolute;
  left: 50%; top: 50%;
  transform: translate(-50%, -60%);
  font-size: 20rpx;
}
.p-sub {
  font-size: 22rpx;
  color: rgba(232, 240, 252, 0.9);
  letter-spacing: 2rpx;
  margin-top: 18rpx;
  z-index: 2;
}
.p-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  z-index: 2;
}
.p-qr {
  position: relative;
  width: 96rpx; height: 96rpx;
  background: #fff;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.p-qr-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(43, 53, 110, 0.35);
  background: rgba(255, 255, 255, 0.92);
}
/* 框内可用宽 94rpx（96 减 1rpx 边框×2）。汉字advance 恒为 1em，
   两行分别是 4×17=68rpx 与 5×17=85rpx，都留有余量，所以 nowrap 是安全的——
   不禁止折行反而会被挤成三四行顶破 96rpx 的方框。 */
.p-qr-hint {
  font-size: 17rpx;
  line-height: 1.4;
  text-align: center;
  color: #8A93B2;
  white-space: nowrap;
}
.p-qr-sub { color: #A9B2C8; }
.p-foot-tx { display: flex; flex-direction: column; gap: 6rpx; }
.pf-1 { font-size: 22rpx; color: #fff; font-weight: 600; }
.pf-2 { font-size: 19rpx; color: rgba(232, 240, 252, 0.75); }

/* 模板选择 */
.tpl-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 24rpx 32rpx 6rpx;
}
.tpls { display: flex; gap: 22rpx; padding: 14rpx 32rpx 0; }
.tpl { display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.tpl-sw {
  width: 120rpx; height: 150rpx;
  border-radius: 16rpx;
  position: relative;
  border: 3rpx solid transparent;
  box-shadow: 0 6rpx 16rpx rgba(31, 40, 90, 0.18);
}
.tpl-on .tpl-sw { border-color: var(--navy); }
.tpl-check {
  position: absolute;
  right: 8rpx; top: 8rpx;
  width: 34rpx; height: 34rpx;
  border-radius: 50%;
  background: var(--navy);
  display: flex;
  align-items: center;
  justify-content: center;
}
.tpl-name { font-size: 23rpx; color: var(--sub); }
.tpl-on .tpl-name { color: var(--navy); font-weight: 600; }

.poster-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 28rpx 32rpx 0;
  padding: 18rpx 22rpx;
  background: #FBF3DD;
  border-radius: 16rpx;
}
.poster-tip text { font-size: 22rpx; color: #9C7C2E; }

.poster-bottom { height: calc(160rpx + env(safe-area-inset-bottom)); }

/* 保存条 */
.save-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(16rpx);
  border-top: 1rpx solid var(--line);
}
.save-btn {
  width: 100%;
  box-sizing: border-box;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #CDA94E, #B58A2F);
  color: #fff;
  font-size: 31rpx;
  font-weight: 700;
  border: none;
  gap: 12rpx;
  box-shadow: 0 14rpx 34rpx rgba(150, 110, 30, 0.35);
}
.save-btn::after { border: none; }
.saving { opacity: 0.7; }

/* 离屏画布 */
.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 300px;
  height: 500px;
}
