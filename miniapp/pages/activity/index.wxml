<!-- pages/activity/index.wxml -->
<view class="act-page">
  <!-- 自绘顶栏：原先这页用的是原生导航栏，标题由微信客户端绘制，
       字号跟随「微信 → 我 → 设置 → 通用 → 字体大小」缩放，而栏高是固定的，
       字体调大时「活动报名」下缘会被切掉，页面样式无从干预。
       与同一流程的活动详情页（packageC/activity/detail）统一到 nav-bar 后，
       字号走 rpx，不再受该设置影响。 -->
  <nav-bar title="活动报名" />
  <view wx:if="{{loading && !activityList.length && !error}}" class="page-state-box">
    <text class="page-state-text">加载中…</text>
  </view>

  <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
    <text>列表刷新失败，点击重试</text>
  </view>

  <view class="act-wrap">
    <view
      wx:for="{{activityList}}"
      wx:key="id"
      class="acard"
      bindtap="onCardTap"
      data-id="{{item.id}}"
    >
      <view class="acard-cover {{item.colorClass}}">
        <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="acard-img" />
        <icon wx:else name="{{item.icon}}" size="34" color="rgba(255,255,255,0.9)" />
        <text class="acard-tag">{{item.tag}}</text>
      </view>
      <view class="acard-body">
        <view class="acard-title">{{item.title}}</view>
        <view class="acard-meta">
          <icon name="calendar" size="14" color="#8A93B2" />
          <text class="acard-mt">{{item.startTime}}</text>
        </view>
        <view class="acard-meta">
          <icon name="pin" size="14" color="#8A93B2" />
          <text class="acard-mt">{{item.location}}</text>
        </view>
        <view class="acard-foot">
          <view class="quota {{item.full ? 'quota-full' : ''}}">
            <block wx:if="{{item.quota > 0}}">{{item.enrolledCount}}/{{item.quota}} 人</block>
            <block wx:else>名额不限</block>
          </view>
          <view class="enroll-btn {{item.full ? 'enroll-off' : ''}}">{{item.full ? '已满' : '报名'}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{error && !loading && !activityList.length}}" class="page-state-box">
      <icon class="page-state-icon" name="alert" size="40" color="#C3CCE0" />
      <text class="page-state-text">加载失败，请检查网络后重试</text>
      <view class="page-state-action" bindtap="onRetry">重新加载</view>
    </view>

    <view wx:elif="{{!loading && !activityList.length && !error}}" class="empty-state">
      <icon name="entry-enroll" size="40" color="#C3CCE0" />
      <text>暂无活动</text>
    </view>

    <view class="safe-bottom"></view>
  </view>
</view>
