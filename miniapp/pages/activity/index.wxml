<!-- pages/activity/index.wxml -->
<view class="act-page">
  <!-- 自定义顶栏，标题字号不受微信「字体大小」影响 -->
  <nav-bar title="活动报名" />
  <view wx:if="{{loading && !activityList.length && !error}}" class="page-state-box">
    <text class="page-state-text">加载中…</text>
  </view>

  <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
    <text>列表刷新失败，点击重试</text>
  </view>

  <view class="act-wrap">
    <view
      wx:for="{{activityList}}"
      wx:key="id"
      class="acard"
      bindtap="onCardTap"
      data-id="{{item.id}}"
    >
      <!-- 封面也是裱起来的画心，和三张列表页同一套 -->
      <view class="acard-cover mount mount--sm">
        <view class="mount-art {{item.cover && !item.coverFailed ? 'has-cover' : ''}}">
          <image wx:if="{{item.cover && !item.coverFailed}}" class="mount-cover acard-img" src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" data-id="{{item.id}}" data-cover="{{item.cover}}" binderror="onCoverError" />
          <view wx:else class="thumb-blank"><icon name="{{item.icon}}" size="30" color="#856F4F" /></view>
          <view class="hc-plate hc-plate--tl acard-tag"><text class="hc-plate-tx">{{item.tag}}</text></view>
        </view>
      </view>
      <view class="acard-body">
        <view class="acard-title">{{item.title}}</view>
        <view class="acard-meta">
          <icon name="calendar" size="14" color="#6B6459" />
          <text class="acard-mt">{{item.startTime}}</text>
        </view>
        <view class="acard-meta">
          <icon name="pin" size="14" color="#6B6459" />
          <text class="acard-mt">{{item.location}}</text>
        </view>
        <view class="acard-foot">
          <view class="quota {{item.full ? 'quota-full' : ''}}">
            <block wx:if="{{item.quota > 0}}">{{item.enrolledCount}}/{{item.quota}} 人</block>
            <block wx:else>名额不限</block>
          </view>
          <view class="enroll-btn {{item.canEnroll ? '' : 'enroll-off'}}">{{item.enrollHint}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{error && !loading && !activityList.length}}" class="page-state-box">
      <icon class="page-state-icon" name="alert" size="40" color="#957C58" />
      <text class="page-state-text">加载失败，请检查网络后重试</text>
      <view class="page-state-action" bindtap="onRetry">重新加载</view>
    </view>

    <view wx:elif="{{!loading && !activityList.length && !error}}" class="empty-state">
      <icon name="entry-enroll" size="40" color="#957C58" />
      <text>暂无活动</text>
    </view>

    <view class="safe-bottom"></view>
  </view>
</view>
