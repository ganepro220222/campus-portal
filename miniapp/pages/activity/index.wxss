/* pages/activity/index.wxss — 活动报名（二级页）*/
/* 页底：纸 + 淡纤维，和三张 tab 列表页同一档 */
.act-page {
  min-height: 100vh;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}
.act-wrap { padding: 24rpx 32rpx; }

/* 卡片与三张列表页对齐：同样的圆角、内边距、暖投影 */
.acard {
  display: flex;
  gap: 22rpx;
  background: var(--paper-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 4rpx 14rpx rgba(74,50,30, 0.07);
  padding: 18rpx;
  margin-bottom: 22rpx;
  transition: transform 0.15s;
}
.acard:active { transform: scale(0.99); }
.acard-cover { flex-shrink: 0; width: 180rpx; }
.acard-cover .mount-art { height: 180rpx; }
.acard-img { width: 100%; height: 100%; }
/* 活动类型那一条原来是黑 28% 底 + 白字：整页只有它一块是纯黑的。
   改用封面上那方白牌（.hc-plate），挪到左上角、字号收小。 */
.acard-tag { padding: 4rpx 12rpx; }
.acard-tag .hc-plate-tx { font-size: 20rpx; letter-spacing: 1rpx; }
.acard-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.acard-title {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  font-family: "Noto Serif SC", serif;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.acard-meta { display: flex; align-items: center; gap: 8rpx; margin-top: 10rpx; }
.acard-mt {
  font-size: 22rpx;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.acard-foot {
  margin-top: auto;
  padding-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
/* 名额：一方素签（同 app.wxss 的 .pill），不再是绢青色块 */
.quota {
  font-size: 21rpx;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
}
.quota-full { color: var(--muted); }
/* 报名键：纸底；可报名时字框用朱（对比 5.82 / 6.63~7.67） */
.enroll-btn {
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
  color: var(--zhu);
  border: 1rpx solid rgba(158,43,37,.34);
  background: var(--zhu-soft);
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.55), 0 2rpx 4rpx rgba(74,50,30,.08);
}
.enroll-off {
  color: var(--ink-2);
  border-color: var(--line);
  background: linear-gradient(180deg, var(--wood-05), var(--paper-2));
}

.safe-bottom { height: calc(40rpx + env(safe-area-inset-bottom)); }

/* 全局 .page-refresh-bar 默认 28rpx 横向边距（对齐详情页栏距），本页内容栏距是 32rpx（.act-wrap），
   不覆写的话红条会比下方卡片各窄 4rpx，边缘对不齐。加根类提权，避免依赖样式表先后顺序。 */
.act-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
