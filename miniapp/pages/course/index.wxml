<!-- pages/course/index.wxml -->
<view class="course-page">

  <!-- 顶栏走公共满檐组件。fixed=false：本页是 flex 列 + 内层
       scroll-view，顶栏留在文档流里；搜索键进 action 槽，分类 chips 进 below 槽。 -->
  <nav-bar title="课程中心" back="{{false}}" fixed="{{false}}">
    <view slot="action" class="nav-search" bindtap="onSearch">
      <icon name="search" size="20" color="#23262E" />
    </view>
    <view slot="below">
      <scroll-view scroll-x class="cats" enhanced show-scrollbar="{{false}}">
        <view class="cats-inner">
          <view
            wx:for="{{cats}}"
            wx:key="*this"
            class="cat {{activeCat === index ? 'cat-on' : ''}}"
            data-index="{{index}}"
            bindtap="switchCat"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </nav-bar>

  <!-- 课程列表 -->
  <scroll-view scroll-y class="course-scroll" enhanced show-scrollbar="{{false}}">
    <skeleton show="{{loading && !courseList.length && !error}}" type="list" count="6" />

    <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
      <text>列表刷新失败，点击重试</text>
    </view>
    <view class="course-wrap">
      <view
        wx:for="{{courseList}}"
        wx:key="id"
        class="ccard"
        bindtap="onCardTap"
        data-id="{{item.id}}"
      >
        <view class="ccard-thumb {{item.colorClass}}">
          <image wx:if="{{item.cover && !item.coverFailed}}" src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="ccard-img" data-id="{{item.id}}" data-cover="{{item.cover}}" binderror="onCoverError" />
          <icon wx:else name="{{item.icon}}" size="34" color="rgba(255,255,255,0.92)" />
        </view>
        <view class="ccard-body">
          <view class="ccard-title serif">{{item.name}}</view>
          <view class="ccard-desc">{{item.desc}}</view>
          <view class="ccard-meta">
            <view class="meta-i"><icon name="users" size="13" color="#6B6459" /><text>{{item.audience}}</text></view>
            <view class="meta-i"><icon name="clock" size="13" color="#6B6459" /><text>{{item.lessonCount}} 课时</text></view>
            <view class="ccard-tags">
              <text
                wx:for="{{item.tags}}"
                wx:for-item="tagName"
                wx:key="*this"
                class="pill {{tagName === '字幕' ? 'gold' : ''}}"
              >{{tagName}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{error && !loading && !courseList.length}}" class="page-state-box">
        <icon class="page-state-icon" name="alert" size="40" color="#D6CDB8" />
        <text class="page-state-text">加载失败，请检查网络后重试</text>
        <view class="page-state-action" bindtap="onRetry">重新加载</view>
      </view>

      <view wx:elif="{{!loading && !courseList.length && !error}}" class="empty-state">
        <icon name="course" size="40" color="#D6CDB8" />
        <text>暂无课程</text>
      </view>

      <view class="list-bottom"></view>
    </view>
  </scroll-view>

</view>
