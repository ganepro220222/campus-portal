/* pages/course/index.wxss */
/* 页底是纸，不是色晕。理由同 pages/news、pages/hall。 */
.course-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}

/* 顶栏：宿主要在 flex 列里占住自身高度，不能被列表挤扁 */
nav-bar { flex: 0 0 auto; }
/* 搜索键 = nav-bar 返回键同一枚纸钮，左右对称 */
.nav-search {
  width: 88rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
}
.nav-search-disc {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(252, 250, 244, 0.8);
  box-shadow: 0 2rpx 8rpx rgba(96, 78, 44, 0.16),
              inset 0 0 0 2rpx rgba(150, 120, 66, 0.26);
}
.nav-search-hover .nav-search-disc { background: var(--xing-05); }

/* 分类：一排小签，选中的那一枚是朱印。三张 tab 列表页同一份。 */
.cats { white-space: nowrap; padding: 6rpx 0 18rpx; }
.cats-inner { display: inline-flex; gap: 14rpx; padding: 0 32rpx; }
.cat {
  flex: 0 0 auto;
  font-size: 25rpx;
  padding: 10rpx 26rpx;
  border-radius: 4rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  transition: 0.15s;
}
.cat-on {
  color: var(--paper-card);
  border-color: var(--zhu-d);
  background: linear-gradient(180deg, var(--zhu), var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.28),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 2rpx 6rpx rgba(158,43,37,.26);
}

/* 列表 */
.course-scroll { flex: 1; overflow: hidden; }
.course-wrap { padding: 24rpx 32rpx 0; }

/* 和首页「热门课程」那一档对齐：同样的圆角、内边距、暖投影 */
.ccard {
  display: flex;
  gap: 24rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(74,50,30, 0.07);
  margin-bottom: 22rpx;
  transition: transform 0.15s;
}
.ccard:active { transform: scale(0.99); }
.ccard-thumb { flex-shrink: 0; width: 168rpx; }
.ccard-thumb .mount-art { height: 168rpx; }
.ccard-img { width: 100%; height: 100%; }
.ccard-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.ccard-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
  word-break: break-all;
}
.ccard-desc {
  font-size: 24rpx;
  color: var(--sub);
  line-height: 1.55;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ccard-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: auto;
  padding-top: 14rpx;
  flex-wrap: wrap;
}
.meta-i { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: var(--muted); }
.ccard-tags { display: inline-flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }

/* 底部留白要盖过整条标签栏，**再留出设计稿那口气**。
   标签栏 = 回纹带 40rpx + 栏身 104rpx = 144rpx（安全区两边都另算，抵消）。
   原来写 150rpx，是标签栏还只有 108rpx 那会儿定的；加了回纹带之后
   净空隙从 42rpx 掉到 6rpx（3px），最后一块卡片几乎贴着回纹带。
   设计稿 home.html 给 .fret 的是 margin-top: 20px = 40rpx，
   所以这里取 144 + 40 = 184rpx。改标签栏高度时这个数要跟着改，
   check:tabbar-routes 会拦。 */
.list-bottom { height: calc(184rpx + env(safe-area-inset-bottom)); }

/* 全局 .page-refresh-bar 默认 28rpx 横向边距（对齐详情页栏距），本页内容栏距是 32rpx（.course-wrap），
   不覆写的话红条会比下方卡片各窄 4rpx，边缘对不齐。加根类提权，避免依赖样式表先后顺序。 */
.course-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
