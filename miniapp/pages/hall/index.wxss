/* pages/hall/index.wxss */
.hall-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, var(--sky-2) 0, var(--paper) 240rpx);
}

/* 顶栏：宿主要在 flex 列里占住自身高度，不能被列表挤扁 */
nav-bar { flex: 0 0 auto; }
.nav-search {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.nav-search:active { background: var(--sky-3); }

.cats { white-space: nowrap; padding: 6rpx 0 18rpx; }
.cats-inner { display: inline-flex; gap: 16rpx; padding: 0 32rpx; }
.cat {
  flex: 0 0 auto;
  font-size: 25rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--sub);
  transition: 0.15s;
}
.cat-on {
  background: linear-gradient(135deg, var(--blue), var(--navy));
  color: var(--card);
  border-color: transparent;
}

/* 网格 */
.hall-scroll { flex: 1; overflow: hidden; }
.hall-grid {
  padding: 24rpx 32rpx 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.hcard {
  border-radius: 26rpx;
  overflow: hidden;
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.10);
  transition: transform 0.15s;
}
.hcard:active { transform: translateY(-4rpx); }
.hcard-cover {
  position: relative;
  height: 180rpx;
  padding: 20rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.hcard-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hcard-img { width: 100%; height: 100%; opacity: 0.4; }
.hcard-corner { position: absolute; right: 16rpx; top: 14rpx; }
.hcard-ct {
  position: relative;
  z-index: 2;
  color: var(--card);
  font-size: 30rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.hcard-foot { padding: 16rpx 20rpx 20rpx; }
.hcard-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.35;
  min-height: 2.7em;
}
.hcard-vr {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(158,125,69, 0.1);
  color: var(--blue);
}
.hcard-vr-off {
  background: #F0F2F7;
  color: var(--muted);
}
.hcard-desc {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-bottom { height: calc(150rpx + env(safe-area-inset-bottom)); }

/* 全局 .page-refresh-bar 默认 28rpx 横向边距（对齐详情页栏距），本页内容栏距是 32rpx（.hall-grid），
   不覆写的话红条会比下方卡片各窄 4rpx，边缘对不齐。加根类提权，避免依赖样式表先后顺序。 */
.hall-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
