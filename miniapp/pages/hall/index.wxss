/* pages/hall/index.wxss */
/* 页底是纸，不是色晕。理由同 pages/news：sky-2 现在是绢青，
   拿它铺页面背景，屋檐底下就接了一层绿雾。 */
.hall-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}

/* 顶栏：宿主要在 flex 列里占住自身高度，不能被列表挤扁 */
nav-bar { flex: 0 0 auto; }
/* 搜索键 = nav-bar 返回键同一枚纸钮，左右对称 */
.nav-search {
  width: 88rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
}
.nav-search-disc {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(252, 250, 244, 0.8);
  box-shadow: 0 2rpx 8rpx rgba(96, 78, 44, 0.16),
              inset 0 0 0 2rpx rgba(150, 120, 66, 0.26);
}
.nav-search-hover .nav-search-disc { background: var(--xing-05); }

/* 分类：一排小签，选中的那一枚是朱印。与 pages/news 同一份，
   两页顶上的东西一模一样，不该长得不一样。 */
.cats { white-space: nowrap; padding: 6rpx 0 18rpx; }
.cats-inner { display: inline-flex; gap: 14rpx; padding: 0 32rpx; }
.cat {
  flex: 0 0 auto;
  font-size: 25rpx;
  padding: 10rpx 26rpx;
  border-radius: 4rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  transition: 0.15s;
}
.cat-on {
  color: var(--paper-card);
  border-color: var(--zhu-d);
  background: linear-gradient(180deg, var(--zhu), var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.28),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 2rpx 6rpx rgba(158,43,37,.26);
}

/* 网格 */
.hall-scroll { flex: 1; overflow: hidden; }
/* 两列必须写 minmax(0, 1fr)，不能写 1fr。
   `1fr` 展开是 `minmax(auto, 1fr)`，那个 auto 下限 = 这一列内容的
   **最小内容宽度**；卡片里的 .hcard-desc 是 white-space: nowrap 的一整句，
   于是最小内容宽度 = 那句话的完整长度，列宽被它顶开。
   实测：一句 366px、另一句 313px，两列加起来 707px 铺在 375pt 的屏上，
   而且**两列不等宽**（谁的简介长谁就宽）——截图里"有的差那么一截、
   有的横着排"就是这么来的。minmax(0, …) 把下限按回 0。 */
.hall-grid {
  padding: 24rpx 32rpx 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 24rpx;
}
/* 卡片是一张纸，裱框搁在纸上。裱框自己有 12rpx 圆角，
   所以卡片留 12rpx 内边距、圆角放到 20rpx —— 框贴着卡片边会像没裱好。 */
/* min-width: 0 是第二道：网格项自己的默认 min-width 也是 auto。
   上一版靠 overflow: hidden（裁铺满的封面）把这个下限按成 0；
   封面改成裱框之后不再裁，那个副作用没了，溢出就回来。
   现在写明 min-width: 0，不再依赖 overflow。 */
.hcard {
  min-width: 0;
  border-radius: 20rpx;
  padding: 12rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  box-shadow: 0 6rpx 18rpx rgba(74,50,30, 0.09);
  transition: transform 0.15s;
}
.hcard:active { transform: translateY(-4rpx); }
.hcard-art { height: 180rpx; }
.hcard-foot { padding: 14rpx 6rpx 4rpx; }
.hcard-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.35;
}
/* 其余样子由共用的 .pill 给，这里只管在卡片里的位置 */
.hcard-vr { display: inline-block; margin-top: 10rpx; }
.hcard-desc {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部留白要盖过整条标签栏，**再留出设计稿那口气**。
   标签栏 = 回纹带 40rpx + 栏身 104rpx = 144rpx（安全区两边都另算，抵消）。
   原来写 150rpx，是标签栏还只有 108rpx 那会儿定的；加了回纹带之后
   净空隙从 42rpx 掉到 6rpx（3px），最后一块卡片几乎贴着回纹带。
   设计稿 home.html 给 .fret 的是 margin-top: 20px = 40rpx，
   所以这里取 144 + 40 = 184rpx。改标签栏高度时这个数要跟着改，
   check:tabbar-routes 会拦。 */
.list-bottom { height: calc(184rpx + env(safe-area-inset-bottom)); }

/* 全局 .page-refresh-bar 默认 28rpx 横向边距（对齐详情页栏距），本页内容栏距是 32rpx（.hall-grid），
   不覆写的话红条会比下方卡片各窄 4rpx，边缘对不齐。加根类提权，避免依赖样式表先后顺序。 */
.hall-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
