<!-- pages/index/index.wxml -->
<view class="home-page">

  <!-- 吸顶 Header：校名居中 + （我的 · 搜索 · 铃铛）一行 -->
  <view class="header">
    <view style="height: {{statusBarHeight}}px;"></view>
    <!-- 校名（书法字·图片，跨机型显示一致；高度随胶囊几何对齐） -->
    <view class="header-titlebar" style="height: {{navContentHeight}}px;">
      <image class="header-name-img" src="/assets/images/home-title-calligraphy.png" mode="heightFix" />
    </view>
    <!-- 我的 + 搜索 + 铃铛（同一行，一左一右） -->
    <view class="header-actionbar">
      <view class="header-icon" bindtap="onProfileTap">
        <icon name="user-circle" size="24" color="#2B356E" />
      </view>
      <view class="search-bar" bindtap="onSearchTap">
        <icon name="search" size="17" color="#67708C" />
        <text class="search-placeholder">搜索动态、课程、展馆、资源…</text>
      </view>
      <view class="header-icon" bindtap="onBellTap">
        <icon name="bell" size="22" color="#2B356E" />
        <view wx:if="{{hasNewAnnouncement}}" class="bell-dot"></view>
      </view>
    </view>
  </view>

  <scroll-view class="scroll-body" scroll-y enhanced show-scrollbar="{{false}}">

    <skeleton show="{{loading && !homeError}}" type="home" count="5" />
    <view wx:if="{{homeError}}" class="page-state-box home-error-box">
      <icon class="page-state-icon" name="alert" size="40" color="#C3CCE0" />
      <text class="page-state-text">首页加载失败，请检查网络后重试</text>
      <view class="page-state-action" bindtap="onRetryHome">重新加载</view>
    </view>
    <block wx:elif="{{!loading}}">
    <view wx:if="{{refreshError}}" class="page-refresh-bar" bindtap="onRetryHome">
      <text>首页刷新失败，点击重试</text>
    </view>

    <!-- Banner 轮播 -->
    <view class="wrap">
      <view wx:if="{{sectionErrors.banners && !banners.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>轮播加载失败，点击重试</text>
      </view>
      <swiper
        wx:if="{{banners.length}}"
        class="banner"
        autoplay
        interval="4200"
        circular
        indicator-dots="{{false}}"
        bindchange="onBannerChange"
      >
        <swiper-item
          wx:for="{{banners}}"
          wx:key="id"
          bindtap="onBannerTap"
          data-link-type="{{item.linkType}}"
          data-link-value="{{item.linkValue}}"
        >
          <view class="bslide {{item.colorClass || 's1'}}">
            <view class="bslide-deco"></view>
            <view wx:if="{{item.imageUrl}}" class="bslide-bg">
              <image src="{{item.imageUrl}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="bslide-img" />
            </view>
            <view class="bslide-tag">{{item.category || '书院动态'}}</view>
            <view class="bslide-title serif">{{item.title}}</view>
            <view class="bslide-desc">{{item.description}}</view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{banners.length}}" class="bdots">
        <view
          wx:for="{{banners}}"
          wx:key="id"
          class="bdot {{bannerIndex === index ? 'bdot-on' : ''}}"
        ></view>
      </view>

      <!-- 公告条：失败不伪装成「没有公告」 -->
      <view wx:if="{{announcementError && announcements.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryAnnouncements">
        <text>公告刷新失败，点击重试</text>
      </view>
      <view wx:elif="{{announcementError && !announcements.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryAnnouncements">
        <text>公告加载失败，点击重试</text>
      </view>
      <view wx:if="{{announcements.length}}" class="notice-bar" bindtap="onNoticeTap">
        <icon name="megaphone" size="16" color="#BE9C44" />
        <text class="notice-text">{{announcements[0].content}}</text>
        <icon name="chevron-right" size="15" color="#67708C" />
      </view>
    </view>

    <!-- 功能入口矩阵 -->
    <view class="entries-wrap wrap">
      <view class="entries">
        <view
          wx:for="{{navEntries}}"
          wx:key="id"
          class="entry"
          bindtap="onEntryTap"
          data-index="{{index}}"
        >
          <view class="ico {{item.toneClass}}"><icon name="{{item.icon}}" size="25" color="#ffffff" /></view>
          <text class="entry-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 精品好物（工艺品展示，无在线购买） -->
    <view class="craft-banner wrap" bindtap="onCraftTap">
      <view class="craft-banner-inner">
        <view class="craft-ic"><icon name="medal" size="28" color="#ffffff" /></view>
        <view class="craft-text">
          <text class="craft-title serif">精品好物</text>
          <text class="craft-sub">工艺品鉴赏 · 合作咨询</text>
        </view>
        <icon name="chevron-right" size="18" color="rgba(255,255,255,0.85)" />
      </view>
    </view>

    <!-- 线上展馆 -->
    <view class="section wrap">
      <view class="sec-head">
        <view class="sec-title serif">线上展馆</view>
        <view class="sec-more" bindtap="onSectionMore" data-path="/pages/hall/index">全部<icon name="chevron-right" size="13" color="#67708C" /></view>
      </view>
      <view wx:if="{{sectionErrors.recommends && !hallList.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>展馆加载失败，点击重试</text>
      </view>
      <scroll-view wx:if="{{hallList.length}}" scroll-x class="halls-scroll" enhanced show-scrollbar="{{false}}">
        <view class="halls-inner">
          <view
            wx:for="{{hallList}}"
            wx:key="id"
            class="hall-card"
            bindtap="onHallTap"
            data-id="{{item.id}}"
          >
            <view class="hc-cover {{item.colorClass || 'hc1'}}">
              <view wx:if="{{item.cover}}" class="hc-bg">
                <image src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="hc-img" />
              </view>
              <view class="hc-corner"><icon name="museum" size="30" color="rgba(255,255,255,0.34)" /></view>
              <text class="hc-ct serif">{{item.shortName}}</text>
            </view>
            <view class="hc-name">{{item.name}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 最新动态 -->
    <view class="section wrap">
      <view class="sec-head">
        <view class="sec-title serif">最新动态</view>
        <view class="sec-more" bindtap="onSectionMore" data-path="/pages/news/index">更多<icon name="chevron-right" size="13" color="#67708C" /></view>
      </view>
      <view wx:if="{{sectionErrors.recommends && !newsList.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>动态加载失败，点击重试</text>
      </view>
      <view wx:if="{{newsList.length}}" class="cards">
        <view
          wx:for="{{newsList}}"
          wx:key="id"
          class="ncard"
          bindtap="onNewsCardTap"
          data-id="{{item.id}}"
        >
          <view class="ncard-thumb {{item.colorClass || 'hc1'}}">
            <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="ncard-img" />
            <icon wx:else name="{{item.icon}}" size="26" color="rgba(255,255,255,0.92)" />
          </view>
          <view class="ncard-body">
            <view class="ncard-title">{{item.title}}</view>
            <view class="ncard-meta">
              <text class="pill">{{item.categoryName}}</text>
              <text class="ncard-date">{{item.publishTime}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 热门课程 -->
    <view class="section wrap">
      <view class="sec-head">
        <view class="sec-title serif">热门课程</view>
        <view class="sec-more" bindtap="onSectionMore" data-path="/pages/course/index">更多<icon name="chevron-right" size="13" color="#67708C" /></view>
      </view>
      <view wx:if="{{sectionErrors.recommends && !courseList.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>课程加载失败，点击重试</text>
      </view>
      <view wx:if="{{courseList.length}}" class="cards">
        <view
          wx:for="{{courseList}}"
          wx:key="id"
          class="ccard"
          bindtap="onCourseCardTap"
          data-id="{{item.id}}"
        >
          <view class="ccard-thumb {{item.colorClass || 'hc3'}}">
            <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="ccard-img" />
            <icon wx:else name="{{item.icon}}" size="30" color="rgba(255,255,255,0.92)" />
          </view>
          <view class="ccard-body">
            <view class="ccard-title serif">{{item.name}}</view>
            <view class="ccard-meta">
              <text class="pill {{item.categoryName === 'AI 字幕' ? 'gold' : ''}}">{{item.categoryName}}</text>
              <text class="ccard-sub">{{item.lessonCount || 0}} 课时</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 协同育人 · 关联小程序（App 入口横条；1→N 统一，首页至多 3 条，余下进「更多」） -->
    <view wx:if="{{collegeList.length || sectionErrors.colleges}}" class="section wrap">
      <view class="sec-head">
        <view class="sec-title serif">关联应用</view>
        <view class="sec-more" bindtap="onCollegeMore">全部<icon name="chevron-right" size="13" color="#67708C" /></view>
      </view>
      <view wx:if="{{sectionErrors.colleges && !collegeHome.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>关联应用加载失败，点击重试</text>
      </view>
      <view wx:if="{{collegeHome.length}}" class="app-list">
        <view
          wx:for="{{collegeHome}}"
          wx:key="id"
          class="app-row"
          hover-class="app-row-hover"
          hover-stay-time="60"
          bindtap="onCollegeTap"
          data-id="{{item.id}}"
        >
          <view class="app-icon {{item.colorClass || 'hc1'}}">
            <image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="aspectFit" class="app-icon-img" />
            <text wx:else class="app-icon-seal serif">{{item.short}}</text>
          </view>
          <view class="app-body">
            <view class="app-name">{{item.name}}</view>
            <view class="app-tag">协同小程序 · 点击打开</view>
          </view>
          <view class="app-open">打开<icon name="chevron-right" size="12" color="#2B356E" /></view>
        </view>
      </view>
    </view>

    <view class="scroll-bottom"></view>
    </block>
  </scroll-view>

  <!-- AI 助手 -->
  <ai-assistant />

</view>
