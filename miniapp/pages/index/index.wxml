<!-- pages/index/index.wxml -->
<view class="home-page">

  <!-- 细吸顶搜索条：卷首那条搜索行滑到它底下时接手，
       保证任何时刻屏幕上只有一个搜索框。右侧留出胶囊的位置。 -->
  <view class="topbar {{topbarOn ? 'topbar-on' : ''}}">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="topbar-row" style="height: {{navContentHeight}}px; padding-right: {{capsulePadding}}px;">
      <view class="search search-mini" bindtap="onSearchTap">
        <icon name="search" size="15" color="#6B6459" />
        <text class="search-ph">搜索动态、课程、展馆、资源…</text>
      </view>
    </view>
  </view>

  <scroll-view class="scroll-body" scroll-y enhanced show-scrollbar="{{false}}" bindscroll="onBodyScroll">

    <!-- ── 卷首：通栏出血的一幅青绿山水，屋檐压在画上 ──
         画是这套方案最强的身份标记，所以它在最上面、通栏、不被任何东西挤掉。
         檐、书法题名、搜索行都排在画上；下半幅留白，纸从那里翻上来。 -->
    <view class="hero">
      <image class="hero-shan" src="/assets/images/hero-shan.png" mode="scaleToFill" />
      <view class="hero-flow">
        <!-- 状态栏让位。这里**不再给胶囊单独让位**：实测胶囊落在瓦面上，
             合成后黑色图标对比度 10.11:1，远在 AA 之上，所以照设计稿让檐顶到最上面。 -->
        <view style="height: {{statusBarHeight}}px;"></view>
        <image class="hero-eave" src="/assets/images/hero-eave.png" mode="scaleToFill" />
        <view class="hero-brand">
          <image class="hero-brand-img" src="/assets/images/home-title-calligraphy.png" mode="heightFix" />
        </view>
        <!-- 我的 · 搜索 · 铃铛，浮在画上。画的颜色不定，所以三件都垫一方半透明的纸。 -->
        <view class="head-row">
          <view class="hi" bindtap="onProfileTap" hover-class="hi-hover">
            <icon name="user-circle" size="22" color="#614923" />
          </view>
          <view class="search" bindtap="onSearchTap">
            <icon name="search" size="15" color="#6B6459" />
            <text class="search-ph">搜索动态、课程、展馆、资源…</text>
          </view>
          <view class="hi" bindtap="onBellTap" hover-class="hi-hover">
            <icon name="bell" size="21" color="#614923" />
            <view wx:if="{{hasNewAnnouncement}}" class="hi-dot"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- ── 纸：从卷首下沿翻上来，上沿留一道轴头 ── -->
    <view class="sheet">

    <skeleton show="{{loading && !homeError}}" type="home" count="5" />
    <view wx:if="{{homeError}}" class="page-state-box home-error-box">
      <icon class="page-state-icon" name="alert" size="40" color="#D6CDB8" />
      <text class="page-state-text">首页加载失败，请检查网络后重试</text>
      <view class="page-state-action" bindtap="onRetryHome">重新加载</view>
    </view>
    <block wx:elif="{{!loading}}">
    <view wx:if="{{refreshError}}" class="page-refresh-bar" bindtap="onRetryHome">
      <text>首页刷新失败，点击重试</text>
    </view>

    <view class="wrap">
      <!-- 公告条：定稿里它在轮播**上面**——公告是"今天这一条"，
           先看见它再看轮播；压在轮播下面就成了轮播的附注。
           失败不伪装成「没有公告」。 -->
      <view wx:if="{{announcementError && announcements.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryAnnouncements">
        <text>公告刷新失败，点击重试</text>
      </view>
      <view wx:elif="{{announcementError && !announcements.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryAnnouncements">
        <text>公告加载失败，点击重试</text>
      </view>
      <view wx:if="{{announcements.length}}" class="notice-bar" bindtap="onNoticeTap">
        <icon name="megaphone" size="16" color="#9E7D45" />
        <text class="notice-text">{{announcements[0].content}}</text>
        <icon name="chevron-right" size="15" color="#6B6459" />
      </view>

      <!-- Banner 轮播 -->
      <view wx:if="{{sectionErrors.banners && !banners.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>轮播加载失败，点击重试</text>
      </view>
      <swiper
        wx:if="{{banners.length}}"
        class="banner"
        autoplay
        interval="4200"
        circular
        indicator-dots="{{false}}"
        bindchange="onBannerChange"
      >
        <swiper-item
          wx:for="{{banners}}"
          wx:key="id"
          bindtap="onBannerTap"
          data-link-type="{{item.linkType}}"
          data-link-value="{{item.linkValue}}"
        >
          <view class="bslide {{item.colorClass || 's1'}}">
            <view class="bslide-deco"></view>
            <view wx:if="{{item.imageUrl && !item.coverFailed}}" class="bslide-bg">
              <image src="{{item.imageUrl}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="bslide-img" data-list="banners" data-id="{{item.id}}" data-cover="{{item.imageUrl}}" binderror="onCoverError" />
            </view>
            <view class="bslide-tag">{{item.category || '书院动态'}}</view>
            <view class="bslide-title serif">{{item.title}}</view>
            <view class="bslide-desc">{{item.description}}</view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{banners.length}}" class="bdots">
        <view
          wx:for="{{banners}}"
          wx:key="id"
          class="bdot {{bannerIndex === index ? 'bdot-on' : ''}}"
        ></view>
      </view>
    </view>

    <!-- 功能入口矩阵 -->
    <view class="entries-wrap wrap">
      <view class="entries">
        <view
          wx:for="{{navEntries}}"
          wx:key="id"
          class="entry"
          bindtap="onEntryTap"
          data-index="{{index}}"
        >
          <!-- 多色器物图；后台配了表外的图标名才退回单色线描 -->
          <image wx:if="{{item.iconImage}}" class="ico" src="{{item.iconImage}}" mode="aspectFit" />
          <view wx:else class="ico ico-fallback"><icon name="{{item.icon}}" size="25" color="#7E6134" /></view>
          <text class="entry-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 精品好物（工艺品展示，无在线购买） -->
    <view class="craft-banner wrap" bindtap="onCraftTap">
      <view class="craft-banner-inner">
        <view class="craft-ic"><icon name="medal" size="28" color="#FFFBF2" /></view>
        <view class="craft-text">
          <text class="craft-title serif">精品好物</text>
          <text class="craft-sub">工艺品鉴赏 · 合作咨询</text>
        </view>
        <icon name="chevron-right" size="18" color="rgba(255,255,255,0.85)" />
      </view>
    </view>

    <!-- 线上展馆 -->
    <view class="section wrap">
      <view class="sec-head">
        <view class="sec-title serif">线上展馆</view>
        <view class="sec-more" bindtap="onSectionMore" data-path="/pages/hall/index">全部<icon name="chevron-right" size="13" color="#6B6459" /></view>
      </view>
      <view wx:if="{{sectionErrors.recommends && !hallList.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>展馆加载失败，点击重试</text>
      </view>
      <scroll-view wx:if="{{hallList.length}}" scroll-x class="halls-scroll" enhanced show-scrollbar="{{false}}">
        <view class="halls-inner">
          <view
            wx:for="{{hallList}}"
            wx:key="id"
            class="hall-card"
            bindtap="onHallTap"
            data-id="{{item.id}}"
          >
            <view class="hc-cover {{item.colorClass || 'hc1'}}">
              <view wx:if="{{item.cover && !item.coverFailed}}" class="hc-bg">
                <image src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="hc-img" data-list="hallList" data-id="{{item.id}}" data-cover="{{item.cover}}" binderror="onCoverError" />
              </view>
              <view class="hc-corner"><icon name="museum" size="30" color="rgba(255,255,255,0.34)" /></view>
              <text class="hc-ct serif">{{item.shortName}}</text>
            </view>
            <view class="hc-name">{{item.name}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 最新动态 -->
    <view class="section wrap">
      <view class="sec-head">
        <view class="sec-title serif">最新动态</view>
        <view class="sec-more" bindtap="onSectionMore" data-path="/pages/news/index">更多<icon name="chevron-right" size="13" color="#6B6459" /></view>
      </view>
      <view wx:if="{{sectionErrors.recommends && !newsList.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>动态加载失败，点击重试</text>
      </view>
      <view wx:if="{{newsList.length}}" class="cards">
        <view
          wx:for="{{newsList}}"
          wx:key="id"
          class="ncard"
          bindtap="onNewsCardTap"
          data-id="{{item.id}}"
        >
          <view class="ncard-thumb {{item.colorClass || 'hc1'}}">
            <image wx:if="{{item.cover && !item.coverFailed}}" src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="ncard-img" data-list="newsList" data-id="{{item.id}}" data-cover="{{item.cover}}" binderror="onCoverError" />
            <icon wx:else name="{{item.icon}}" size="26" color="rgba(255,255,255,0.92)" />
          </view>
          <view class="ncard-body">
            <view class="ncard-title">{{item.title}}</view>
            <view class="ncard-meta">
              <text class="pill">{{item.categoryName}}</text>
              <text class="ncard-date">{{item.publishTime}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 热门课程 -->
    <view class="section wrap">
      <view class="sec-head">
        <view class="sec-title serif">热门课程</view>
        <view class="sec-more" bindtap="onSectionMore" data-path="/pages/course/index">更多<icon name="chevron-right" size="13" color="#6B6459" /></view>
      </view>
      <view wx:if="{{sectionErrors.recommends && !courseList.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>课程加载失败，点击重试</text>
      </view>
      <view wx:if="{{courseList.length}}" class="cards">
        <view
          wx:for="{{courseList}}"
          wx:key="id"
          class="ccard"
          bindtap="onCourseCardTap"
          data-id="{{item.id}}"
        >
          <view class="ccard-thumb {{item.colorClass || 'hc3'}}">
            <image wx:if="{{item.cover && !item.coverFailed}}" src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" class="ccard-img" data-list="courseList" data-id="{{item.id}}" data-cover="{{item.cover}}" binderror="onCoverError" />
            <icon wx:else name="{{item.icon}}" size="30" color="rgba(255,255,255,0.92)" />
          </view>
          <view class="ccard-body">
            <view class="ccard-title serif">{{item.name}}</view>
            <view class="ccard-meta">
              <text
                wx:for="{{item.tags}}"
                wx:for-item="tagName"
                wx:key="*this"
                class="pill {{tagName === '字幕' ? 'gold' : ''}}"
              >{{tagName}}</text>
              <text class="ccard-sub">{{item.lessonCount || 0}} 课时</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 协同育人 · 关联小程序（App 入口横条；1→N 统一，首页至多 3 条，余下进「更多」） -->
    <view wx:if="{{collegeList.length || sectionErrors.colleges}}" class="section wrap">
      <view class="sec-head">
        <view class="sec-title serif">关联应用</view>
        <view class="sec-more" bindtap="onCollegeMore">全部<icon name="chevron-right" size="13" color="#6B6459" /></view>
      </view>
      <view wx:if="{{sectionErrors.colleges && !collegeHome.length}}" class="page-refresh-bar home-section-bar" bindtap="onRetryHome">
        <text>关联应用加载失败，点击重试</text>
      </view>
      <view wx:if="{{collegeHome.length}}" class="app-list">
        <view
          wx:for="{{collegeHome}}"
          wx:key="id"
          class="app-row"
          hover-class="app-row-hover"
          hover-stay-time="60"
          bindtap="onCollegeTap"
          data-id="{{item.id}}"
        >
          <view class="app-icon {{item.iconHasImage ? 'app-icon--plate' : (item.colorClass || 'hc1')}} {{item.iconCircle ? 'app-icon--circle' : ''}}">
            <image wx:if="{{item.iconUrl}}" src="{{item.iconUrl}}" mode="{{item.iconImageMode || 'aspectFit'}}" class="app-icon-img" />
            <text wx:else class="app-icon-seal serif">{{item.short}}</text>
          </view>
          <view class="app-body">
            <view class="app-name">{{item.name}}</view>
            <view class="app-tag">协同小程序 · 点击打开</view>
          </view>
          <view class="app-open">打开<icon name="chevron-right" size="12" color="#7E6134" /></view>
        </view>
      </view>
    </view>

    <view class="scroll-bottom"></view>
    </block>
    </view><!-- /sheet -->
  </scroll-view>

  <ai-assistant />

</view>
