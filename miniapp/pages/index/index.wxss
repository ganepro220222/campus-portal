/* pages/index/index.wxss — 首页 */

.home-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 卷首那幅画顶在最上面，页面底色只在画以下露出来，所以是平铺的纸，
     不再是原来那道冷蓝到纸色的渐变。 */
  background: var(--paper);
}
.home-error-box { padding-top: 80rpx; }
.home-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
.home-section-bar { margin: 0 0 16rpx; }

/* ══════════════ 卷首 ══════════════
   定稿里首页开篇是**通栏出血的一幅青绿山水，屋檐压在画上**，
   书法题名和搜索行都落在画里。这幅画是整套方案最强的身份标记。

   它有 736rpx（＝设计稿 368px）高，占掉小半屏，所以不可能吸顶——
   卷首整体跟着内容滚走，滚过去之后由下面那条 .topbar 接手搜索。

   画和檐是两张 PNG（scripts/build-hero.mjs 生成）：
   WXML 不渲染内联 SVG，WXSS 的 background-image 也不收本地路径。
   分两张而不是合成一张，是因为**檐的位置跟着机型走**——
   状态栏高度各机型不同，合成就把檐钉死在某一个偏移上了。 */
.hero {
  position: relative;
  min-height: 736rpx;
  overflow: hidden;
}
/* 画铺满整个卷首。scaleToFill 对应设计稿那个 preserveAspectRatio="none"：
   画本来就是按屏宽拉伸用的，换机型只是纵向拉高一点。 */
.hero-shan {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.hero-flow { position: relative; z-index: 2; }
.hero-eave {
  display: block;
  width: 100%;
  height: 124rpx;        /* ＝设计稿 62px，满檐；顶栏组件那张是矮一档的 46px，两张不通用 */
  margin-bottom: -4rpx;  /* 檐脚压住下面一点点，中间不透缝 */
}
/* 画上的题名：比二级页顶栏那一档大，它现在是这幅画的题款 */
.hero-brand {
  padding: 44rpx 0 0;
  display: flex;
  justify-content: center;
}
.hero-brand-img {
  height: 80rpx;         /* ＝设计稿 40px */
  width: auto;
  /* 墨字压在浅色的绢底上，垫一层极淡的白让笔画离开背景 */
  filter: drop-shadow(0 1rpx 0 rgba(255,255,255,.9))
          drop-shadow(0 4rpx 12rpx rgba(74,102,96,.22));
}

/* 我的 · 搜索 · 铃铛：浮在画上 */
.head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx 32rpx 0;
}
/* 画的颜色不定（后面还会换图），所以三件工具都垫一方半透明的纸，
   和二级页返回键同一个办法——直接落在绢底最深处只有 3.74:1。 */
.hi {
  position: relative;
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(252, 250, 244, 0.74);
  box-shadow: 0 2rpx 8rpx rgba(96,78,44,.18),
              inset 0 0 0 2rpx rgba(150,120,66,.22);
}
.hi-hover { background: var(--xing-05); }
.hi-dot {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--zhu);
}
/* 搜索框（卷首上那一条）。原来是冷蓝灰的填充加一圈冷蓝灰描边——
   那两个值是旧配色留下的，又不在旧调色板对照表里，所以护栏一直扫不到。
   这里换成"半透明的纸 + 木色描边"，和它脚下那幅画是一家人。 */
.search {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(252, 250, 244, 0.80);
  border: 1rpx solid rgba(122, 110, 85, 0.26);
  box-shadow: inset 0 2rpx 6rpx rgba(107,67,38,.10),
              0 2rpx 0 rgba(255,252,244,.9);
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  gap: 14rpx;
}
.search:active {
  transform: translateY(1rpx);
  background: var(--xing-05);
}
.search-ph {
  font-size: 26rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 细吸顶搜索条 ──
   卷首滚走之后顶上淡入这一条，搜索始终点得到。
   触发点由 JS 量出来（卷首那条搜索行的下沿减去本条高度），
   所以两个搜索框不会同时出现在屏幕上。 */
.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 60;
  background: rgba(247, 243, 232, 0.94);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid var(--line);
  box-shadow: 0 4rpx 20rpx rgba(74,50,30,.06);
  /* 默认收起：不可见、不挡点击，也不参与无障碍焦点 */
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8rpx);
  transition: opacity .22s ease, transform .22s ease, visibility .22s;
  pointer-events: none;
}
.topbar-on {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}
.topbar-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-left: 32rpx;   /* 右侧内边距由 JS 按胶囊位置注入 */
}
.search-mini { height: 64rpx; }

/* ── 纸：从卷首下沿翻上来 ── */
.sheet {
  position: relative;
  z-index: 3;
  margin-top: -52rpx;                     /* ＝设计稿 -26px，纸盖住画的下沿 */
  border-radius: 36rpx 36rpx 0 0;
  background: var(--paper);
  box-shadow: 0 -4rpx 0 rgba(200,164,92,.30),
              0 -20rpx 52rpx rgba(74,102,96,.13);
}
/* 纸的上沿留一道提手，像卷轴的轴头 */
.sheet::before {
  content: '';
  display: block;
  width: 92rpx;
  height: 6rpx;
  margin: 18rpx auto 8rpx;
  border-radius: 4rpx;
  background: var(--wood-40);
  opacity: .7;
}

/* ── 可滚动内容区 ── */
.scroll-body { flex: 1; overflow: hidden; }
.wrap { padding: 0 32rpx; }
.scroll-bottom { height: calc(150rpx + env(safe-area-inset-bottom)); }

/* ── 轮播 ──
   定稿里轮播是**裱起来的一幅画**：木纹裱边、四角角叶、右上一枚竖排题签、
   左下一条绢上写标题。装裱那几个类在 app.wxss（展馆封面、资讯缩略图要共用），
   这里只管轮播自己的尺寸。

   改掉的旧做法：封面图原来铺在一块 .s1~.s3 的渐变色块上、
   自己压到 opacity .32。那三块色阶是旧蓝紫调色板（.s1 走 var(--navy-deep)
   和 var(--blue)，被别名令牌换算成棕金），照片压淡之后叠在棕金上，
   出来是一块说不清是什么的灰褐方块 —— 反馈原话是"不知道是什么内容，
   不知道是不是没有加载出来"。
   定稿的办法是照片**满强度**铺满，可读性交给两件事：画心的暗角、
   以及标题脚下那条绢。压淡照片既丢信息又不解决对比度。 */
.banner {
  position: relative;
  height: 372rpx;          /* 裱边 20rpx + 画心 352rpx；设计稿画心 176px */
  margin-top: 24rpx;
}
.bslide { width: 100%; height: 100%; box-sizing: border-box; }
.banner-art { height: 100%; }
.banner-art .b-title {
  font-size: 34rpx;
  line-height: 1.45;
  letter-spacing: 2rpx;
  color: var(--ink);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.banner-art .b-desc {
  font-size: 24rpx;
  margin-top: 10rpx;
  opacity: .85;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 压在照片上时字要翻浅——绢条同时转深，两件一起换 */
.has-cover .b-title,
.has-cover .b-desc { color: var(--wood-05); }

.bdots {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  gap: 10rpx;
}
.bdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--line);
  transition: 0.3s;
}
.bdot-on { width: 26rpx; border-radius: 5rpx; background: var(--jin-60); }

/* ── 公告条 ── */
.notice-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(74,50,30, 0.06);
}
.notice-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 虚拟文创展厅入口 ── */
.craft-banner { margin-top: 24rpx; }
.craft-banner-inner {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #8C5A2B 0%, var(--jin-60) 55%, #D4B76A 100%);
  box-shadow: 0 16rpx 40rpx rgba(140, 90, 43, 0.22);
}
.craft-banner:active { opacity: 0.92; }
.craft-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.craft-text { flex: 1; min-width: 0; }
.craft-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--card);
  letter-spacing: 2rpx;
}
.craft-sub {
  display: block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 8rpx;
}

/* ── 功能入口矩阵 ── */
/* 元素上写的是 class="entries-wrap wrap"，但本规则在文件里排在 .wrap 之后、
   specificity 又相同，padding 简写把 .wrap 的 0 32rpx 整个盖掉了——于是这张带描边、
   圆角和投影的白卡是唯一一个贴着屏幕左右边跑的（轮播、精品好物、各 section 都缩进 32rpx），
   两侧的圆角与阴影全被压在屏幕边上。缩进改用 margin 表达，就不会再和 padding 打架。 */
.entries-wrap {
  margin: 24rpx 32rpx 0;
  /* 定稿里入口区是一张**浅杏的书页**，比页面底更暖更深一点点，
     页面才有"层"。用比底更亮的白时它是挖空的，整页只剩一个明度。 */
  background: var(--xing-05);
  border-radius: 28rpx;
  padding: 30rpx 12rpx 24rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 4rpx 14rpx rgba(74,50,30, 0.06);
}
/* B2 之后这一排由后台配置，条数和文案都不再是写死的 5 个 4 字词。
   原来 flex:1 均分：6 条时每格 111rpx、7 条只剩 95rpx，而 .ico 是死的 100rpx，
   第 7 条起图标就顶出格子；文案又是 nowrap，5 字以上会和邻格叠在一起。
   改成固定 5 列换行——5 条时每格仍是 670/5 = 134rpx，与改前逐像素一致，
   第 6 条起自然落到第二行。列间距必须为 0，否则 5×20% 加间距就挤不下 5 列。 */
.entries { display: flex; flex-wrap: wrap; gap: 26rpx 0; }
.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  flex: 0 0 20%;
  min-width: 0;
}
.entry:active .ico { transform: translateY(-4rpx); }
/* 入口图标：定稿里是**多色器物直接放在书页上**，没有色块底。
   原来那五个蓝紫渐变圆块（.e1~.e5）和这套配色完全不搭，一并去掉；
   器物本身有颜色有体积，再压一层色块只会把它盖住。 */
.ico {
  width: 100rpx;
  height: 100rpx;
  display: block;
  transition: transform 0.15s;
}
.ico-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}
 /* ── 五个入口的色阶 ──────────────────────────────────────
   旧版是五个几乎一样的蓝（var(--blue) / #4E7CC4 / #5867B8 / #6E8FCB / #5C79C8），
   100rpx 的尺寸下分不出来，看着像没调准而不像有意为之；早先第五格还是金色，
   金是全站的强调色（印章、徽记、精品好物大卡），放在五个平级入口之一上会让
   「报名」看着像主操作。

   现在改成**等对比度的色相扫描**：色相从 238° 走到 198°（40° 跨度，
   由品牌蓝起、到深青止，全程仍在冷色一族，不会散成一堆杂色），
   而每一格的明度是**按"白色图标落在它上面的对比度"反推出来的**，
   五格统一钉在 6.2:1 —— HSL 的 L 不等于人眼感知亮度（同样 L，青色比紫色亮得多），
   直接扫色相会让越靠后的格子图标越淡。等对比度之后五格视觉分量一致，
   差别只在色相，既拉得开又不跳。

   实测白色图标对比度：6.21 / 6.16 / 6.20 / 6.23 / 6.14（图形类要求 ≥3）。
   数值由 scratchpad 的色板脚本二分算出，改任一格都要重算，别手调。 */
/* .e1~.e5 那五个蓝紫渐变色块已删。
   它们是旧配色留下的最后一块——W0-1 那轮机械替换扫不到它们，
   因为这五个值不在旧调色板的对照表里，是这一页自己的语义色。
   定稿里入口本来就没有色块底，所以不是改配色，是去掉一件多余的东西。
   toneClass 字段先留着（后台数据里有），不再对应任何样式。 */
/* 后台可以填任意长度的名字，超出格宽就省略号，不许挤到邻格上去 */
.entry-label {
  font-size: 23rpx;
  color: var(--ink);
  font-weight: 500;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Section 通用 ── */
.section { margin-top: 40rpx; }
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.sec-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  position: relative;
  padding-left: 22rpx;
}
.sec-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, var(--blue), var(--navy));
}
.sec-more {
  font-size: 24rpx;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 2rpx;
}

/* ── 展馆横滑（两层卡：封面 + 白底名）── */
.halls-scroll { width: 100%; }
.halls-inner {
  display: flex;
  gap: 22rpx;
  padding: 4rpx 0 12rpx;
  white-space: nowrap;
}
.hall-card {
  display: inline-flex;
  flex-direction: column;
  width: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--card);
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 22rpx rgba(74,50,30, 0.12);
  flex-shrink: 0;
}
.hall-card:active { transform: translateY(-4rpx); }
.hc-cover {
  position: relative;
  height: 150rpx;
  padding: 16rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
/* 与展馆列表 .hcard-bg/.hcard-img 对齐：否则 image 没有宽高，mode 不生效，封面缩在色块里 */
.hc-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hc-img { width: 100%; height: 100%; }
.hc-corner { position: absolute; right: 14rpx; top: 12rpx; }
.hc-ct {
  position: relative;
  z-index: 2;
  color: var(--card);
  font-size: 27rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.hc-name {
  padding: 16rpx 20rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.35;
}

/* ── 动态 / 课程卡片 ── */
.cards { display: flex; flex-direction: column; gap: 20rpx; }
.ncard, .ccard {
  display: flex;
  gap: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(74,50,30, 0.07);
  align-items: center;
  transition: transform 0.15s;
}
.ncard:active, .ccard:active { transform: scale(0.99); }
.ncard-thumb {
  flex-shrink: 0;
  width: 172rpx;
  height: 124rpx;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ccard-thumb {
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ncard-img, .ccard-img { width: 100%; height: 100%; }
.ncard-body, .ccard-body { flex: 1; min-width: 0; }
.ncard-title, .ccard-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ncard-meta, .ccard-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
.ncard-date, .ccard-sub { font-size: 22rpx; color: var(--muted); }
