/* pages/index/index.wxss — 首页 */

.home-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #EAF1FB 0%, #F5F8FC 500rpx);
}

/* ── 吸顶 Header ── */
.header {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20rpx);
  padding: 8rpx 28rpx 18rpx;
  border-bottom: 1rpx solid #E7ECF6;
  box-shadow: 0 4rpx 28rpx rgba(31, 40, 90, 0.05);
}

/* 校名行（居中）——书法字改用图片，规避 Android/鸿蒙无楷体的回退问题 */
.header-titlebar {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 72rpx; /* 回退值；实际高度由 JS 按胶囊几何注入 */
}
.header-name-img {
  height: 52rpx;
  width: auto;
}

/* 操作行：我的 · 搜索 · 铃铛 */
.header-actionbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
}
.header-icon {
  position: relative;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-icon:active { background: #F2F7FC; }
.bell-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #BE9C44;
  border: 3rpx solid #fff;
}

/* 搜索框 */
.search-bar {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: #F2F7FC;
  border: 1rpx solid #E7ECF6;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 14rpx;
}
.search-bar:active { background: #EDF3FB; }
.search-placeholder { font-size: 26rpx; color: #8A93B2; }

/* ── 可滚动内容区 ── */
.scroll-body { flex: 1; overflow: hidden; }
.wrap { padding: 0 32rpx; }
.scroll-bottom { height: calc(150rpx + env(safe-area-inset-bottom)); }

/* ── Banner ── */
.banner {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  height: 316rpx;
  margin-top: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(31, 40, 90, 0.12);
}
.bslide {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 32rpx 40rpx;
  color: #fff;
  overflow: hidden;
}
.bslide-deco {
  position: absolute;
  right: -50rpx;
  top: -50rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(208, 231, 247, 0.28), transparent 70%);
  pointer-events: none;
}
.bslide-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.bslide-img { width: 100%; height: 100%; opacity: 0.32; }
.bslide-tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.18);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  align-self: flex-start;
  margin-bottom: 16rpx;
  z-index: 2;
}
.bslide-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.34;
  z-index: 2;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
  max-width: 92%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
.bslide-desc {
  font-size: 23rpx;
  opacity: 0.85;
  margin-top: 12rpx;
  z-index: 2;
  max-width: 90%;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
.bdots {
  display: flex;
  justify-content: flex-end;
  padding-right: 24rpx;
  margin-top: 14rpx;
  gap: 10rpx;
}
.bdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(43, 53, 110, 0.25);
  transition: 0.3s;
}
.bdot-on { width: 30rpx; border-radius: 6rpx; background: #2B356E; }

/* ── 公告条 ── */
.notice-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
  background: #fff;
  border: 1rpx solid #E7ECF6;
  border-radius: 20rpx;
  padding: 16rpx 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 40, 90, 0.06);
}
.notice-text {
  flex: 1;
  font-size: 24rpx;
  color: #5A648A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 虚拟文创展厅入口 ── */
.craft-banner { margin-top: 24rpx; }
.craft-banner-inner {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #8C5A2B 0%, #BE9C44 55%, #D4B76A 100%);
  box-shadow: 0 16rpx 40rpx rgba(140, 90, 43, 0.22);
}
.craft-banner:active { opacity: 0.92; }
.craft-ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.craft-text { flex: 1; min-width: 0; }
.craft-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}
.craft-sub {
  display: block;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 8rpx;
}

/* ── 功能入口矩阵 ── */
/* 元素上写的是 class="entries-wrap wrap"，但本规则在文件里排在 .wrap 之后、
   specificity 又相同，padding 简写把 .wrap 的 0 32rpx 整个盖掉了——于是这张带描边、
   圆角和投影的白卡是唯一一个贴着屏幕左右边跑的（轮播、精品好物、各 section 都缩进 32rpx），
   两侧的圆角与阴影全被压在屏幕边上。缩进改用 margin 表达，就不会再和 padding 打架。 */
.entries-wrap {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx 12rpx 24rpx;
  border: 1rpx solid #E7ECF6;
  box-shadow: 0 4rpx 14rpx rgba(31, 40, 90, 0.06);
}
/* B2 之后这一排由后台配置，条数和文案都不再是写死的 5 个 4 字词。
   原来 flex:1 均分：6 条时每格 111rpx、7 条只剩 95rpx，而 .ico 是死的 100rpx，
   第 7 条起图标就顶出格子；文案又是 nowrap，5 字以上会和邻格叠在一起。
   改成固定 5 列换行——5 条时每格仍是 670/5 = 134rpx，与改前逐像素一致，
   第 6 条起自然落到第二行。列间距必须为 0，否则 5×20% 加间距就挤不下 5 列。 */
.entries { display: flex; flex-wrap: wrap; gap: 26rpx 0; }
.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  flex: 0 0 20%;
  min-width: 0;
}
.entry:active .ico { transform: translateY(-4rpx); }
.ico {
  width: 100rpx;
  height: 100rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(31, 40, 90, 0.16);
  transition: transform 0.15s;
}
 /* 五格同属蓝色系。第五格原来是金色（#C0A24E → #9C7C2E）：
   金色是全站的强调色——印章、徽记、下面那张「精品好物」大卡都用它，
   放在五个平级入口中的一个上，会让「报名」看着像主操作，而它并不是；
   同一屏里两处大面积金色也互相削弱。改成同族蓝，金色留给真正该强调的地方。
   明度上取 e1~e3 那一档而不是继续往浅了排——e4 的 #6E8FCB 配白色图标
   对比度已经是这排里最低的，再浅就该看不清了。 */
.e1 { background: linear-gradient(135deg, #3F57B5, #2B356E); }
.e2 { background: linear-gradient(135deg, #4E7CC4, #2F5E92); }
.e3 { background: linear-gradient(135deg, #5867B8, #39418A); }
.e4 { background: linear-gradient(135deg, #6E8FCB, #46639E); }
.e5 { background: linear-gradient(135deg, #5C79C8, #34479B); }
/* 后台可以填任意长度的名字，超出格宽就省略号，不许挤到邻格上去 */
.entry-label {
  font-size: 23rpx;
  color: #1F2547;
  font-weight: 500;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Section 通用 ── */
.section { margin-top: 40rpx; }
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.sec-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2547;
  position: relative;
  padding-left: 22rpx;
}
.sec-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #3F57B5, #2B356E);
}
.sec-more {
  font-size: 24rpx;
  color: #8A93B2;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

/* ── 展馆横滑（两层卡：封面 + 白底名）── */
.halls-scroll { width: 100%; }
.halls-inner {
  display: flex;
  gap: 22rpx;
  padding: 4rpx 0 12rpx;
  white-space: nowrap;
}
.hall-card {
  display: inline-flex;
  flex-direction: column;
  width: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #E7ECF6;
  box-shadow: 0 8rpx 22rpx rgba(31, 40, 90, 0.12);
  flex-shrink: 0;
}
.hall-card:active { transform: translateY(-4rpx); }
.hc-cover {
  position: relative;
  height: 150rpx;
  padding: 16rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.hc-corner { position: absolute; right: 14rpx; top: 12rpx; }
.hc-ct {
  position: relative;
  z-index: 2;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.hc-name {
  padding: 16rpx 20rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #1F2547;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.35;
}

/* ── 动态 / 课程卡片 ── */
.cards { display: flex; flex-direction: column; gap: 20rpx; }
.ncard, .ccard {
  display: flex;
  gap: 22rpx;
  background: #fff;
  border: 1rpx solid #E7ECF6;
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 40, 90, 0.07);
  align-items: center;
  transition: transform 0.15s;
}
.ncard:active, .ccard:active { transform: scale(0.99); }
.ncard-thumb {
  flex-shrink: 0;
  width: 172rpx;
  height: 124rpx;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ccard-thumb {
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
  border-radius: 18rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ncard-img, .ccard-img { width: 100%; height: 100%; }
.ncard-body, .ccard-body { flex: 1; min-width: 0; }
.ncard-title, .ccard-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2547;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ncard-meta, .ccard-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}
.ncard-date, .ccard-sub { font-size: 22rpx; color: #8A93B2; }
