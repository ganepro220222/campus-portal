/* pages/index/index.wxss — 首页 */

.home-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 卷首画顶满，页底平铺纸色 */
  background: var(--paper);
}
.home-error-box { padding-top: 80rpx; }
.home-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
.home-section-bar { margin: 0 0 16rpx; }

/* 卷首：736rpx（＝设计稿 368px）；山水与檐分两张 PNG，檐位随状态栏高度 */
.hero {
  position: relative;
  min-height: 736rpx;
  overflow: hidden;
}
/* 画铺满卷首；scaleToFill ＝ 设计稿 preserveAspectRatio="none" */
.hero-shan {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.hero-flow { position: relative; z-index: 2; }
.hero-eave {
  display: block;
  width: 100%;
  height: 124rpx;        /* ＝设计稿 62px，满檐；顶栏组件那张是矮一档的 46px，两张不通用 */
  margin-bottom: -4rpx;  /* 檐脚压住下面一点点，中间不透缝 */
}
/* 画上题名 */
.hero-brand {
  padding: 44rpx 0 0;
  display: flex;
  justify-content: center;
}
.hero-brand-img {
  height: 80rpx;         /* ＝设计稿 40px */
  width: auto;
  /* 刻痕已烤进图；外层只留唇光与浅远影，避免叠光晕 */
  filter: drop-shadow(0 1rpx 0 rgba(255,255,255,.55))
          drop-shadow(0 3rpx 5rpx rgba(46,66,60,.16));
}

/* 我的 · 搜索 · 铃铛：浮在画上 */
.head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx 32rpx 0;
}
/* 工具钮垫半透明纸（绢底最深处对比约 3.74:1） */
.hi {
  position: relative;
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(252, 250, 244, 0.74);
  box-shadow: 0 2rpx 8rpx rgba(96,78,44,.18),
              inset 0 0 0 2rpx rgba(150,120,66,.22);
}
.hi-hover { background: var(--xing-05); }
.hi-dot {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--zhu);
}
/* 卷首搜索：半透明纸 + 木色描边 */
.search {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(252, 250, 244, 0.80);
  border: 1rpx solid rgba(122, 110, 85, 0.26);
  box-shadow: inset 0 2rpx 6rpx rgba(107,67,38,.10),
              0 2rpx 0 rgba(255,252,244,.9);
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  gap: 14rpx;
}
.search:active {
  transform: translateY(1rpx);
  background: var(--xing-05);
}
.search-ph {
  font-size: 26rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卷首滚走后淡入的吸顶搜索；触发点由 JS 按卷首搜索下沿计算 */
.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 60;
  background: rgba(247, 243, 232, 0.94);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid var(--line);
  box-shadow: 0 4rpx 20rpx rgba(74,50,30,.06);
  /* 默认收起：不可见、不挡点击，也不参与无障碍焦点 */
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8rpx);
  transition: opacity .22s ease, transform .22s ease, visibility .22s;
  pointer-events: none;
}
.topbar-on {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}
.topbar-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-left: 32rpx;   /* 右侧内边距由 JS 按胶囊位置注入 */
}
.search-mini { height: 64rpx; }

/* ── 纸：从卷首下沿翻上来 ── */

/* ── 可滚动内容区 ── */
.scroll-body { flex: 1; overflow: hidden; }
.wrap { padding: 0 32rpx; }
/* 底留白：标签栏 144rpx + 设计稿 40rpx＝184rpx */
.scroll-bottom { height: calc(184rpx + env(safe-area-inset-bottom)); }

/* 轮播：裱框尺寸；装裱类在 app.wxss；封面满强度铺满 */
.banner {
  position: relative;
  height: 372rpx;          /* 裱边 20rpx + 画心 352rpx；设计稿画心 176px */
  margin-top: 24rpx;
}
.bslide { width: 100%; height: 100%; box-sizing: border-box; }
.banner-art { height: 100%; }
.banner-art .b-title {
  font-size: 34rpx;
  line-height: 1.45;
  letter-spacing: 2rpx;
  color: var(--ink);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.banner-art .b-desc {
  font-size: 24rpx;
  margin-top: 10rpx;
  opacity: .85;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 压在照片上时字要翻浅——绢条同时转深，两件一起换 */
.has-cover .b-title,
.has-cover .b-desc { color: var(--wood-05); }

.bdots {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  gap: 10rpx;
}
.bdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--line);
  transition: 0.3s;
}
/* 轮播点选中用朱 */
.bdot-on { width: 28rpx; border-radius: 6rpx; background: var(--zhu); }

/* 公告：杏底 + 朱红左竖条；铃用朱 */
.notice-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, var(--xing-10), var(--xing-20));
  border-left: 6rpx solid var(--zhu);
  border-radius: 0 12rpx 12rpx 0;
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.6), 0 2rpx 6rpx rgba(74,50,30,.07);
}
.notice-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 精品好物：木匾（竖纹框、横纹心、阴刻填墨） */
.plaque {
  margin: 28rpx 32rpx 0;
  padding: 10rpx;
  border-radius: 14rpx;
  position: relative;
  /* 匾框比匾心深两档 */
  background-color: var(--wood-75);
  /* 竖向木理 --wood-fig-v */
  background-image:
    var(--wood-fig-v),
    linear-gradient(150deg, var(--wood-65), var(--wood-75) 52%, var(--wood-85));
  background-size: 92rpx 380rpx, auto;
  box-shadow: 0 8rpx 28rpx rgba(82,66,44,.20),
              inset 0 2rpx 0 rgba(255,250,240,.55),
              inset 0 -4rpx 6rpx rgba(70,56,36,.30);
}
.plaque:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 10rpx rgba(82,66,44,.26);
}
/* 匾面扫光 */
.plaque::after {
  content: '';
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 14rpx;
  pointer-events: none;
  background: linear-gradient(104deg,
    transparent 0 32%, rgba(255,252,242,.16) 44%, rgba(255,252,242,.26) 50%,
    rgba(255,252,242,.10) 57%, transparent 70% 100%);
}
/* 匾心内圈：金线 + 朱红环 */
.plaque-inner::before {
  content: '';
  position: absolute;
  left: 6rpx; top: 6rpx; right: 6rpx; bottom: 6rpx;
  border: 2rpx solid rgba(214,178,108,.85);
  border-radius: 4rpx;
  pointer-events: none;
  box-shadow: 0 0 0 3rpx var(--zhu),
              inset 0 2rpx 2rpx rgba(56,46,30,.38),
              0 2rpx 0 rgba(255,250,238,.30);
}
.plaque-inner {
  border-radius: 8rpx;
  padding: 22rpx 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  /* 匾心木理横向，与框竖纹交叉 */
  position: relative;
  background-color: var(--wood-45);
  background-image:
    var(--wood-fig),
    linear-gradient(180deg, var(--wood-35) 0%, var(--wood-45) 58%, var(--wood-55) 100%);
  background-size: 520rpx 152rpx, auto;
  box-shadow: inset 0 4rpx 10rpx rgba(62,52,34,.34),
              inset 0 -2rpx 0 rgba(255,250,238,.45),
              0 2rpx 0 rgba(255,250,238,.22);
}
/* 印垫在纸上，保证对比 */
.plaque-seal-paper {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  border-radius: 4rpx;
  background: var(--paper-2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(82,66,44,.30),
              inset 0 0 0 2rpx rgba(107,74,50,.30);
}
.plaque-seal { width: 46rpx; height: 46rpx; display: block; }
.plaque-txt { flex: 1; min-width: 0; }
/* 阴刻：上沿暗、下沿亮，和浮雕正好相反 */
.plaque-title {
  display: block;
  font-size: 42rpx;
  color: var(--mo-90);
  letter-spacing: 12rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 0 rgba(255,250,238,.55), 0 -1rpx 0 rgba(48,40,26,.45);
}
.plaque-sub {
  display: block;
  font-size: 22rpx;
  color: var(--wood-95);
  letter-spacing: 3rpx;
  margin-top: 10rpx;
  text-shadow: 0 2rpx 0 rgba(255,250,238,.42);
}
.plaque-go { color: var(--wood-90); flex: none; display: flex; }

/* 功能入口：杏纸版框（--xing-10、金棕边、12rpx 圆角、纸纹） */
.entries-wrap {
  position: relative;
  margin: 32rpx 32rpx 0;
  padding: 34rpx 8rpx 28rpx;
  border-radius: 12rpx;
  background-color: var(--xing-10);
  background-image: var(--fiber-page);
  background-size: 320rpx 320rpx;
  border: 3rpx solid rgba(132, 102, 44, 0.92);
  box-shadow: 0 2rpx 4rpx rgba(120, 96, 52, 0.09);
}
/* 版框内线（内退 5rpx） */
.entries-wrap::after {
  content: '';
  position: absolute;
  left: 5rpx; top: 5rpx; right: 5rpx; bottom: 5rpx;
  pointer-events: none;
  border-radius: 4rpx;
  border: 2rpx solid rgba(150, 118, 54, 0.42);
}
/* 中缝朱红圭形；不支持 clip-path 时退化为方片 */
.entries-wrap::before {
  content: '';
  position: absolute;
  z-index: 3;
  left: 50%;
  top: -3rpx;
  transform: translateX(-50%);
  width: 30rpx;
  height: 18rpx;
  background: var(--zhu);
  clip-path: polygon(0 0, 100% 0, 100% 52%, 50% 100%, 0 52%);
}
.entries { display: flex; flex-wrap: wrap; gap: 26rpx 0; }
.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  flex: 0 0 20%;
  min-width: 0;
}
.entry:active .ico { transform: translateY(-4rpx); }
/* 入口：多色器物图，无色块底 */
.ico {
  width: 100rpx;
  height: 100rpx;
  display: block;
  transition: transform 0.15s;
}
.ico-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}
/* .e1~.e5 旧色块已删；toneClass 仍可由后台返回，无对应样式 */
/* 标签超长省略，不挤邻格 */
.entry-label {
  font-size: 23rpx;
  color: var(--ink);
  font-weight: 500;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Section 通用 ── */
.section { margin-top: 40rpx; }
/* 「最新动态」通栏暖纸；与 .wrap 同元素时勿叠横向负 margin */
.section--band {
  margin-top: 8rpx;
  padding: 4rpx 32rpx 36rpx;
  background-color: var(--xing-05);
  background-image: var(--fiber-page);
  background-size: 320rpx 320rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.9),
              inset 0 -2rpx 0 rgba(150,120,66,.10);
}
/* 段内卡片比暖纸亮一档，避免陷进底色 */
.section--band .ncard { background-color: var(--paper-card); }
/* 段头规则在 app.wxss（.sec-head / .sec-title / .seal-sm / .sec-more / .sec-rule） */


/* ── 展馆横滑：裱框封面 + 题签 ── */
.halls-scroll { width: 100%; }
.halls-inner {
  display: flex;
  gap: 22rpx;
  padding: 4rpx 0 12rpx;
  white-space: nowrap;
}
.hall-card {
  display: inline-flex;
  flex-direction: column;
  width: 264rpx;          /* ＝设计稿 132px */
  flex-shrink: 0;
}
.hall-card:active { transform: translateY(-4rpx); }
.hc-art { height: 184rpx; }
/* 题签：比封面略窄，居中贴在裱框下沿 */
.tiqian {
  margin: 14rpx auto 0;
  display: block;
  max-width: 92%;
  padding: 8rpx 20rpx;
  background: linear-gradient(180deg, var(--paper-card), var(--paper-2));
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 4rpx rgba(74,50,30,.10);
  font-size: 25rpx;
  color: var(--sub);
  text-align: center;
  text-shadow: 0 2rpx 0 rgba(255,252,244,.85);
  box-sizing: border-box;
  /* 馆名可两行；超长再截断 */
  line-height: 1.32;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  white-space: normal;
  word-break: break-all;
}

/* ── 动态 / 课程卡片 ── */
.cards { display: flex; flex-direction: column; gap: 20rpx; }
.ncard, .ccard {
  display: flex;
  gap: 22rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(74,50,30, 0.07);
  align-items: center;
  transition: transform 0.15s;
}
.ncard:active, .ccard:active { transform: scale(0.99); }
/* 缩略图裱框；无封面时绢底 + 器物图标 */
.ncard-thumb { flex-shrink: 0; width: 176rpx; }
.ccard-thumb { flex-shrink: 0; width: 152rpx; }
.ncard-thumb .mount-art { height: 128rpx; }
.ccard-thumb .mount-art { height: 152rpx; }
.ncard-img, .ccard-img { width: 100%; height: 100%; }
.ncard-body, .ccard-body { flex: 1; min-width: 0; }
.ncard-title, .ccard-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ncard-meta, .ccard-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
.ncard-date, .ccard-sub { font-size: 22rpx; color: var(--muted); }
