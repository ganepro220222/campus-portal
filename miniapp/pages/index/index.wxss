/* pages/index/index.wxss — 首页 */

.home-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  /* 卷首那幅画顶在最上面，页面底色只在画以下露出来，所以是平铺的纸，
     不再是原来那道冷蓝到纸色的渐变。 */
  background: var(--paper);
}
.home-error-box { padding-top: 80rpx; }
.home-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
.home-section-bar { margin: 0 0 16rpx; }

/* ══════════════ 卷首 ══════════════
   定稿里首页开篇是**通栏出血的一幅青绿山水，屋檐压在画上**，
   书法题名和搜索行都落在画里。这幅画是整套方案最强的身份标记。

   它有 736rpx（＝设计稿 368px）高，占掉小半屏，所以不可能吸顶——
   卷首整体跟着内容滚走，滚过去之后由下面那条 .topbar 接手搜索。

   画和檐是两张 PNG（scripts/build-hero.mjs 生成）：
   WXML 不渲染内联 SVG，WXSS 的 background-image 也不收本地路径。
   分两张而不是合成一张，是因为**檐的位置跟着机型走**——
   状态栏高度各机型不同，合成就把檐钉死在某一个偏移上了。 */
.hero {
  position: relative;
  min-height: 736rpx;
  overflow: hidden;
}
/* 画铺满整个卷首。scaleToFill 对应设计稿那个 preserveAspectRatio="none"：
   画本来就是按屏宽拉伸用的，换机型只是纵向拉高一点。 */
.hero-shan {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.hero-flow { position: relative; z-index: 2; }
.hero-eave {
  display: block;
  width: 100%;
  height: 124rpx;        /* ＝设计稿 62px，满檐；顶栏组件那张是矮一档的 46px，两张不通用 */
  margin-bottom: -4rpx;  /* 檐脚压住下面一点点，中间不透缝 */
}
/* 画上的题名：比二级页顶栏那一档大，它现在是这幅画的题款 */
.hero-brand {
  padding: 44rpx 0 0;
  display: flex;
  justify-content: center;
}
.hero-brand-img {
  height: 80rpx;         /* ＝设计稿 40px */
  width: auto;
  /* 墨字压在浅色的绢底上，垫一层极淡的白让笔画离开背景 */
  filter: drop-shadow(0 1rpx 0 rgba(255,255,255,.9))
          drop-shadow(0 4rpx 12rpx rgba(74,102,96,.22));
}

/* 我的 · 搜索 · 铃铛：浮在画上 */
.head-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx 32rpx 0;
}
/* 画的颜色不定（后面还会换图），所以三件工具都垫一方半透明的纸，
   和二级页返回键同一个办法——直接落在绢底最深处只有 3.74:1。 */
.hi {
  position: relative;
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(252, 250, 244, 0.74);
  box-shadow: 0 2rpx 8rpx rgba(96,78,44,.18),
              inset 0 0 0 2rpx rgba(150,120,66,.22);
}
.hi-hover { background: var(--xing-05); }
.hi-dot {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--zhu);
}
/* 搜索框（卷首上那一条）。原来是冷蓝灰的填充加一圈冷蓝灰描边——
   那两个值是旧配色留下的，又不在旧调色板对照表里，所以护栏一直扫不到。
   这里换成"半透明的纸 + 木色描边"，和它脚下那幅画是一家人。 */
.search {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 16rpx;
  background: rgba(252, 250, 244, 0.80);
  border: 1rpx solid rgba(122, 110, 85, 0.26);
  box-shadow: inset 0 2rpx 6rpx rgba(107,67,38,.10),
              0 2rpx 0 rgba(255,252,244,.9);
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  gap: 14rpx;
}
.search:active {
  transform: translateY(1rpx);
  background: var(--xing-05);
}
.search-ph {
  font-size: 26rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 细吸顶搜索条 ──
   卷首滚走之后顶上淡入这一条，搜索始终点得到。
   触发点由 JS 量出来（卷首那条搜索行的下沿减去本条高度），
   所以两个搜索框不会同时出现在屏幕上。 */
.topbar {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 60;
  background: rgba(247, 243, 232, 0.94);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid var(--line);
  box-shadow: 0 4rpx 20rpx rgba(74,50,30,.06);
  /* 默认收起：不可见、不挡点击，也不参与无障碍焦点 */
  opacity: 0;
  visibility: hidden;
  transform: translateY(-8rpx);
  transition: opacity .22s ease, transform .22s ease, visibility .22s;
  pointer-events: none;
}
.topbar-on {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}
.topbar-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-left: 32rpx;   /* 右侧内边距由 JS 按胶囊位置注入 */
}
.search-mini { height: 64rpx; }

/* ── 纸：从卷首下沿翻上来 ── */
.sheet {
  position: relative;
  z-index: 3;
  margin-top: -52rpx;                     /* ＝设计稿 -26px，纸盖住画的下沿 */
  border-radius: 36rpx 36rpx 0 0;
  background: var(--paper);
  box-shadow: 0 -4rpx 0 rgba(200,164,92,.30),
              0 -20rpx 52rpx rgba(74,102,96,.13);
}
/* 纸的上沿留一道提手，像卷轴的轴头 */
.sheet::before {
  content: '';
  display: block;
  width: 92rpx;
  height: 6rpx;
  margin: 18rpx auto 8rpx;
  border-radius: 4rpx;
  background: var(--wood-40);
  opacity: .7;
}

/* ── 可滚动内容区 ── */
.scroll-body { flex: 1; overflow: hidden; }
.wrap { padding: 0 32rpx; }
.scroll-bottom { height: calc(150rpx + env(safe-area-inset-bottom)); }

/* ── 轮播 ──
   定稿里轮播是**裱起来的一幅画**：木纹裱边、四角角叶、右上一枚竖排题签、
   左下一条绢上写标题。装裱那几个类在 app.wxss（展馆封面、资讯缩略图要共用），
   这里只管轮播自己的尺寸。

   改掉的旧做法：封面图原来铺在一块 .s1~.s3 的渐变色块上、
   自己压到 opacity .32。那三块色阶是旧蓝紫调色板（.s1 走 var(--navy-deep)
   和 var(--blue)，被别名令牌换算成棕金），照片压淡之后叠在棕金上，
   出来是一块说不清是什么的灰褐方块 —— 反馈原话是"不知道是什么内容，
   不知道是不是没有加载出来"。
   定稿的办法是照片**满强度**铺满，可读性交给两件事：画心的暗角、
   以及标题脚下那条绢。压淡照片既丢信息又不解决对比度。 */
.banner {
  position: relative;
  height: 372rpx;          /* 裱边 20rpx + 画心 352rpx；设计稿画心 176px */
  margin-top: 24rpx;
}
.bslide { width: 100%; height: 100%; box-sizing: border-box; }
.banner-art { height: 100%; }
.banner-art .b-title {
  font-size: 34rpx;
  line-height: 1.45;
  letter-spacing: 2rpx;
  color: var(--ink);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.banner-art .b-desc {
  font-size: 24rpx;
  margin-top: 10rpx;
  opacity: .85;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 压在照片上时字要翻浅——绢条同时转深，两件一起换 */
.has-cover .b-title,
.has-cover .b-desc { color: var(--wood-05); }

.bdots {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  gap: 10rpx;
}
.bdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--line);
  transition: 0.3s;
}
/* 选中态是**朱**，不是金。金是全站的强调色（印、匾、段头箭头），
   轮播的当前页是"位置指示"不是"强调"，定稿给的就是朱。 */
.bdot-on { width: 28rpx; border-radius: 6rpx; background: var(--zhu); }

/* ── 公告条 ──
   定稿是**杏色底 + 朱红左竖条**，不是白卡片。左沿方角、右沿圆角，
   像一张从左边压进来的笺。原来是 var(--card) 白底 + 四周 --line 描边，
   和它上下的纸底几乎一个色，整条看不出边界；图标也是金的，
   定稿里那枚铃是朱的——朱是这套设计唯一的点缀色，公告正该用它。 */
.notice-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, var(--xing-10), var(--xing-20));
  border-left: 6rpx solid var(--zhu);
  border-radius: 0 12rpx 12rpx 0;
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.6), 0 2rpx 6rpx rgba(74,50,30,.07);
}
.notice-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--sub);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 精品好物：一方匾额 ──
   原来是一条金棕渐变横条（#8C5A2B → --jin-60 → #D4B76A）。
   那条渐变正好撞上审看意见里点名不要的"暗沉像黄昏"，
   而且它是整页唯一一块大面积高饱和暖色，什么内容都压不住它。

   定稿是**一方木匾**：一圈竖纹实木的框、里面一面横纹的匾心，
   左边一枚朱印钤在纸上，字是**阴刻填墨**——浅原木匾就该这么做，
   描金是黑漆匾的规矩，浅木上描金反而没对比。 */
.plaque {
  margin: 28rpx 32rpx 0;
  padding: 10rpx;
  border-radius: 14rpx;
  position: relative;
  /* 匾框比匾心深两档：匾本来就该比它挂的那面墙深，
     不然摆在米白页面上和纸一个色，"匾"这件事就没了。 */
  background-color: var(--wood-75);
  /* 木理用设计稿那张竖向木射线贴图（--wood-fig-v，feTurbulence 生成），
     不是我早先手搓的等距细纹——等距细纹出来是瓦楞纸，不是木头。 */
  background-image:
    var(--wood-fig-v),
    linear-gradient(150deg, var(--wood-65), var(--wood-75) 52%, var(--wood-85));
  background-size: 92rpx 380rpx, auto;
  box-shadow: 0 8rpx 28rpx rgba(82,66,44,.20),
              inset 0 2rpx 0 rgba(255,250,240,.55),
              inset 0 -4rpx 6rpx rgba(70,56,36,.30);
}
.plaque:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 10rpx rgba(82,66,44,.26);
}
/* 匾面斜斜扫过一道光。少了它整块匾是平的——
   木头是有光泽的，"平涂两块棕色"和"一块木头"的差别一半在这道光上。 */
.plaque::after {
  content: '';
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 14rpx;
  pointer-events: none;
  background: linear-gradient(104deg,
    transparent 0 32%, rgba(255,252,242,.16) 44%, rgba(255,252,242,.26) 50%,
    rgba(255,252,242,.10) 57%, transparent 70% 100%);
}
/* 匾心内一圈**金线 + 朱红环**。这是匾的规制里最要紧的一道，
   我上一版整个漏了，匾心就成了一块光板木头。 */
.plaque-inner::before {
  content: '';
  position: absolute;
  left: 6rpx; top: 6rpx; right: 6rpx; bottom: 6rpx;
  border: 2rpx solid rgba(214,178,108,.85);
  border-radius: 4rpx;
  pointer-events: none;
  box-shadow: 0 0 0 3rpx var(--zhu),
              inset 0 2rpx 2rpx rgba(56,46,30,.38),
              0 2rpx 0 rgba(255,250,238,.30);
}
.plaque-inner {
  border-radius: 8rpx;
  padding: 22rpx 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  /* 匾心的木理是**横**的，和框条的竖纹交叉——实木匾就是这么开料的 */
  position: relative;
  background-color: var(--wood-45);
  /* 匾心的木理是**横**的，和框条的竖纹交叉——实木匾就是这么开料的 */
  background-image:
    var(--wood-fig),
    linear-gradient(180deg, var(--wood-35) 0%, var(--wood-45) 58%, var(--wood-55) 100%);
  background-size: 520rpx 152rpx, auto;
  box-shadow: inset 0 4rpx 10rpx rgba(62,52,34,.34),
              inset 0 -2rpx 0 rgba(255,250,238,.45),
              0 2rpx 0 rgba(255,250,238,.22);
}
/* 印章钤在一方纸上——纸给了印章对比度，直接盖在木头上会糊 */
.plaque-seal-paper {
  width: 68rpx;
  height: 68rpx;
  flex: none;
  border-radius: 4rpx;
  background: var(--paper-2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(82,66,44,.30),
              inset 0 0 0 2rpx rgba(107,74,50,.30);
}
.plaque-seal { width: 46rpx; height: 46rpx; display: block; }
.plaque-txt { flex: 1; min-width: 0; }
/* 阴刻：上沿暗、下沿亮，和浮雕正好相反 */
.plaque-title {
  display: block;
  font-size: 42rpx;
  color: var(--mo-90);
  letter-spacing: 12rpx;
  line-height: 1.2;
  text-shadow: 0 2rpx 0 rgba(255,250,238,.55), 0 -1rpx 0 rgba(48,40,26,.45);
}
.plaque-sub {
  display: block;
  font-size: 22rpx;
  color: var(--wood-95);
  letter-spacing: 3rpx;
  margin-top: 10rpx;
  text-shadow: 0 2rpx 0 rgba(255,250,238,.42);
}
.plaque-go { color: var(--wood-90); flex: none; display: flex; }

/* ── 功能入口矩阵：一张书页的版框 ──
   定稿里这一块是**一张书页**：杏色纸底 + 纸纤维纹 + 一圈金棕实边，
   里面再退 5rpx 描一道细线（双线版框），正上方中缝压一枚朱红圭形标记。
   那三件我上一版全漏了，剩下一个浅杏圆角方块，说不出是什么。

   逐项和定稿对过的差：
     底色  --xing-05 → --xing-10（原来浅了一整档，压不住页底）
     描边  var(--line) 几乎看不见 → rgba(132,102,44,.92) 金棕实边
     圆角  28rpx 太圆，像卡片 → 12rpx（设计稿 6px），版框就该是方的
     纸纹  无 → var(--fiber-page) */
.entries-wrap {
  position: relative;
  margin: 32rpx 32rpx 0;
  padding: 34rpx 8rpx 28rpx;
  border-radius: 12rpx;
  background-color: var(--xing-10);
  background-image: var(--fiber-page);
  background-size: 320rpx 320rpx;
  border: 3rpx solid rgba(132, 102, 44, 0.92);
  box-shadow: 0 2rpx 4rpx rgba(120, 96, 52, 0.09);
}
/* 版框的内线：往里退 5rpx 再描一道，两道之间留出的空就是"版框" */
.entries-wrap::after {
  content: '';
  position: absolute;
  left: 5rpx; top: 5rpx; right: 5rpx; bottom: 5rpx;
  pointer-events: none;
  border-radius: 4rpx;
  border: 2rpx solid rgba(150, 118, 54, 0.42);
}
/* 中缝上那枚朱红圭形小标记。clip-path 不支持时退化成一小块朱红方片，
   位置和分量都还在，不会散版。 */
.entries-wrap::before {
  content: '';
  position: absolute;
  z-index: 3;
  left: 50%;
  top: -3rpx;
  transform: translateX(-50%);
  width: 30rpx;
  height: 18rpx;
  background: var(--zhu);
  clip-path: polygon(0 0, 100% 0, 100% 52%, 50% 100%, 0 52%);
}
.entries { display: flex; flex-wrap: wrap; gap: 26rpx 0; }
.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  flex: 0 0 20%;
  min-width: 0;
}
.entry:active .ico { transform: translateY(-4rpx); }
/* 入口图标：定稿里是**多色器物直接放在书页上**，没有色块底。
   原来那五个蓝紫渐变圆块（.e1~.e5）和这套配色完全不搭，一并去掉；
   器物本身有颜色有体积，再压一层色块只会把它盖住。 */
.ico {
  width: 100rpx;
  height: 100rpx;
  display: block;
  transition: transform 0.15s;
}
.ico-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}
 /* ── 五个入口的色阶 ──────────────────────────────────────
   旧版是五个几乎一样的蓝（var(--blue) / #4E7CC4 / #5867B8 / #6E8FCB / #5C79C8），
   100rpx 的尺寸下分不出来，看着像没调准而不像有意为之；早先第五格还是金色，
   金是全站的强调色（印章、徽记、精品好物大卡），放在五个平级入口之一上会让
   「报名」看着像主操作。

   现在改成**等对比度的色相扫描**：色相从 238° 走到 198°（40° 跨度，
   由品牌蓝起、到深青止，全程仍在冷色一族，不会散成一堆杂色），
   而每一格的明度是**按"白色图标落在它上面的对比度"反推出来的**，
   五格统一钉在 6.2:1 —— HSL 的 L 不等于人眼感知亮度（同样 L，青色比紫色亮得多），
   直接扫色相会让越靠后的格子图标越淡。等对比度之后五格视觉分量一致，
   差别只在色相，既拉得开又不跳。

   实测白色图标对比度：6.21 / 6.16 / 6.20 / 6.23 / 6.14（图形类要求 ≥3）。
   数值由 scratchpad 的色板脚本二分算出，改任一格都要重算，别手调。 */
/* .e1~.e5 那五个蓝紫渐变色块已删。
   它们是旧配色留下的最后一块——W0-1 那轮机械替换扫不到它们，
   因为这五个值不在旧调色板的对照表里，是这一页自己的语义色。
   定稿里入口本来就没有色块底，所以不是改配色，是去掉一件多余的东西。
   toneClass 字段先留着（后台数据里有），不再对应任何样式。 */
/* 后台可以填任意长度的名字，超出格宽就省略号，不许挤到邻格上去 */
.entry-label {
  font-size: 23rpx;
  color: var(--ink);
  font-weight: 500;
  white-space: nowrap;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Section 通用 ── */
.section { margin-top: 40rpx; }
/* ── 段头：小印 + 题名 + 双线 ──
   原来题名前面是一条朱红竖条（其实是 var(--blue)→var(--navy) 的渐变条，
   别名令牌把它换算成了棕金）。竖条是通用 UI 的做法，说不出是什么。
   定稿用的是**一枚朱印**——占地极小，却是全站最强的身份标记；
   题名底下再压一道双线，粗细不等、下面那道半透明，是版框的做法。 */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0;
}
.sec-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 38rpx;
  color: var(--ink);
  letter-spacing: 2rpx;
}
.seal-sm {
  width: 44rpx;
  height: 44rpx;
  flex: none;
  display: block;
}
.sec-more {
  font-size: 24rpx;
  color: var(--jin-70);
  display: flex;
  align-items: center;
  gap: 4rpx;
}
/* 双线：上粗下细，下面那道半透明——两道之间留 2rpx 空，是版框的做法。
   正中压一枚**朱红菱形**，外面描一圈纸色把线断开：
   线是版框，菱形是版框中缝的鱼尾，少了它两道线就只是普通分割线。 */
.sec-rule {
  margin: 12rpx 0 24rpx;
  position: relative;
}
.sec-rule::after {
  content: '';
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 50%;
  width: 11rpx;
  height: 11rpx;
  transform: translate(-50%, -50%) rotate(45deg);
  background: var(--zhu);
  box-shadow: 0 0 0 5rpx var(--paper);
}
.sec-rule-a,
.sec-rule-b {
  display: block;
  height: 2rpx;
  background: var(--line);
}
.sec-rule-b { margin-top: 2rpx; opacity: .5; }

/* ── 展馆横滑：裱起来的封面 + 一张题签 ──
   原来是"封面色块 + 白底卡片包住名字"，色块走 .hc1~.hc5 那套旧蓝紫色阶。
   定稿里展馆封面和轮播是同一件东西的两个尺寸档：都是裱起来的画心，
   只是角叶收到 28rpx。名字不再压在图上，而是裱框下面**贴一张题签**——
   签是手裁的纸，图再满也盖不住名字。 */
.halls-scroll { width: 100%; }
.halls-inner {
  display: flex;
  gap: 22rpx;
  padding: 4rpx 0 12rpx;
  white-space: nowrap;
}
.hall-card {
  display: inline-flex;
  flex-direction: column;
  width: 264rpx;          /* ＝设计稿 132px */
  flex-shrink: 0;
}
.hall-card:active { transform: translateY(-4rpx); }
.hc-art { height: 184rpx; }
/* 题签：比封面略窄，居中贴在裱框下沿 */
/* 封面上那方白牌：半透明的纸垫着馆名，左边一枚小器物。
   定稿里它和题签是**两件**——牌在图上写简称，签在框下写全名。
   我上一版把牌删了、又在签底下加了一行全名，于是签和那一行两条文字
   叠在一起，看着就是排版乱了。现在按定稿收回来：牌 + 签，各写各的。 */
.hc-plate {
  position: absolute;
  z-index: 4;
  left: 14rpx;
  bottom: 14rpx;
  max-width: calc(100% - 28rpx);
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx 6rpx 12rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, rgba(252,250,244,.86), rgba(252,250,244,.66));
  box-shadow: inset 0 0 0 2rpx rgba(122,110,85,.24);
}
.hc-mark { flex: none; opacity: .9; }
.hc-plate-tx {
  font-size: 27rpx;
  letter-spacing: 3rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tiqian {
  margin: 14rpx auto 0;
  display: block;
  max-width: 92%;
  padding: 8rpx 20rpx;
  background: linear-gradient(180deg, var(--paper-card), var(--paper-2));
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 4rpx rgba(74,50,30,.10);
  font-size: 25rpx;
  color: var(--sub);
  text-align: center;
  text-shadow: 0 2rpx 0 rgba(255,252,244,.85);
  box-sizing: border-box;
  /* 定稿的签是一行、超了就截断，因为那边的签写的是展览名（「礼乐文明展」，五个字）。
     这边的签写的是馆的**全名**（「贵州交通博物馆·教育基地」十几个字），
     一行截断之后只剩「贵州交通博物…」，还不如不写。所以放到两行。
     两行放不下再截断——比一行截断多出一倍的可读长度。 */
  line-height: 1.32;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  white-space: normal;
  word-break: break-all;
}

/* ── 动态 / 课程卡片 ── */
.cards { display: flex; flex-direction: column; gap: 20rpx; }
.ncard, .ccard {
  display: flex;
  gap: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(74,50,30, 0.07);
  align-items: center;
  transition: transform 0.15s;
}
.ncard:active, .ccard:active { transform: scale(0.99); }
/* 缩略图也是裱起来的画心，只是最小的那一档（角叶 28rpx）。
   没有封面图时里面垫一层绢底 + 器物图标，不再用 .hc* 那套旧色块。 */
.ncard-thumb { flex-shrink: 0; width: 176rpx; }
.ccard-thumb { flex-shrink: 0; width: 152rpx; }
.ncard-thumb .mount-art { height: 128rpx; }
.ccard-thumb .mount-art { height: 152rpx; }
.thumb-blank {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: var(--juan-1);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 0 rgba(255,252,244,.7),
              inset 0 0 0 2rpx rgba(150,120,66,.10);
}
.ncard-img, .ccard-img { width: 100%; height: 100%; }
.ncard-body, .ccard-body { flex: 1; min-width: 0; }
.ncard-title, .ccard-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ncard-meta, .ccard-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
.ncard-date, .ccard-sub { font-size: 22rpx; color: var(--muted); }
