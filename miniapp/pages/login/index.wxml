<!-- pages/login/index.wxml -->
<view class="login-page">
  <!-- 棂格：只在中上部浮现，往四周化开，不满屏。满屏会变成网格纸。 -->
  <view class="login-lattice"></view>

  <!-- 返回键挂在檐下，不和胶囊抢那一行。檐底再往下 20rpx。 -->
  <view class="login-back" style="top: calc({{statusBarHeight}}px + 124rpx + 20rpx);" bindtap="onBack" hover-class="login-back-hover">
    <icon name="chevron-left" size="22" color="#614923" sw="2.6" />
  </view>

  <view class="login-inner">
    <view style="height: {{statusBarHeight}}px; flex-shrink: 0;"></view>
    <!-- 檐：登录页这一道压在纸上，檐脚再落一层影 -->
    <image class="login-eave" src="/assets/images/hero-eave.png" mode="scaleToFill" />
    <view class="eave-shadow"></view>

    <!-- 弹性隔条分配印章、表单、页脚之间的剩余高度 -->
    <view class="lg-sp lg-sp-top"></view>

    <!-- 这一页的视觉中心：印章钤在一方纸上。
         纸给了印章对比度，也是"印"这个装置全站最大的一次亮相。 -->
    <view class="seal-plate">
      <image class="seal-img" src="/assets/images/seal-zhu.png" mode="aspectFit" />
    </view>

    <view class="brand">
      <image class="brand-img" src="/assets/images/home-title-calligraphy.png" mode="heightFix" />
      <view class="brand-div">
        <view class="brand-div-line"></view>
        <!-- 祥云：金边朱面 + 两侧内卷。整朵是一枚生成的 data URI 令牌
             （--ruyi，见 scripts/build-ruyi-token.mjs）；原来是 8 个 view
             摞出来的，摞不出那两道内卷。 -->
        <view class="ruyi"></view>
        <view class="brand-div-line brand-div-line-r"></view>
      </view>
      <view class="brand-en">Academy of Chinese Culture</view>
    </view>
    <view class="lg-sp lg-sp-mid"></view>

    <!-- 登录表单 -->
    <view class="login-form">
      <view class="field">
        <view class="field-ic"><icon name="user" size="18" color="#856F4F" /></view>
        <input
          class="field-input {{focusField === 'studentNo' ? 'on' : ''}}"
          placeholder="请输入账号"
          placeholder-class="field-ph"
          value="{{studentNo}}"
          data-field="studentNo"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          maxlength="30"
        />
      </view>
      <view class="field">
        <view class="field-ic"><icon name="lock" size="18" color="#856F4F" /></view>
        <input
          class="field-input has-eye {{focusField === 'password' ? 'on' : ''}}"
          placeholder="请输入密码"
          placeholder-class="field-ph"
          password="{{!pwdVisible.password}}"
          value="{{password}}"
          data-field="password"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          maxlength="50"
        />
        <view class="field-eye" data-field="password" bindtap="onTogglePwd" hover-class="field-eye-hover">
          <icon name="{{pwdVisible.password ? 'eye-off' : 'eye'}}" size="18" color="#856F4F" />
        </view>
      </view>

      <view wx:if="{{!bindMode}}" class="forgot-row" bindtap="onForgotPassword">
        <text class="forgot-link">忘记密码</text>
      </view>

      <button class="lbtn lbtn-primary serif" bindtap="{{bindMode ? 'onBindWxAccount' : 'onAccountLogin'}}" loading="{{loading}}" disabled="{{loading}}">
        <text class="lbtn-tx">{{bindMode ? '绑定账号并登录' : '登 录'}}</text>
      </button>

      <view wx:if="{{bindMode}}" class="bind-tip">首次微信登录须绑定管理员分配的账号。忘记密码请联系学院管理员重置后再绑定，无法在未绑定前自助找回。</view>

      <view class="divider">其他登录方式</view>

      <button class="lbtn lbtn-ghost" bindtap="onWxLogin" loading="{{loading}}" disabled="{{loading}}" wx:if="{{!bindMode}}">
        <icon name="wechat" size="20" color="#23262E" />
        <text class="lbtn-tx">微信授权登录</text>
      </button>
    </view>

    <!-- 页脚放在 login-inner 下，才能吃到下方隔条的剩余空间 -->
    <view class="lg-sp lg-sp-bot"></view>
    <view class="foot">
      <!-- 校徽退到页脚小尺寸，不抢书法字 -->
      <view class="foot-emblem-plate">
        <image class="foot-emblem" src="/assets/images/school-emblem.png" mode="aspectFit" />
      </view>
      <text class="foot-b serif">校园学习与活动服务平台</text>
      <text class="foot-s">线上线下相结合 · 随时随地学习</text>
    </view>
  </view>
</view>
