<!-- pages/login/index.wxml -->
<view class="login-page">
  <view class="glow"></view>
  <view class="stars"></view>
  <view class="wave-deco"></view>

  <view class="login-back" style="top: calc({{statusBarHeight}}px + 12rpx);" bindtap="onBack" hover-class="login-back-hover">
    <icon name="chevron-left" size="22" color="#ffffff" sw="2.6" />
  </view>

  <view class="login-inner">
    <view style="height: {{statusBarHeight}}px; flex-shrink: 0;"></view>

    <block wx:if="{{!changePasswordMode}}">
      <!-- 三根弹性隔条把剩余空间按 3 : 1 : 3 分给「印章上方 / 品牌与表单之间 / 表单与页脚之间」。
           用隔条而不是 margin:auto，是因为 auto 只能均分——均分后中间那段仍有 70~100rpx 的空档，
           整屏被切成上下两半。压到七分之一后，空白落到顶部光晕与底部波浪上，那里本就该留白。 -->
      <view class="lg-sp lg-sp-top"></view>
      <view class="seal">
        <image class="seal-img" src="/assets/images/academy-seal-gold.png" mode="aspectFit" />
      </view>

      <view class="brand">
        <view class="brand-zh serif">云端<text class="brand-zh-gold">书</text>院</view>
        <view class="brand-div">
          <view class="brand-div-line"></view>
          <text class="brand-div-orn">❖</text>
          <view class="brand-div-line brand-div-line-r"></view>
        </view>
        <view class="brand-sub serif">中华文化书院</view>
        <view class="brand-en">Academy of Chinese Culture</view>
      </view>
      <view class="lg-sp lg-sp-mid"></view>
    </block>

    <view wx:if="{{changePasswordMode}}" class="cp-badge">
      <icon name="lock" size="32" color="#ECCF82" />
    </view>
    <view wx:if="{{changePasswordMode}}" class="brand compact">
      <view class="brand-zh serif">修改初始密码</view>
      <view class="brand-sub serif">为保障账号安全，首次登录须设置新密码</view>
    </view>

    <!-- 登录表单 -->
    <view class="login-form" wx:if="{{!changePasswordMode}}">
      <view class="field">
        <view class="field-ic"><icon name="user" size="18" color="rgba(214,224,248,0.7)" /></view>
        <input
          class="field-input {{focusField === 'studentNo' ? 'on' : ''}}"
          placeholder="请输入学号 / 账号"
          placeholder-class="field-ph"
          value="{{studentNo}}"
          data-field="studentNo"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          maxlength="30"
        />
      </view>
      <view class="field">
        <view class="field-ic"><icon name="lock" size="18" color="rgba(214,224,248,0.7)" /></view>
        <input
          class="field-input {{focusField === 'password' ? 'on' : ''}}"
          placeholder="请输入密码"
          placeholder-class="field-ph"
          password
          value="{{password}}"
          data-field="password"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          maxlength="50"
        />
      </view>

      <button class="lbtn lbtn-primary" bindtap="{{bindMode ? 'onBindWxAccount' : 'onAccountLogin'}}" loading="{{loading}}" disabled="{{loading}}">
        <icon name="login" size="18" color="#2B356E" />
        <text class="lbtn-tx">{{bindMode ? '绑定账号并登录' : '登 录'}}</text>
      </button>

      <view wx:if="{{bindMode}}" class="bind-tip">首次微信登录须绑定管理员分配的账号</view>

      <view class="divider">其他登录方式</view>

      <button class="lbtn lbtn-ghost" bindtap="onWxLogin" loading="{{loading}}" disabled="{{loading}}" wx:if="{{!bindMode}}">
        <icon name="wechat" size="20" color="#ffffff" />
        <text class="lbtn-tx">微信授权登录</text>
      </button>
    </view>

    <!-- 改密表单 -->
    <view class="login-form cp-form" wx:else>
      <view class="field">
        <view class="field-ic"><icon name="lock" size="18" color="rgba(214,224,248,0.7)" /></view>
        <input
          class="field-input {{focusField === 'oldPassword' ? 'on' : ''}}"
          placeholder="请输入当前密码（初始密码）"
          placeholder-class="field-ph"
          password
          value="{{oldPassword}}"
          data-field="oldPassword"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          maxlength="50"
        />
      </view>
      <view class="field">
        <view class="field-ic"><icon name="lock" size="18" color="rgba(214,224,248,0.7)" /></view>
        <input
          class="field-input {{focusField === 'newPassword' ? 'on' : ''}}"
          placeholder="请输入新密码"
          placeholder-class="field-ph"
          password
          value="{{newPassword}}"
          data-field="newPassword"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          maxlength="50"
        />
      </view>
      <view class="field">
        <view class="field-ic"><icon name="lock" size="18" color="rgba(214,224,248,0.7)" /></view>
        <input
          class="field-input {{focusField === 'confirmPassword' ? 'on' : ''}}"
          placeholder="请再次输入新密码"
          placeholder-class="field-ph"
          password
          value="{{confirmPassword}}"
          data-field="confirmPassword"
          bindinput="onInput"
          bindfocus="onFieldFocus"
          bindblur="onFieldBlur"
          maxlength="50"
        />
      </view>

      <view class="cp-policy">新密码须至少 8 位，且包含字母与数字</view>

      <button class="lbtn lbtn-primary" bindtap="onChangePassword" loading="{{loading}}" disabled="{{loading}}">
        <text class="lbtn-tx">确认修改</text>
      </button>

      <view class="bind-tip muted">修改完成后即可正常使用小程序</view>
    </view>

    <!-- 页脚移出 .login-form：只有作为 .login-inner 的直接子元素，
         它上面那根隔条才参与 flex 的剩余空间分配。 -->
    <view class="lg-sp lg-sp-bot" wx:if="{{!changePasswordMode}}"></view>
    <view class="foot" wx:if="{{!changePasswordMode}}">
      <text class="foot-b">校园学习与活动服务平台</text>
      <text class="foot-s">线上线下相结合 · 随时随地学习</text>
    </view>
  </view>
</view>
