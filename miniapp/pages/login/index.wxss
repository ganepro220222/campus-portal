/* pages/login/index.wxss — 登录页 */

.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  /* 定稿是**纸**，不是夜空。原来这里是
     radial-gradient(var(--navy), 两个深蓝紫) ——
     别名令牌把 --navy 换算成棕金之后，它和两个深蓝紫混在一起，
     出来正是审看意见点名不要的"暗沉像黄昏"。
     现在三层：顶上一道白光、一层纸纤维、底下从绢青化到纸。 */
  background-color: var(--paper);
  background-image:
    radial-gradient(120% 56% at 50% 6%, rgba(255,255,255,.75) 0%, transparent 60%),
    var(--fiber-page),
    linear-gradient(176deg, var(--juan-1) 0%, var(--paper) 34%, var(--paper) 100%);
  background-size: auto, 320rpx 320rpx, auto;
}

/* 棂格底纹：只在中上部浮现、往四周化开。
   满屏铺就成了网格纸——遮罩是这件事成立的关键。 */
.login-lattice {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  opacity: .3;
  pointer-events: none;
  background-image: var(--lattice);
  background-size: 96rpx 96rpx;
  /* 遮罩里这个颜色只当 alpha 用（不透明 = 显示），不是调色板里的颜色，
     写成关键字免得被当成写死的色值统计进来。 */
  -webkit-mask-image: radial-gradient(90% 60% at 50% 34%, black 0%, transparent 74%);
  mask-image: radial-gradient(90% 60% at 50% 34%, black 0%, transparent 74%);
}

/* 返回键：纸色圆钮 + 木色描边，和二级页顶栏那一枚同一族。
   原来是深色底上的半透明白，页面翻浅之后那一枚就看不见了。 */
.login-back {
  position: absolute;
  left: 32rpx;
  z-index: 6;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: rgba(252, 250, 244, 0.86);
  box-shadow: 0 2rpx 8rpx rgba(96,78,44,.18),
              inset 0 0 0 2rpx rgba(150,120,66,.26);
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 4rpx;
  box-sizing: border-box;
}
.login-back-hover { background: var(--xing-05); }

/* 檐：压在纸上，檐脚再落一层影，才是"压在上面"而不是"画在上面"。
   檐必须**通栏出血**。.login-inner 有 76rpx 的左右内边距、又是 align-items:center，
   檐若只写 width:100% 就被挤进内容区（375pt 上只剩 299px）居中摆着，
   两边各露 38px 的纸——屋檐悬在半空，不是压在页面上。
   用负外边距把它顶回屏幕两边。 */
.login-eave {
  display: block;
  width: calc(100% + 152rpx);
  margin-left: -76rpx;
  margin-right: -76rpx;
  height: 124rpx;
  flex: none;
}
.eave-shadow {
  height: 28rpx;
  width: calc(100% + 152rpx);
  margin-left: -76rpx;
  margin-right: -76rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 0;
  flex: none;
  background: linear-gradient(180deg, rgba(74,102,96,.20), rgba(74,102,96,0));
}

.login-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 左右 76rpx，表单与标题大致同轴。
     顶上原来还有 108rpx —— 那是旧夜空稿给印章留的空。现在顶上是状态栏
     占位 + 屋檐，再留 108rpx 就把檐整个往下推了 54px，所以去掉。 */
  padding: 0 76rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 高屏剩余高度按 3:1:3 分给顶、中、底；不够时隔条为 0 */
.lg-sp { width: 100%; }
/* 印章离檐的间距有**下限**。原来只有 flex-grow，屏一矮隔条就被压成 0，
   印章直接贴在檐脚上——设计稿量出来檐底到印章顶是 20px（= 40rpx），
   这里给下限 44rpx（设计稿 .seal-plate 的 margin-top 是 22px），
   还有余量时照旧按 flex 分配。 */
.lg-sp-top { flex-grow: 3; min-height: 44rpx; }
.lg-sp-mid { flex-grow: 1; }
.lg-sp-bot { flex-grow: 3; }

/* ── 印章钤在一方纸上：这一页的视觉中心 ──
   纸给了印章对比度，直接落在底纹上会糊。一圈金线、一圈木框、再一圈金线，
   三道箍把这方纸"裱"起来，才像一件东西而不是一个白方块。
   原来这里是 academy-seal-gold.png（金印浮在深色上），换成朱砂那一版。 */
.seal-plate {
  width: 156rpx;
  height: 156rpx;
  margin: 0 auto;
  border-radius: 6rpx;
  background: linear-gradient(160deg, var(--paper-1), var(--paper-3));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 2rpx rgba(192,153,78,.9),
              0 0 0 7rpx rgba(122,86,38,.6),
              0 0 0 9rpx rgba(192,153,78,.5),
              0 10rpx 28rpx rgba(74,50,30,.24),
              inset 0 4rpx 6rpx rgba(255,255,255,.9),
              inset 0 -6rpx 12rpx rgba(107,74,50,.16);
}
.seal-img { width: 104rpx; height: 104rpx; }

/* ── 校名：书法字图片 ──
   原来是文字排版「云端书院」+ ❖ + 「中华文化书院」+ EN，三行。
   定稿只有书法字一行 + 如意云头分隔 + 英文，而且「云端书院」
   这个名字在定稿里根本没出现。 */
.brand { margin-top: 52rpx; text-align: center; }
.brand-img {
  height: 72rpx;
  width: auto;
  filter: drop-shadow(0 1rpx 0 rgba(255,255,255,.9))
          drop-shadow(0 4rpx 10rpx rgba(74,102,96,.18));
}
.brand-div {
  margin: 26rpx auto 0;
  width: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.brand-div-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(192,153,78,.85));
}
.brand-div-line-r {
  background: linear-gradient(90deg, rgba(192,153,78,.85), transparent);
}
/* ── 祥云分隔 ──────────────────────────────────────────────
   设计稿是 ruyi_divider()。名字叫「如意」，画的其实是**祥云**——
   那边的注释写得很清楚：如意云头怎么调都像一颗心，辨识度靠两侧的内卷，
   光靠三个圆瓣区分不开，所以换成和封面那批云同一套的祥云单元。

   形制：三个圆瓣压一道圆角横条，**金边朱面**。
   金边不是描边（圆的并集没法直接描边），是在底下垫一层大一圈的金色，
   露出来的那一圈就是边 —— 设计稿写的是
   cloud_group(gold, grow=1.1) + cloud_group(zhu, grow=0)，两层叠。

   上一版只画了一层，而且把金色那一层的尺寸填成了朱色
   （半径写的是 5.1/6.5/5.1，那是 grow=1.1 的值）。
   于是外形对、金边整个没了 —— 看上去就是一坨纯红。
   现在两层都画：8 个 view，金的在下、朱的在上。
   下面每个数都是按 50rpx / 24.6 设计单位（k=2.0325）算出来的，不是估的。

   没搬的只有设计稿那两道 0.9 单位宽的内卷（curls）——
   换算过来 1.8rpx，这个尺寸上画不出来。 */
.ruyi {
  flex: none;
  position: relative;
  width: 50rpx;
  height: 28.9rpx;
}
.ruyi-lobe, .ruyi-bar { position: absolute; }
.ruyi-lobe { border-radius: 50%; }
.ruyi-bar { border-radius: 3.3rpx; }
/* 下层：金，比朱面各方向大 1.1 个设计单位（≈2.2rpx），露出来就是边 */
.ruyi-gold { background: var(--gold); }
.ruyi-gold.ruyi-l { left: 0;      top: 8.1rpx;  width: 20.7rpx; height: 20.7rpx; }
.ruyi-gold.ruyi-m { left: 11.8rpx; top: 0;      width: 26.4rpx; height: 26.4rpx; }
.ruyi-gold.ruyi-r { left: 29.3rpx; top: 8.1rpx; width: 20.7rpx; height: 20.7rpx; }
.ruyi-gold.ruyi-bar { left: 0;     top: 15.0rpx; width: 50rpx;   height: 11.6rpx; }
/* 上层：朱面 */
.ruyi-zhu { background: var(--zhu); }
.ruyi-zhu.ruyi-l { left: 2.2rpx;  top: 10.4rpx; width: 16.3rpx; height: 16.3rpx; }
.ruyi-zhu.ruyi-m { left: 14.0rpx; top: 2.2rpx;  width: 22.0rpx; height: 22.0rpx; }
.ruyi-zhu.ruyi-r { left: 31.5rpx; top: 10.4rpx; width: 16.3rpx; height: 16.3rpx; }
.ruyi-zhu.ruyi-bar { left: 2.2rpx; top: 17.3rpx; width: 45.5rpx; height: 9.3rpx; }
.brand-en {
  margin-top: 22rpx;
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: var(--ink-3);
  text-transform: uppercase;
}

.login-form {
  width: 100%;
  padding-top: 44rpx;
}
.field {
  position: relative;
  margin-bottom: 26rpx;
}
.field-ic {
  position: absolute;
  left: 30rpx; top: 50%;
  transform: translateY(-50%);
  width: 40rpx; height: 40rpx;
  display: flex; align-items: center; justify-content: center;
  z-index: 2;
}
/* 输入框：一方**凹进去的纸**。原来是深色底上的半透明白，页面翻浅之后
   那层白在纸上什么都看不见。内阴影负责"凹"，下沿一道白负责"边"。 */
.field-input {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(180deg, var(--paper-3) 0%, var(--paper-2) 100%);
  border: 1rpx solid rgba(88,110,104,.22);
  border-radius: 12rpx;
  box-shadow: inset 0 4rpx 8rpx rgba(88,110,104,.26),
              inset 0 -2rpx 0 rgba(255,255,255,.75),
              0 2rpx 0 rgba(255,255,255,.55);
  padding: 0 32rpx 0 92rpx;
  color: var(--ink);
  font-size: 28rpx;
  box-sizing: border-box;
}
/* 密码框右侧要给眼睛键让位，左右内边距对称 */
.field-input.has-eye { padding-right: 92rpx; }

/* 眼睛键：与左侧图标镜像对称，图标中心仍距右 50rpx。
   热区 88rpx（44pt）——图标本身还是 18，靠留白撑开可点范围，观感不变。
   几何：right:22 + margin-right:-16 → 右缘 6rpx，中心 6+44=50。 */
.field-eye {
  position: absolute;
  right: 22rpx; top: 50%;
  transform: translateY(-50%);
  width: 88rpx; height: 88rpx;
  margin-right: -16rpx;
  display: flex; align-items: center; justify-content: center;
  z-index: 3;
}
.field-eye-hover { opacity: .6; }

.forgot-row {
  display: flex;
  justify-content: flex-end;
  margin: 4rpx 12rpx 12rpx;
}
/* 定稿这里写的是 --wood-70，但那是在设计稿的纸上量的；
   小程序的页底 --paper 稍浅，同一个色只剩 4.32:1，低于 AA 的 4.5。
   往深一档到 --wood-75（5.25:1），色相不变、版面不变。 */
.forgot-link {
  color: var(--wood-75);
  font-size: 24rpx;
}
.field-ph { color: var(--ink-3); }

/* 聚焦态：两个输入框长得一样，点进去只有一个光标，容易忘了在填哪一格。
   描边换成金、再加一圈很淡的外发光，不引入新颜色。 */
.field-input.on {
  border-color: rgba(192,153,78,.75);
  box-shadow: inset 0 4rpx 8rpx rgba(88,110,104,.20),
              0 0 0 4rpx rgba(192,153,78,.18);
}

/* 按钮 */
/* 两枚按钮都是**有厚度的钮**：底下垫一道深色边（0 Nrpx 0 var(--*-edge)），
   按下去往下沉、那道边同时变薄，手感就出来了。
   平涂 + 圆角那种做法在这套里不成立——页面全是有材质的东西，
   只有按钮是两块平色块，会显得是另一套东西贴上来的。 */
.lbtn {
  width: 100%;
  height: 92rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  transition: transform .09s, box-shadow .09s;
}
.lbtn::after { border: none; }
.lbtn-tx { line-height: 1; white-space: nowrap; flex-shrink: 0; }

/* 登录：朱砂漆钮。取的是印章同一支朱——这一页的主操作和它的视觉中心同色。 */
.lbtn-primary {
  background: linear-gradient(180deg, var(--zhu-lit) 0%, var(--zhu) 44%, var(--zhu-d) 100%);
  color: #F5E7CE;   /* 朱钮上的字：设计稿指定的暖米，比纯白柔，不在令牌表里 */
  font-size: 32rpx;
  letter-spacing: 12rpx;
  margin-top: 8rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,214,200,.45),
              inset 0 -4rpx 0 rgba(70,16,12,.55),
              inset 0 0 0 2rpx rgba(214,178,108,.32),
              0 8rpx 0 var(--zhu-edge),
              0 14rpx 26rpx rgba(74,50,30,.30);
}
.lbtn-primary:active {
  transform: translateY(6rpx);
  box-shadow: inset 0 2rpx 0 rgba(255,214,200,.25),
              inset 0 4rpx 12rpx rgba(70,16,12,.55),
              inset 0 0 0 2rpx rgba(214,178,108,.26),
              0 2rpx 0 var(--zhu-edge),
              0 6rpx 14rpx rgba(74,50,30,.28);
}

/* 微信授权：石青灰的石钮。不用中性灰——这套里没有中性灰。 */
.lbtn-ghost {
  background-color: var(--shi);
  background-image: var(--speckle),
    linear-gradient(180deg, var(--shi-lit) 0%, var(--shi) 48%, var(--shi-d) 100%);
  background-size: 180rpx 180rpx, auto;
  color: var(--ink);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.85),
              inset 0 -4rpx 0 rgba(120,138,142,.45),
              inset 0 0 0 2rpx rgba(122,110,85,.16),
              0 6rpx 0 var(--shi-edge),
              0 12rpx 22rpx rgba(88,110,104,.24);
}
.lbtn-ghost:active {
  transform: translateY(4rpx);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.5),
              inset 0 4rpx 10rpx rgba(120,138,142,.45),
              inset 0 0 0 2rpx rgba(122,110,85,.14),
              0 2rpx 0 var(--shi-edge),
              0 4rpx 12rpx rgba(88,110,104,.22);
}

.divider {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 40rpx 4rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}
.divider::before, .divider::after {
  content: "";
  flex: 1;
  height: 2rpx;
  background: var(--line);
}

/* 40rpx 是隔条塌成 0 时的保底间距；flex 里外边距不会合并，
   有剩余空间时它与上面那根隔条相加。 */
.foot {
  margin-top: 40rpx;
  text-align: center;
  line-height: 1.8;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
/* 校徽退到页脚、收到 104rpx，不抢书法字。
   multiply 让它压进纸里，不像一枚贴上去的贴纸。 */
.foot-emblem-plate {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  background: radial-gradient(70% 70% at 38% 30%, var(--paper-1) 0%, var(--paper-3) 72%, #DCCDAE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 2rpx rgba(192,153,78,.85),
              0 0 0 7rpx rgba(122,86,38,.55),
              0 0 0 9rpx rgba(192,153,78,.55),
              0 4rpx 14rpx rgba(74,50,30,.22),
              inset 0 2rpx 4rpx rgba(255,255,255,.9);
}
.foot-emblem { width: 72rpx; height: 72rpx; mix-blend-mode: multiply; }
.foot-b {
  display: block;
  color: var(--ink-2);
  font-size: 25rpx;
  letter-spacing: 2rpx;
}
.foot-s {
  display: block;
  color: var(--ink-3);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

.bind-tip {
  margin-top: 16rpx;
  text-align: center;
  color: var(--wood-75);   /* 同上：--wood-70 在这张纸上只有 4.32:1 */
  font-size: 22rpx;
  line-height: 1.6;
}
.bind-tip.muted {
  color: var(--ink-3);
}
/* 改密模式：徽记 + 标题 + 表单整体垂直居中（上下 auto 外边距成组居中） */
.cp-badge {
  margin-top: auto;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, var(--paper-1), var(--paper-3));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 2rpx rgba(192,153,78,.85),
              0 0 0 7rpx rgba(122,86,38,.55),
              0 0 0 9rpx rgba(192,153,78,.55),
              0 6rpx 18rpx rgba(74,50,30,.22),
              inset 0 2rpx 4rpx rgba(255,255,255,.9);
}
.brand.compact {
  margin-top: 30rpx;
  margin-bottom: 44rpx;
}
/* 改密页标题仍走文字，不走书法图。纸底上用墨色。 */
.brand-zh {
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.brand-sub {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
.login-form.cp-form {
  margin-top: 0;
  margin-bottom: auto;
}
.cp-policy {
  margin: 2rpx 6rpx 20rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}
