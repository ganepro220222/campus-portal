/* pages/login/index.wxss — 登录页 */

.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  /* 纸色底 + 顶光 + 纤维 + 绢青过渡 */
  background-color: var(--paper);
  background-image:
    radial-gradient(120% 56% at 50% 6%, rgba(255,255,255,.75) 0%, transparent 60%),
    var(--fiber-page),
    linear-gradient(176deg, var(--juan-1) 0%, var(--paper) 34%, var(--paper) 100%);
  background-size: auto, 320rpx 320rpx, auto;
}

/* 棂格底纹：中上部遮罩，不满铺 */
.login-lattice {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  opacity: .3;
  pointer-events: none;
  background-image: var(--lattice);
  background-size: 96rpx 96rpx;
  /* 遮罩里这个颜色只当 alpha 用（不透明 = 显示），不是调色板里的颜色，
     写成关键字免得被当成写死的色值统计进来。 */
  -webkit-mask-image: radial-gradient(90% 60% at 50% 34%, black 0%, transparent 74%);
  mask-image: radial-gradient(90% 60% at 50% 34%, black 0%, transparent 74%);
}

/* 返回：纸钮 + 木描边 */
.login-back {
  position: absolute;
  left: 32rpx;
  z-index: 6;
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: rgba(252, 250, 244, 0.86);
  box-shadow: 0 2rpx 8rpx rgba(96,78,44,.18),
              inset 0 0 0 2rpx rgba(150,120,66,.26);
  display: flex;
  align-items: center;
  justify-content: center;
  padding-right: 4rpx;
  box-sizing: border-box;
}
.login-back-hover { background: var(--xing-05); }

/* 檐通栏出血：负 margin 抵消 .login-inner 左右 76rpx */
.login-eave {
  display: block;
  width: calc(100% + 152rpx);
  margin-left: -76rpx;
  margin-right: -76rpx;
  height: 124rpx;
  flex: none;
}
.eave-shadow {
  height: 28rpx;
  width: calc(100% + 152rpx);
  margin-left: -76rpx;
  margin-right: -76rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 0;
  flex: none;
  background: linear-gradient(180deg, rgba(74,102,96,.20), rgba(74,102,96,0));
}

.login-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 左右 76rpx；顶不再另留 108rpx（檐已占位） */
  padding: 0 76rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 高屏剩余高度按 3:1:3 分给顶、中、底；不够时隔条为 0 */
.lg-sp { width: 100%; }
/* 印章离檐下限 44rpx（＝设计稿 22px） */
.lg-sp-top { flex-grow: 3; min-height: 44rpx; }
.lg-sp-mid { flex-grow: 1; }
.lg-sp-bot { flex-grow: 3; }

/* 印章垫纸 + 金木三道框 */
.seal-plate {
  width: 156rpx;
  height: 156rpx;
  margin: 0 auto;
  border-radius: 6rpx;
  background: linear-gradient(160deg, var(--paper-1), var(--paper-3));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 2rpx rgba(192,153,78,.9),
              0 0 0 7rpx rgba(122,86,38,.6),
              0 0 0 9rpx rgba(192,153,78,.5),
              0 10rpx 28rpx rgba(74,50,30,.24),
              inset 0 4rpx 6rpx rgba(255,255,255,.9),
              inset 0 -6rpx 12rpx rgba(107,74,50,.16);
}
.seal-img { width: 104rpx; height: 104rpx; }

/* 校名：书法图 + 祥云分隔 + 英文 */
.brand { margin-top: 52rpx; text-align: center; }
.brand-img {
  height: 72rpx;
  width: auto;
  /* 和首页卷首同一枚图、同一套外沿：两面墙在图里，外面只留唇光和远影。 */
  filter: drop-shadow(0 1rpx 0 rgba(255,255,255,.55))
          drop-shadow(0 3rpx 5rpx rgba(46,66,60,.16));
}
.brand-div {
  margin: 26rpx auto 0;
  width: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.brand-div-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(192,153,78,.85));
}
.brand-div-line-r {
  background: linear-gradient(90deg, rgba(192,153,78,.85), transparent);
}
/* 祥云分隔：--ruyi 令牌（scripts/build-ruyi-token.mjs） */
.ruyi {
  flex: none;
  width: var(--ruyi-w);
  height: var(--ruyi-h);
  background-image: var(--ruyi);
  background-size: 100% 100%;
  background-repeat: no-repeat;
}
.brand-en {
  margin-top: 22rpx;
  font-size: 21rpx;
  letter-spacing: 6rpx;
  color: var(--ink-3);
  text-transform: uppercase;
}

.login-form {
  width: 100%;
  padding-top: 44rpx;
}
.field {
  position: relative;
  margin-bottom: 26rpx;
}
.field-ic {
  position: absolute;
  left: 30rpx; top: 50%;
  transform: translateY(-50%);
  width: 40rpx; height: 40rpx;
  display: flex; align-items: center; justify-content: center;
  z-index: 2;
}
/* 输入：凹纸内阴影 */
.field-input {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(180deg, var(--paper-3) 0%, var(--paper-2) 100%);
  border: 1rpx solid rgba(88,110,104,.22);
  border-radius: 12rpx;
  box-shadow: inset 0 4rpx 8rpx rgba(88,110,104,.26),
              inset 0 -2rpx 0 rgba(255,255,255,.75),
              0 2rpx 0 rgba(255,255,255,.55);
  padding: 0 32rpx 0 92rpx;
  color: var(--ink);
  font-size: 28rpx;
  box-sizing: border-box;
}
/* 密码框右侧要给眼睛键让位，左右内边距对称 */
.field-input.has-eye { padding-right: 92rpx; }

/* 眼睛键：与左侧图标镜像对称，图标中心仍距右 50rpx。
   热区 88rpx（44pt）——图标本身还是 18，靠留白撑开可点范围，观感不变。
   几何：right:22 + margin-right:-16 → 右缘 6rpx，中心 6+44=50。 */
.field-eye {
  position: absolute;
  right: 22rpx; top: 50%;
  transform: translateY(-50%);
  width: 88rpx; height: 88rpx;
  margin-right: -16rpx;
  display: flex; align-items: center; justify-content: center;
  z-index: 3;
}
.field-eye-hover { opacity: .6; }

.forgot-row {
  display: flex;
  justify-content: flex-end;
  margin: 4rpx 12rpx 12rpx;
}
/* 「忘记密码」用 --wood-75（纸上约 5.25:1；--wood-70 约 4.32） */
.forgot-link {
  color: var(--wood-75);
  font-size: 24rpx;
}
.field-ph { color: var(--ink-3); }

/* 聚焦：金描边 + 淡外光 */
.field-input.on {
  border-color: rgba(192,153,78,.75);
  box-shadow: inset 0 4rpx 8rpx rgba(88,110,104,.20),
              0 0 0 4rpx rgba(192,153,78,.18);
}

/* 立体钮：底边 --*-edge，按下沉 */
.lbtn {
  width: 100%;
  height: 92rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  transition: transform .09s, box-shadow .09s;
}
.lbtn::after { border: none; }
.lbtn-tx { line-height: 1; white-space: nowrap; flex-shrink: 0; }

/* 登录：朱砂漆钮。取的是印章同一支朱——这一页的主操作和它的视觉中心同色。 */
.lbtn-primary {
  background: linear-gradient(180deg, var(--zhu-lit) 0%, var(--zhu) 44%, var(--zhu-d) 100%);
  color: #F5E7CE;   /* 朱钮上的字：设计稿指定的暖米，比纯白柔，不在令牌表里 */
  font-size: 32rpx;
  letter-spacing: 12rpx;
  margin-top: 8rpx;
  box-shadow: inset 0 2rpx 0 rgba(255,214,200,.45),
              inset 0 -4rpx 0 rgba(70,16,12,.55),
              inset 0 0 0 2rpx rgba(214,178,108,.32),
              0 8rpx 0 var(--zhu-edge),
              0 14rpx 26rpx rgba(74,50,30,.30);
}
.lbtn-primary:active {
  transform: translateY(6rpx);
  box-shadow: inset 0 2rpx 0 rgba(255,214,200,.25),
              inset 0 4rpx 12rpx rgba(70,16,12,.55),
              inset 0 0 0 2rpx rgba(214,178,108,.26),
              0 2rpx 0 var(--zhu-edge),
              0 6rpx 14rpx rgba(74,50,30,.28);
}

/* 微信授权：石青灰的石钮。不用中性灰——这套里没有中性灰。 */
.lbtn-ghost {
  background-color: var(--shi);
  background-image: var(--speckle),
    linear-gradient(180deg, var(--shi-lit) 0%, var(--shi) 48%, var(--shi-d) 100%);
  background-size: 180rpx 180rpx, auto;
  color: var(--ink);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.85),
              inset 0 -4rpx 0 rgba(120,138,142,.45),
              inset 0 0 0 2rpx rgba(122,110,85,.16),
              0 6rpx 0 var(--shi-edge),
              0 12rpx 22rpx rgba(88,110,104,.24);
}
.lbtn-ghost:active {
  transform: translateY(4rpx);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.5),
              inset 0 4rpx 10rpx rgba(120,138,142,.45),
              inset 0 0 0 2rpx rgba(122,110,85,.14),
              0 2rpx 0 var(--shi-edge),
              0 4rpx 12rpx rgba(88,110,104,.22);
}

.divider {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 40rpx 4rpx;
  color: var(--ink-3);
  font-size: 23rpx;
}
.divider::before, .divider::after {
  content: "";
  flex: 1;
  height: 2rpx;
  background: var(--line);
}

/* 40rpx 是隔条塌成 0 时的保底间距；flex 里外边距不会合并，
   有剩余空间时它与上面那根隔条相加。 */
.foot {
  /* 40→60rpx：校徽这枚牌放大之后，最外那道金环（12rpx 的 spread）
     是画在 .foot 盒子**外面**的，等于凭空往上吃掉 6px；
     加上牌本身高了 32rpx，把上面 flex 隔条的余量挤没了——
     量出来微信键到金环只剩 14px（原来 33px）。这 20rpx 是补回那口气。 */
  margin-top: 60rpx;
  text-align: center;
  line-height: 1.8;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
/* 页脚校徽圆牌：136rpx（徽约占牌 0.81）；投影偏移 3rpx 免环缘不匀 */
.foot-emblem-plate {
  width: 136rpx;
  height: 136rpx;
  margin: 0 auto 34rpx;
  border-radius: 50%;
  background: radial-gradient(70% 70% at 38% 30%, var(--paper-1) 0%, var(--paper-3) 72%, #DCCDAE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 3rpx rgba(192,153,78,.85),
              0 0 0 9rpx rgba(122,86,38,.55),
              0 0 0 12rpx rgba(192,153,78,.55),
              /* 投影偏移 3rpx，环缘上下接近匀称 */
              0 3rpx 16rpx rgba(74,50,30,.20),
              inset 0 3rpx 5rpx rgba(255,255,255,.9);
}
/* 136 × 0.81（设计稿 42/52）＝ 110 */
.foot-emblem { width: 110rpx; height: 110rpx; mix-blend-mode: multiply; }
.foot-b {
  display: block;
  color: var(--ink-2);
  font-size: 25rpx;
  letter-spacing: 2rpx;
}
.foot-s {
  display: block;
  color: var(--ink-3);
  font-size: 22rpx;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

.bind-tip {
  margin-top: 16rpx;
  text-align: center;
  color: var(--wood-75);   /* 同上：--wood-70 在这张纸上只有 4.32:1 */
  font-size: 22rpx;
  line-height: 1.6;
}
.bind-tip.muted {
  color: var(--ink-3);
}
/* 改密模式：徽记 + 标题 + 表单整体垂直居中（上下 auto 外边距成组居中） */
.cp-badge {
  margin-top: auto;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(160deg, var(--paper-1), var(--paper-3));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 0 2rpx rgba(192,153,78,.85),
              0 0 0 7rpx rgba(122,86,38,.55),
              0 0 0 9rpx rgba(192,153,78,.55),
              0 6rpx 18rpx rgba(74,50,30,.22),
              inset 0 2rpx 4rpx rgba(255,255,255,.9);
}
.brand.compact {
  margin-top: 30rpx;
  margin-bottom: 44rpx;
}
/* 改密页标题仍走文字，不走书法图。纸底上用墨色。 */
.brand-zh {
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}
.brand-sub {
  margin-top: 12rpx;
  color: var(--ink-3);
  font-size: 26rpx;
  letter-spacing: 4rpx;
}
.login-form.cp-form {
  margin-top: 0;
  margin-bottom: auto;
}
.cp-policy {
  margin: 2rpx 6rpx 20rpx;
  color: var(--ink-3);
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
}
