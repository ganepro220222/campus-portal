<!-- pages/news/index.wxml -->
<view class="news-page">

  <!-- 顶栏走公共满檐组件。fixed=false：本页是 flex 列 + 内层
       scroll-view，顶栏留在文档流里；搜索键进 action 槽，分类 chips 进 below 槽。 -->
  <nav-bar title="书院动态" back="{{false}}" fixed="{{false}}">
    <view slot="action" class="nav-search" hover-class="nav-search-hover" hover-stay-time="60" bindtap="onSearch">
      <view class="nav-search-disc"><icon name="search" size="18" color="#614923" /></view>
    </view>
    <view slot="below">
      <scroll-view scroll-x class="cats" enhanced show-scrollbar="{{false}}">
        <view class="cats-inner">
          <view
            wx:for="{{cats}}"
            wx:key="*this"
            class="cat {{activeCat === index ? 'cat-on' : ''}}"
            data-index="{{index}}"
            bindtap="switchCat"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </nav-bar>

  <!-- 列表（内层 scroll-view，触底用 bindscrolltolower 而非页面 onReachBottom） -->
  <scroll-view
    scroll-y
    class="news-scroll"
    enhanced
    show-scrollbar="{{false}}"
    bindscrolltolower="onScrollToLower"
    lower-threshold="120"
  >
    <skeleton show="{{loading && !newsList.length && !error}}" type="list" count="6" />

    <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetryRefresh">
      <text>列表刷新失败，点击重试</text>
    </view>

    <view class="news-wrap">
      <view
        wx:for="{{newsList}}"
        wx:key="id"
        class="ncard"
        bindtap="onCardTap"
        data-id="{{item.id}}"
      >
        <!-- 缩略图和首页「最新动态」是同一件东西：裱起来的画心（最小一档，角叶 28rpx）。
             没有封面图时里面垫一层绢底 + 器物图标，不再用 .hc* 那套色块垫底。 -->
        <view class="ncard-thumb mount mount--sm">
          <view class="mount-art {{item.cover && !item.coverFailed ? 'has-cover' : ''}}">
            <image wx:if="{{item.cover && !item.coverFailed}}" class="mount-cover ncard-img" src="{{item.cover}}" mode="{{item.coverImageMode || 'aspectFill'}}" lazy-load data-id="{{item.id}}" data-cover="{{item.cover}}" binderror="onCoverError" />
            <view wx:else class="thumb-blank"><icon name="{{item.icon}}" size="26" color="#856F4F" /></view>
          </view>
        </view>
        <view class="ncard-body">
          <view class="ncard-title">{{item.title}}</view>
          <view class="ncard-meta">
            <text class="pill">{{item.categoryName}}</text>
            <text class="ncard-sub">{{item.publishTime}} · 阅读 {{item.readText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{error && !loading && !newsList.length}}" class="page-state-box">
        <icon class="page-state-icon" name="alert" size="40" color="#957C58" />
        <text class="page-state-text">加载失败，请检查网络后重试</text>
        <view class="page-state-action" bindtap="onRetryInitial">重新加载</view>
      </view>

      <view wx:elif="{{!loading && !newsList.length && !error}}" class="empty-state">
        <icon name="file" size="40" color="#957C58" />
        <text>暂无动态</text>
      </view>

      <view wx:if="{{loadingMore}}" class="list-foot">加载中…</view>
      <view wx:elif="{{loadMoreError && newsList.length && hasMore}}" class="list-foot list-foot-retry" bindtap="onRetryLoadMore">加载更多失败，点击重试</view>
      <view wx:elif="{{newsList.length && !hasMore}}" class="list-foot list-foot-done">没有更多了</view>

      <view class="list-bottom"></view>
    </view>
  </scroll-view>

</view>
