<!-- pages/news/index.wxml -->
<view class="news-page">

  <!-- 自定义顶栏 -->
  <view class="nav">
    <view style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-row" style="height: {{navContentHeight}}px; padding-right: {{capsulePadding}}px;">
      <text class="nav-title serif">书院动态</text>
      <view class="nav-search" bindtap="onSearch">
        <icon name="search" size="20" color="#1F2547" />
      </view>
    </view>
    <!-- 分类 chips -->
    <scroll-view scroll-x class="cats" enhanced show-scrollbar="{{false}}">
      <view class="cats-inner">
        <view
          wx:for="{{cats}}"
          wx:key="*this"
          class="cat {{activeCat === index ? 'cat-on' : ''}}"
          data-index="{{index}}"
          bindtap="switchCat"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 列表（内层 scroll-view，触底用 bindscrolltolower 而非页面 onReachBottom） -->
  <scroll-view
    scroll-y
    class="news-scroll"
    enhanced
    show-scrollbar="{{false}}"
    bindscrolltolower="onScrollToLower"
    lower-threshold="120"
  >
    <skeleton show="{{loading && !newsList.length && !error}}" type="list" count="6" />

    <view wx:if="{{refreshError && !loading}}" class="page-refresh-bar" bindtap="onRetry">
      <text>列表刷新失败，点击重试</text>
    </view>

    <view class="news-wrap">
      <view
        wx:for="{{newsList}}"
        wx:key="id"
        class="ncard"
        bindtap="onCardTap"
        data-id="{{item.id}}"
      >
        <view class="ncard-thumb {{item.colorClass}}">
          <icon name="{{item.icon}}" size="30" color="rgba(255,255,255,0.92)" />
        </view>
        <view class="ncard-body">
          <view class="ncard-title">{{item.title}}</view>
          <view class="ncard-meta">
            <text class="pill">{{item.categoryName}}</text>
            <text class="ncard-sub">{{item.publishTime}} · 阅读 {{item.readText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{error && !loading && !newsList.length}}" class="page-state-box">
        <icon class="page-state-icon" name="alert" size="40" color="#C3CCE0" />
        <text class="page-state-text">加载失败，请检查网络后重试</text>
        <view class="page-state-action" bindtap="onRetry">重新加载</view>
      </view>

      <view wx:elif="{{!loading && !newsList.length && !error}}" class="empty-state">
        <icon name="file" size="40" color="#C3CCE0" />
        <text>暂无动态</text>
      </view>

      <view wx:if="{{loadingMore}}" class="list-foot">加载中…</view>
      <view wx:elif="{{newsList.length && !hasMore}}" class="list-foot list-foot-done">没有更多了</view>

      <view class="list-bottom"></view>
    </view>
  </scroll-view>

  <ai-assistant />
</view>
