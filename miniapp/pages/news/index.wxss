/* pages/news/index.wxss */
.news-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, var(--sky-2) 0, var(--paper) 240rpx);
}

/* 顶栏：宿主要在 flex 列里占住自身高度，不能被列表挤扁 */
nav-bar { flex: 0 0 auto; }
.nav-search {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.nav-search:active { background: var(--sky-3); }

/* 分类 chips */
.cats { white-space: nowrap; padding: 6rpx 0 18rpx; }
.cats-inner { display: inline-flex; gap: 16rpx; padding: 0 32rpx; }
.cat {
  flex: 0 0 auto;
  font-size: 25rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--sub);
  transition: 0.15s;
}
.cat-on {
  background: linear-gradient(135deg, var(--blue), var(--navy));
  color: var(--card);
  border-color: transparent;
}

/* 列表 */
.news-scroll { flex: 1; overflow: hidden; }
.news-wrap { padding: 22rpx 32rpx 0; }

.ncard {
  display: flex;
  gap: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 20rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 22rpx;
  transition: transform 0.15s;
}
.ncard:active { transform: scale(0.99); }
.ncard-thumb {
  flex: 0 0 176rpx;
  height: 132rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.ncard-img { width: 100%; height: 100%; }
.ncard-body { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.ncard-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ncard-meta {
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-top: 12rpx;
}
.ncard-sub { font-size: 22rpx; color: var(--muted); }

.list-bottom { height: calc(150rpx + env(safe-area-inset-bottom)); }

.list-foot {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 0 24rpx;
}
.list-foot-done { color: var(--ghost); }
.list-foot-retry { color: var(--navy); }

/* 全局 .page-refresh-bar 默认 28rpx 横向边距（对齐详情页栏距），本页内容栏距是 32rpx（.news-wrap），
   不覆写的话红条会比下方卡片各窄 4rpx，边缘对不齐。加根类提权，避免依赖样式表先后顺序。 */
.news-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
