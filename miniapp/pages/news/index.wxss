/* pages/news/index.wxss */
/* 页底是纸，不是色晕。
   原来这里是 sky-2 → paper 的渐变：sky-2 在新调色板里是绢青 #E2EDE6，
   于是顶上 120px 铺了一块淡绿，屋檐底下直接接一层绿雾。
   拿"浅色块"令牌去铺页面背景本来就经不起调色板改动——
   首页那一版已经因为同样的原因把天青晕去掉了，这页跟上。 */
.news-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--paper);
  background-image: var(--fiber);
  background-size: 320rpx 320rpx;
}

/* 顶栏：宿主要在 flex 列里占住自身高度，不能被列表挤扁 */
nav-bar { flex: 0 0 auto; }
/* 搜索键和 nav-bar 的返回键是同一枚钮：88rpx 触区 / 64rpx 纸色圆钮 / 一圈金线。
   原来是一块 88rpx 的透明方，按下去底色变 sky-3（现在是绢青），
   既和左边不对称，按下的反馈也是一块淡绿方块。 */
.nav-search {
  width: 88rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
}
.nav-search-disc {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(252, 250, 244, 0.8);
  box-shadow: 0 2rpx 8rpx rgba(96, 78, 44, 0.16),
              inset 0 0 0 2rpx rgba(150, 120, 66, 0.26);
}
.nav-search-hover .nav-search-disc { background: var(--xing-05); }

/* 分类签；选中朱砂（对比 ≥7.19） */
.cats { white-space: nowrap; padding: 6rpx 0 18rpx; }
.cats-inner { display: inline-flex; gap: 14rpx; padding: 0 32rpx; }
.cat {
  flex: 0 0 auto;
  font-size: 25rpx;
  padding: 10rpx 26rpx;
  border-radius: 4rpx;
  color: var(--wood-80);
  border: 1rpx solid var(--line);
  background: linear-gradient(180deg, rgba(255,252,244,.9), rgba(234,226,208,.55));
  box-shadow: 0 2rpx 0 rgba(255,252,244,.8);
  transition: 0.15s;
}
/* 印的立体感：上沿一道提亮、下沿压深，外面垫一圈朱的余晕。
   少了这三层就是一块平涂的红方块。 */
.cat-on {
  color: var(--paper-card);
  border-color: var(--zhu-d);
  background: linear-gradient(180deg, var(--zhu), var(--zhu-d));
  box-shadow: inset 0 2rpx 0 rgba(255,236,228,.28),
              inset 0 -2rpx 0 rgba(78,18,14,.45),
              0 2rpx 6rpx rgba(158,43,37,.26);
}

/* 列表 */
.news-scroll { flex: 1; overflow: hidden; }
.news-wrap { padding: 22rpx 32rpx 0; }

/* 卡片和首页「最新动态」那一档对齐：同样的圆角、同样的内边距、
   同样的暖投影。两处画同一种东西，不该是两套数。 */
.ncard {
  display: flex;
  gap: 22rpx;
  background: var(--paper-card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(74,50,30, 0.07);
  align-items: center;
  margin-bottom: 22rpx;
  transition: transform 0.15s;
}
.ncard:active { transform: scale(0.99); }
.ncard-thumb { flex-shrink: 0; width: 176rpx; }
.ncard-thumb .mount-art { height: 132rpx; }
.ncard-img { width: 100%; height: 100%; }
.ncard-body { flex: 1; min-width: 0; }
.ncard-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
/* 原来是 margin-top:auto 把这一行顶到卡片底。缩略图裱起来之后
   卡片高度由裱框定，标题只有一行时这一行会被顶到很远的下面，
   和标题断成两截。改成跟着标题走。 */
.ncard-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}
.ncard-sub { font-size: 22rpx; color: var(--muted); }

/* 底留白：栏 144rpx + 设计稿 40rpx＝184rpx */
.list-bottom { height: calc(184rpx + env(safe-area-inset-bottom)); }

.list-foot {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 0 24rpx;
}
/* --ghost 是"几乎看不见"的那一档（纸上 1.43:1），当字色读不出来 */
.list-foot-done { color: var(--muted); }
.list-foot-retry { color: var(--jin-70); }

/* 刷新条横距 32rpx，与本页栏距对齐 */
.news-page .page-refresh-bar { margin-left: 32rpx; margin-right: 32rpx; }
