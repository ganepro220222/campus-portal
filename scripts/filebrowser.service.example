# File Browser systemd 示例（host 原生二进制；与 Docker 二选一）
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ staging ECS 用 Docker，不要用本文件！                                     │
# │ 见 deploy/filebrowser-docker.md（/fm/、8081、filebrowser_db volume）      │
# │ 勿 cp 到 /etc/systemd/system/ — host 无 /usr/local/bin/filebrowser       │
# └──────────────────────────────────────────────────────────────────────────┘
#
#   apt install acl util-linux
#   groupadd --system filebrowser
#   useradd --system --gid filebrowser --shell /usr/sbin/nologin \
#     --home-dir /opt/shuyuan/exhibits --no-create-home filebrowser
#   cp scripts/filebrowser.service.example /etc/systemd/system/filebrowser.service
#   # 按实际路径改 WorkingDirectory / ExecStart
#   EXHIBITS_GROUP=1000 FILEBROWSER_USER=filebrowser bash scripts/fix-exhibits-permissions.sh
#   systemctl daemon-reload && systemctl enable --now filebrowser
#
# 关键：
#   - User=filebrowser（禁止 root，否则可绕过代码 644/755 改写 _server）
#   - UMask=0022 使新文件为 644（other 可读），Nginx(www-data) 不在写组也能读
#   - fix-exhibits-permissions 把 filebrowser 加入写组，内容目录属主设为该用户；
#     exhibits 根 3775 sticky，才能删除整个 craft-* / 共享背景，同时删不掉 player.html
#   - Studio（User=studio）新建的 craft-* 会经 chown-exhibit-content-dir helper 把顶层
#     inode 交给本用户，否则 sticky 下 File Browser 删不掉整个新建文件夹
#   - default ACL 给 www-data 只读
#   - File Browser 规则应禁止访问 _server、_launch、vendor 等代码路径（见 Web UI Rules）

[Unit]
Description=File Browser (exhibits upload)
After=network.target

[Service]
Type=simple
User=filebrowser
Group=filebrowser
# 示例：官方二进制；Docker 部署请在 compose 里设 user + umask 022
ExecStart=/usr/local/bin/filebrowser -r /opt/shuyuan/exhibits -d /var/lib/filebrowser/filebrowser.db
WorkingDirectory=/opt/shuyuan/exhibits
Restart=on-failure
RestartSec=3
UMask=0022

[Install]
WantedBy=multi-user.target
