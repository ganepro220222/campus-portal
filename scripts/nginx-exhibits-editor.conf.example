# Nginx 片段：staging 在线编辑器（/studio/ + /studio-api/）
# 合并进 sites-enabled 里 shuyuan 站点配置后 nginx -t && systemctl reload nginx
#
# 前提：
#   - studio-server systemd 已设置 STUDIO_USER / STUDIO_PASS（见 exhibits/_server/README.md）
#   - 或使用下方 auth_basic + htpasswd（与 studio-server 二选一，勿重复）
#   - PHP 路径须 php-fpm pool 注入 STUDIO_PASS（clear_env=no 或 env[STUDIO_PASS]=...）

gzip on;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;
gzip_min_length 256;

# 1) Node studio-server（staging 推荐：反代到 127.0.0.1:8200）
location /studio-api/ {
    auth_basic "3D Studio";
    auth_basic_user_file /etc/nginx/.htpasswd-studio;
    proxy_pass http://127.0.0.1:8200;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
}

location /studio/ {
    auth_basic "3D Studio";
    auth_basic_user_file /etc/nginx/.htpasswd-studio;
    proxy_pass http://127.0.0.1:8200/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
}

# 2) PHP 版 studio-api（/exhibits/ 子路径部署时用；须 php-fpm 注入 STUDIO_PASS）
