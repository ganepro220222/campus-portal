# 3) 编辑入口静态页 Basic Auth（PHP 静态托管路径）
# location ~ ^/exhibits/(studio\.html|player\.html)$ {
#     auth_basic "3D Studio";
#     auth_basic_user_file /etc/nginx/.htpasswd-studio;
#     try_files $uri =404;
# }

# 4) 编辑器静态资源缓存（vendor/*.js 等大文件）
location ~ ^/studio/.+\.(js|mjs|css|wasm)$ {
    auth_basic "3D Studio";
    auth_basic_user_file /etc/nginx/.htpasswd-studio;
    proxy_pass http://127.0.0.1:8200;
    expires 7d;
    add_header Cache-Control "public, max-age=604800";
}
