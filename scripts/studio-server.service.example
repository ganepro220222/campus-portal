# systemd unit：staging/生产的在线编辑器服务
#
#   sudo groupadd --system studio
#   sudo useradd --system --gid studio --shell /usr/sbin/nologin \
#     --home-dir /opt/shuyuan/exhibits --no-create-home studio
#   sudo cp scripts/studio-server.service.example /etc/systemd/system/studio-server.service
#   sudo mkdir -p /etc/shuyuan && sudo chmod 700 /etc/shuyuan
#   printf 'STUDIO_USER=admin\nSTUDIO_PASS=换成真实口令\n' | sudo tee /etc/shuyuan/studio.env
#   sudo chmod 600 /etc/shuyuan/studio.env
#   sudo EXHIBITS_GROUP=1000 bash scripts/fix-exhibits-permissions.sh
#     # 把 studio 加入内容写组（可能是 shuyuan-exhibits、ubuntu 等，见脚本输出）
#   sudo systemctl daemon-reload && sudo systemctl enable --now studio-server
#
# 主组固定为 studio；内容协作写权限由 fix-exhibits-permissions.sh 通过 supplementary group 授予，
# unit 不应写死 shuyuan-exhibits（GID 1000 在云主机上常已是 ubuntu）。
#
# 服务端固定 PORT=8200，不写 _runtime/studio-port.txt（该文件仅 Windows 本地启动器使用）。
# 诊断：systemctl status studio-server && ss -lntp | grep 8200
#
# 端口值须与 scripts/nginx-exhibits-editor.conf.example 里的 proxy_pass 一致，
# scripts/check-studio-port.js 会校验这一点。

[Unit]
Description=3D Studio (exhibits editor)
After=network.target

[Service]
Type=simple
User=studio
Group=studio
WorkingDirectory=/opt/shuyuan/exhibits
ExecStart=/usr/bin/node /opt/shuyuan/exhibits/_server/studio-server.mjs
Environment=PORT=8200
# STUDIO_USER / STUDIO_PASS 放在 root-only 的 env 文件里，别写进 unit（unit 全局可读）
EnvironmentFile=/etc/shuyuan/studio.env
Restart=on-failure
RestartSec=3
# 只监听回环：公网访问一律经 Nginx，避免有人直连 :8200 绕过反代层
Environment=STUDIO_BIND=127.0.0.1
NoNewPrivileges=true
ProtectSystem=strict
# 最小权限理想状态是只列 craft-* 内容根；动态目录暂列整个 exhibits，靠 Unix 权限保护代码只读
ReadWritePaths=/opt/shuyuan/exhibits

[Install]
WantedBy=multi-user.target
